// The dashboard: an overview (you, the machine, the time, the month, gauges, now playing, quick
// settings and style profiles); media, performance and notifications with the quick settings
// beside them.

import { Clock, System, Battery, Network, Audio, Brightness, Bluetooth, Notifications, Media, Idle, Theme, Session, Store, Compositor } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { UI } from "../state/ui.slint";
import { Time } from "../state/time.slint";
import { Overlay } from "../components/overlay.slint";
import { Icon } from "../components/icon.slint";
import { Card, QuickToggle, Slider, IconButton, TextButton, SectionTitle, Reveal, StateLayer } from "../components/controls.slint";
import { Picture } from "../components/picture.slint";
import { Profiles } from "../state/profiles.slint";
import { Wallpapers } from "../wallpaper/wallpaper.slint";

component Tab inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    // An M3 primary tab: the selected one in the primary colour over a rounded indicator.
    height: 48px;
    border-radius: Style.radius-medium;
    background: touch.has-hover ? Style.hover.with-alpha(0.6) : transparent;
    animate background { duration: Style.motion-fast; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Icon { name: root.icon; width: 18px; height: 18px; y: (parent.height - self.height) / 2; color: root.selected ? Style.accent : Style.muted; }
        Text { text: root.label; color: root.selected ? Style.accent : Style.muted; vertical-alignment: center; font-weight: 500; }
    }
    Rectangle {
        y: parent.height - self.height;
        width: root.selected ? min(parent.width - 24px, 64px) : 0px;
        height: 3px;
        border-top-left-radius: 3px;
        border-top-right-radius: 3px;
        background: Style.accent;
        animate width { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Bar inherits Rectangle {
    in property <float> ratio;
    height: 8px;
    border-radius: 4px;
    background: Style.elevated;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.ratio, 0, 1);
        border-radius: 4px;
        background: root.ratio > 0.85 ? Style.danger : Style.accent;
        animate width { duration: Style.motion; }
    }
}

// The scalloped shape that marks today and frames the gauges' icons (M3 Expressive's cookie).
component Cookie inherits Path {
    viewbox-width: 100;
    viewbox-height: 100;
    commands: "M 50.0 7.0 A 16.5 16.5 0 0 1 77.6 17.1 A 16.5 16.5 0 0 1 92.3 42.5 A 16.5 16.5 0 0 1 87.2 71.5 A 16.5 16.5 0 0 1 64.7 90.4 A 16.5 16.5 0 0 1 35.3 90.4 A 16.5 16.5 0 0 1 12.8 71.5 A 16.5 16.5 0 0 1 7.7 42.5 A 16.5 16.5 0 0 1 22.4 17.1 A 16.5 16.5 0 0 1 50.0 7.0 Z";
}

// A ring that fills clockwise from the top, like M3's circular progress.
component Ring inherits Rectangle {
    in property <float> value;
    in property <length> thickness: 6px;
    in property <color> tint: Style.accent;
    property <float> v: clamp(root.value, 0, 0.999);
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: Style.elevated;
        stroke-width: root.thickness;
        commands: "M 50 6 A 44 44 0 1 1 49.99 6";
    }
    if root.v > 0.005: Path {
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        commands: "M 50 6 A 44 44 0 " + (root.v > 0.5 ? "1" : "0") + " 1 " + (50 + 44 * sin(root.v * 360deg)) + " " + (50 - 44 * cos(root.v * 360deg));
    }
}

// You: your picture and a greeting for the time of day.
component AvatarCard inherits Card {
    HorizontalLayout {
        padding: Style.spacing-lg;
        spacing: Style.spacing-lg;
        Rectangle {
            width: 84px;
            height: 84px;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: Style.accent;
            Rectangle {
                width: parent.width - 8px;
                height: self.width;
                border-radius: self.width / 2;
                background: Style.primary-container;
                if Session.avatar-round.width > 0: Image { width: 100%; height: 100%; source: Session.avatar-round; image-fit: cover; }
                if Session.avatar-round.width == 0: Icon { name: "user"; width: 46%; height: 46%; color: Style.on-primary-container; }
            }
            StateLayer { border-radius: parent.border-radius; hovered: account.has-hover; pressed: account.pressed; ink: Style.accent-ink; }
            account := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { UI.open-settings("account"); }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: Clock.hour < 5 || Clock.hour >= 22 ? @tr("Good night") : Clock.hour < 12 ? @tr("Good morning")
                    : Clock.hour < 18 ? @tr("Good afternoon") : @tr("Good evening");
                color: Style.muted;
            }
            Text {
                text: Session.real-name != "" ? Session.real-name : Session.user;
                color: Style.text;
                font-size: 26px;
                font-weight: 700;
                overflow: elide;
            }
        }
    }
}

// The machine: the LunaDash mark, and chips for the system, the desktop and the uptime.
component SystemCard inherits Card {
    HorizontalLayout {
        padding: Style.spacing-lg;
        spacing: Style.spacing-lg;
        Rectangle {
            width: 64px;
            height: 64px;
            y: (parent.height - self.height) / 2;
            Cookie { fill: Style.tonal; }
            Image { source: @image-url("../assets/luna-mark.svg"); width: 34px; height: 34px; image-fit: contain; colorize: Style.on-tonal; }
        }
        VerticalLayout {
            alignment: center;
            spacing: Style.spacing-xs + 2px;
            for row in [
                [{ icon: "diamond", text: System.os }, { icon: "window", text: Compositor.name }],
                [{ icon: "clock", text: @tr("Up {}", System.uptime) }],
            ]: HorizontalLayout {
                spacing: Style.spacing-xs + 2px;
                alignment: start;
                for chip in row: Rectangle {
                    height: 32px;
                    width: min(chip-row.preferred-width, 240px);
                    border-radius: 16px;
                    background: Style.tonal;
                    chip-row := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 6px;
                        Icon { y: (parent.height - self.height) / 2; name: chip.icon; width: 16px; height: 16px; color: Style.on-tonal; }
                        Text { text: chip.text; color: Style.on-tonal; font-size: Style.font-small; font-weight: 600; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
    }
}

// The time standing up: hours, a pause of dots, minutes.
component ClockCard inherits Card {
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: Prefs.clock-24h ? Time.two(Clock.hour) : Time.two(Math.mod(Clock.hour + 11, 12) + 1);
            color: Style.text;
            font-size: 38px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 5px;
            for dot in [0, 1, 2]: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Style.accent; }
        }
        Text { text: Time.two(Clock.minute); color: Style.text; font-size: 38px; font-weight: 700; horizontal-alignment: center; }
        if !Prefs.clock-24h: Text { text: Clock.hour < 12 ? "AM" : "PM"; color: Style.accent; font-weight: 700; horizontal-alignment: center; }
    }
}

// The month, browsable; today wears a cookie.
component CalendarCard inherits Card {
    // Months away from today (0 = this month).
    property <int> offset;
    property <int> month-index: Clock.year * 12 + Clock.month - 1 + root.offset;
    property <int> shown-year: Math.floor(root.month-index / 12);
    property <int> shown-month: Math.mod(root.month-index, 12) + 1;
    VerticalLayout {
        padding: Style.spacing-md;
        spacing: 2px;
        HorizontalLayout {
            IconButton { icon: "chevron-left"; size: 32px; clicked => { root.offset -= 1; } }
            Text {
                horizontal-stretch: 1;
                text: Clock.format-date(root.shown-year, root.shown-month, 1, @tr("%B %Y"));
                color: Style.text;
                font-size: Style.font-size + 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                TouchArea { enabled: root.offset != 0; clicked => { root.offset = 0; } }
            }
            IconButton { icon: "chevron-right"; size: 32px; clicked => { root.offset += 1; } }
        }
        HorizontalLayout {
            padding-top: 4px;
            for day in (Prefs.week-starts-monday ? [@tr("Mon"), @tr("Tue"), @tr("Wed"), @tr("Thu"), @tr("Fri"), @tr("Sat"), @tr("Sun")]
                    : [@tr("Sun"), @tr("Mon"), @tr("Tue"), @tr("Wed"), @tr("Thu"), @tr("Fri"), @tr("Sat")]): Text {
                text: day;
                color: Style.text;
                font-size: Style.font-small;
                font-weight: 600;
                horizontal-alignment: center;
                horizontal-stretch: 1;
            }
        }
        GridLayout {
            vertical-stretch: 1;
            for day[i] in Clock.month-grid(root.shown-year, root.shown-month, Prefs.week-starts-monday): Rectangle {
                row: i / 7;
                col: Math.mod(i, 7);
                min-height: 28px;
                if day.today: Cookie {
                    width: min(parent.width, parent.height) + 6px;
                    height: self.width;
                    fill: Style.accent;
                }
                Text {
                    text: day.day;
                    color: day.today ? Style.accent-ink : !day.in-month ? Style.muted.with-alpha(0.4) : day.weekend ? Style.text : Style.muted;
                    font-weight: day.today ? 700 : day.weekend ? 600 : 400;
                }
            }
        }
    }
}

// Processor, memory and disk as rings, with their icons inside.
component GaugesCard inherits Card {
    VerticalLayout {
        padding: Style.spacing-md;
        spacing: Style.spacing-md;
        alignment: space-around;
        for gauge in [
            { icon: "cpu", value: System.cpu },
            { icon: "memory", value: System.memory },
            { icon: "disk", value: System.disk },
        ]: Rectangle {
            height: min(self.width, 76px);
            Ring {
                width: min(parent.width, parent.height);
                height: self.width;
                value: gauge.value;
                tint: gauge.value > 0.9 ? Style.danger : Style.accent;
            }
            Icon { name: gauge.icon; width: 22px; height: 22px; color: Style.text; }
        }
    }
}

// A saved look: its wallpaper above its name; the one in use wears a ring. A click switches to it.
component ProfileTile inherits VerticalLayout {
    in property <string> name;
    property <bool> active: Profiles.active == root.name;
    height: 118px;
    spacing: 6px;
    preview := Rectangle {
        vertical-stretch: 1;
        border-radius: Style.radius-medium + 4px;
        background: Style.elevated;
        border-width: root.active ? 3px : 0px;
        border-color: Style.accent;
        property <string> wallpaper: Store.profile-string(root.name, "wallpaper", Wallpapers.still, Store.revision);
        if self.wallpaper == "": Image {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            source: Wallpapers.current();
            image-fit: cover;
        }
        Picture {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            path: parent.wallpaper;
            radii: [Style.radius-medium, Style.radius-medium, Style.radius-medium, Style.radius-medium];
        }
        StateLayer { border-radius: parent.border-radius; hovered: touch.has-hover; pressed: touch.pressed; ink: #ffffff; }
        if root.active: Rectangle {
            x: parent.width - self.width - 10px;
            y: 10px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: Style.accent;
            Icon { name: "check"; width: 15px; height: 15px; color: Style.accent-ink; }
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { Profiles.load(root.name); }
        }
    }
    Text {
        text: root.name;
        color: root.active ? Style.accent : Style.text;
        font-size: Style.font-small;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// Switching between the saved looks, beside the overview: their wallpapers in a column, the
// sticker by the title.
component ProfilesCard inherits Card {
    VerticalLayout {
        padding: Style.spacing-md;
        spacing: Style.spacing-sm;
        HorizontalLayout {
            spacing: Style.spacing-sm;
            Image { source: @image-url("../assets/dashboard-sticker.png"); width: 44px; height: 44px; image-fit: contain; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: @tr("Style profiles"); color: Style.text; font-weight: 700; overflow: elide; }
                Text {
                    text: Profiles.active != "" ? Profiles.active : @tr("{} saved", Profiles.names.length);
                    color: Style.muted;
                    font-size: Style.font-small;
                    overflow: elide;
                }
            }
            IconButton { y: (parent.height - self.height) / 2; icon: "settings"; size: 34px; tonal: true; clicked => { UI.open-settings("profiles"); } }
        }
        if Profiles.names.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text { text: @tr("No profiles yet"); color: Style.text; font-weight: 600; horizontal-alignment: center; }
            Text {
                text: @tr("Save the look of your desktop in Settings → Style profiles to switch here.");
                color: Style.muted;
                font-size: Style.font-small;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if Profiles.names.length > 0: Flickable {
            vertical-stretch: 1;
            content-height: tiles.preferred-height;
            tiles := VerticalLayout {
                spacing: Style.spacing-sm;
                alignment: start;
                for name in Profiles.names: ProfileTile { name: name; }
            }
        }
    }
}

// The quick settings, `columns` to a row.
component QuickToggles inherits Rectangle {
    in property <int> columns: 2;
    property <length> gap: Style.spacing-sm;
    property <length> tile-width: (self.width - (root.columns - 1) * root.gap) / root.columns;
    property <[{id: string, icon: string, label: string, detail: string, on: bool, enabled: bool}]> tiles: [
        { id: "wifi", icon: Network.wifi-enabled ? "wifi" : "wifi-off", label: @tr("Wi-Fi"),
            detail: Network.kind == "wifi" ? Network.name : Network.wifi-enabled ? @tr("On") : @tr("Off"),
            on: Network.wifi-enabled, enabled: Network.available },
        { id: "bluetooth", icon: "bluetooth", label: @tr("Bluetooth"), detail: Bluetooth.powered ? @tr("On") : @tr("Off"),
            on: Bluetooth.powered, enabled: Bluetooth.available },
        { id: "dnd", icon: Notifications.do-not-disturb ? "bell-off" : "bell", label: @tr("Do not disturb"), detail: "",
            on: Notifications.do-not-disturb, enabled: true },
        { id: "awake", icon: "coffee", label: @tr("Keep awake"), detail: "", on: Idle.inhibited, enabled: Idle.available },
        { id: "theme", icon: Theme.dark ? "moon" : "sun", label: Theme.dark ? @tr("Dark") : @tr("Light"), detail: @tr("Appearance"),
            on: Theme.dark, enabled: true },
        { id: "wallpaper", icon: "image", label: @tr("Wallpaper"), detail: "", on: false, enabled: true },
    ];
    height: Math.ceil(root.tiles.length / root.columns) * (58px + root.gap) - root.gap;
    for tile[i] in root.tiles: QuickToggle {
        x: Math.mod(i, root.columns) * (root.tile-width + root.gap);
        y: Math.floor(i / root.columns) * (58px + root.gap);
        width: root.tile-width;
        icon: tile.icon;
        label: tile.label;
        detail: tile.detail;
        on: tile.on;
        enabled: tile.enabled;
        clicked => { root.toggle(tile.id); }
    }
    function toggle(id: string) {
        if id == "wifi" {
            Network.set-wifi-enabled(!Network.wifi-enabled);
        } else if id == "bluetooth" {
            Bluetooth.set-powered(!Bluetooth.powered);
        } else if id == "dnd" {
            Notifications.set-do-not-disturb(!Notifications.do-not-disturb);
        } else if id == "awake" {
            Idle.set-inhibited(!Idle.inhibited);
        } else if id == "theme" {
            // Saved like the Appearance setting, so Settings agrees and it lasts.
            Store.set-string("theme-mode", Theme.dark ? "light" : "dark");
            Theme.set-mode(Prefs.theme-mode);
        } else if id == "wallpaper" {
            UI.open-overlay("gallery");
        }
    }
}

component ControlsColumn inherits VerticalLayout {
    spacing: Style.spacing-sm;
    QuickToggles { columns: 2; }
    if Audio.available: Slider {
        icon: Audio.output.muted ? "volume-mute" : "volume";
        value: Audio.output.volume;
        maximum: 1.5;
        changed(v) => { Audio.set-volume(v); }
        icon-clicked => { Audio.toggle-muted(); }
    }
    if Brightness.available: Slider {
        icon: "brightness";
        value: Brightness.level;
        changed(v) => { Brightness.set(max(0.02, v)); }
    }
    // The tiles have fixed heights; without a stretchable filler this column would cap the
    // height of the whole row and leave the tab content short.
    Rectangle { vertical-stretch: 1; }
}

component OverviewTab inherits VerticalLayout {
    spacing: Style.spacing-md;
    HorizontalLayout {
        vertical-stretch: 1;
        spacing: Style.spacing-md;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Style.spacing-md;
            HorizontalLayout {
                height: 120px;
                spacing: Style.spacing-md;
                AvatarCard { horizontal-stretch: 4; preferred-width: 0px; }
                SystemCard { horizontal-stretch: 5; preferred-width: 0px; }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: Style.spacing-md;
                ClockCard { width: 104px; }
                CalendarCard { horizontal-stretch: 1; }
                GaugesCard { width: 104px; }
            }
        }
        ProfilesCard { width: 280px; }
    }
    QuickToggles { columns: 6; }
}

component MediaTab inherits HorizontalLayout {
    spacing: Style.spacing-lg;
    if Media.player.bus-name == "": VerticalLayout {
        alignment: center;
        spacing: Style.spacing-sm;
        HorizontalLayout { alignment: center; Icon { name: "music"; width: 48px; height: 48px; color: Style.muted; } }
        Text { text: @tr("Nothing is playing"); color: Style.muted; horizontal-alignment: center; }
    }
    if Media.player.bus-name != "": Rectangle {
        width: 300px;
        border-radius: Style.radius-medium;
        background: Style.elevated;
        art := Picture {
            path: Media.player.art-url;
            radii: [parent.border-radius, parent.border-radius, parent.border-radius, parent.border-radius];
        }
        if !art.loaded: Icon { name: "music"; width: 72px; height: 72px; color: Style.muted; }
    }
    if Media.player.bus-name != "": VerticalLayout {
        alignment: center;
        spacing: Style.spacing-sm;
        Text { text: Media.player.identity; color: Style.accent; font-size: Style.font-small; }
        Text { text: Media.player.title; color: Style.text; font-size: 26px; font-weight: 600; wrap: word-wrap; }
        Text { text: Media.player.artist + (Media.player.album != "" ? " — " + Media.player.album : ""); color: Style.muted; wrap: word-wrap; }
        if Media.player.length > 0: VerticalLayout {
            spacing: 4px;
            Bar { ratio: Media.player.position / Media.player.length; }
            HorizontalLayout {
                Text { text: Math.floor(Media.player.position / 60) + ":" + (Math.mod(Math.floor(Media.player.position), 60) < 10 ? "0" : "") + Math.mod(Math.floor(Media.player.position), 60); color: Style.muted; font-size: Style.font-small; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: Math.floor(Media.player.length / 60) + ":" + (Math.mod(Math.floor(Media.player.length), 60) < 10 ? "0" : "") + Math.mod(Math.floor(Media.player.length), 60); color: Style.muted; font-size: Style.font-small; }
            }
        }
        HorizontalLayout {
            spacing: Style.spacing-md;
            alignment: start;
            IconButton { icon: "previous"; size: 44px; icon-size: 20px; clicked => { Media.previous(); } }
            IconButton { icon: Media.player.playing ? "pause" : "play"; size: 52px; icon-size: 22px; active: true; clicked => { Media.play-pause(); } }
            IconButton { icon: "next"; size: 44px; icon-size: 20px; clicked => { Media.next(); } }
        }
        if Media.players.length > 1: VerticalLayout {
            spacing: 4px;
            SectionTitle { text: @tr("PLAYERS"); }
            for player in Media.players: Text {
                text: (player.playing ? "▶ " : "") + player.identity + (player.title != "" ? " — " + player.title : "");
                color: player.bus-name == Media.player.bus-name ? Style.text : Style.muted;
                overflow: elide;
            }
        }
    }
}

// A task manager in the manner of htop: meters for every core, memory and swap, a summary
// with the processor's last minute, and the processes using the most, sorted by processor or
// memory. The processes are only read while this tab is on screen (see Dashboard).

// A load in 0..1 in htop's colours: green, yellow when busy, red when nearly full.
component Meter inherits Rectangle {
    in property <string> label;
    in property <float> ratio;
    in property <string> value;
    in property <length> label-width: 22px;
    in property <length> value-width: 44px;
    height: 16px;
    HorizontalLayout {
        spacing: 6px;
        Text {
            width: root.label-width;
            text: root.label;
            color: Style.accent;
            font-family: Style.font-mono;
            font-size: Style.font-small;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            border-radius: 3px;
            background: Style.elevated;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.ratio, 0, 1);
                border-radius: 3px;
                background: root.ratio > 0.8 ? Style.danger : root.ratio > 0.5 ? Style.warning : Style.success;
                animate width { duration: Style.motion; easing: ease-out; }
                animate background { duration: Style.motion-fast; }
            }
        }
        Text {
            width: root.value-width;
            text: root.value;
            color: Style.muted;
            font-family: Style.font-mono;
            font-size: Style.font-small;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// One line of the summary: a name in the accent and its value.
component Summary inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Style.text;
    spacing: 8px;
    Text { width: 64px; text: root.label; color: Style.accent; font-size: Style.font-small; vertical-alignment: center; }
    Text { text: root.value; color: root.value-color; font-family: Style.font-mono; font-size: Style.font-small; overflow: elide; vertical-alignment: center; }
}

// The processor's last minute as columns.
component History inherits Rectangle {
    in property <[float]> values;
    border-radius: 8px;
    background: Style.elevated;
    clip: true;
    for value[i] in root.values: Rectangle {
        x: i * parent.width / max(1, root.values.length);
        y: parent.height - self.height;
        width: parent.width / max(1, root.values.length) - 1px;
        height: parent.height * clamp(value, 0, 1);
        background: Style.accent.with-alpha(0.35 + 0.65 * clamp(value, 0, 1));
        animate height { duration: Style.motion; easing: ease-out; }
    }
}

// A column heading of the process list; the sortable ones say which order is in use.
component Heading inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> sortable;
    in property <TextHorizontalAlignment> alignment: right;
    callback clicked();
    border-radius: 6px;
    background: root.sorted ? Style.accent-ink.with-alpha(0.22) : touch.has-hover && root.sortable ? Style.accent-ink.with-alpha(0.12) : transparent;
    Text {
        x: 6px;
        width: parent.width - 12px;
        text: root.text + (root.sorted ? " ▾" : "");
        color: Style.accent-ink;
        font-size: Style.font-small;
        font-weight: 700;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.sortable;
        mouse-cursor: root.sortable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

component ProcessCell inherits Text {
    color: Style.text;
    font-family: Style.font-mono;
    font-size: Style.font-small;
    horizontal-alignment: right;
    vertical-alignment: center;
    overflow: elide;
}

component PerformanceTab inherits VerticalLayout {
    // "cpu" or "memory": what the processes are sorted by.
    in-out property <string> order;
    // Columns: PID, user, resident memory, processor, memory, processor time; the command fills
    // the rest.
    property <[length]> columns: [62px, 86px, 58px, 58px, 58px, 76px];
    property <int> core-columns: System.cpu-cores.length > 32 ? 4 : 2;
    property <int> core-rows: Math.ceil(System.cpu-cores.length / root.core-columns);
    spacing: Style.spacing-md;

    Card {
        HorizontalLayout {
            padding: Style.spacing-lg;
            spacing: Style.spacing-xl;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                // htop's order: the first half of the cores down the left, the rest beside them.
                cores := Rectangle {
                    height: root.core-rows * 18px - 2px;
                    for usage[i] in System.cpu-cores: Meter {
                        x: Math.floor(i / root.core-rows) * (cores.width + 12px) / root.core-columns;
                        y: Math.mod(i, root.core-rows) * 18px;
                        width: (cores.width + 12px) / root.core-columns - 12px;
                        label: i;
                        ratio: usage;
                        value: Math.round(usage * 1000) / 10 + "%";
                    }
                }
                Rectangle { height: 4px; }
                Meter {
                    label: "Mem";
                    label-width: 30px;
                    value-width: 150px;
                    ratio: System.memory;
                    value: System.memory-text;
                }
                Meter {
                    label: "Swp";
                    label-width: 30px;
                    value-width: 150px;
                    ratio: System.swap;
                    value: Math.round(System.swap * 1000) / 10 + "%";
                }
            }
            VerticalLayout {
                width: 236px;
                spacing: 5px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Math.round(System.cpu * 100) + "%";
                        color: Style.text;
                        font-size: Style.font-title + 6px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    History { height: 44px; horizontal-stretch: 1; values: System.cpu-history; }
                }
                Summary {
                    label: @tr("Tasks");
                    value: @tr("{} · {} thr · {} running", System.tasks, System.threads, System.running);
                }
                Summary {
                    label: @tr("Load");
                    value: System.load-average.length < 3 ? "" : (Math.round(System.load-average[0] * 100) / 100) + "  " + (Math.round(System.load-average[1] * 100) / 100) + "  " + (Math.round(System.load-average[2] * 100) / 100);
                    value-color: System.load-average.length > 0 && System.load-average[0] > System.cpu-cores.length ? Style.danger : Style.text;
                }
                Summary { label: @tr("Uptime"); value: System.uptime; }
                if System.temperature > 0: Summary {
                    label: @tr("Heat");
                    value: Math.round(System.temperature) + "°C";
                    value-color: System.temperature > 85 ? Style.danger : System.temperature > 70 ? Style.warning : Style.text;
                }
                if System.gpu-available: Summary {
                    label: "GPU";
                    value: Math.round(System.gpu * 100) + "%" + (System.gpu-temperature > 0 ? " · " + Math.round(System.gpu-temperature) + "°C" : "");
                }
                Summary { label: @tr("Network"); value: "↓ " + System.download-text + "  ↑ " + System.upload-text; }
                Summary { label: @tr("Disk"); value: System.disk-text; }
            }
        }
    }
    Card {
        vertical-stretch: 1;
        VerticalLayout {
            padding: Style.spacing-sm;
            spacing: 4px;
            // htop's heading bar, in the accent.
            Rectangle {
                height: 28px;
                border-radius: 9px;
                background: Style.accent;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    Heading { width: root.columns[0]; text: "PID"; }
                    Heading { width: root.columns[1]; text: @tr("USER"); alignment: left; }
                    Heading { width: root.columns[2]; text: "RES"; }
                    Heading {
                        width: root.columns[3];
                        text: "CPU%";
                        sortable: true;
                        sorted: root.order == "cpu";
                        clicked => { root.order = "cpu"; }
                    }
                    Heading {
                        width: root.columns[4];
                        text: "MEM%";
                        sortable: true;
                        sorted: root.order == "memory";
                        clicked => { root.order = "memory"; }
                    }
                    Heading { width: root.columns[5]; text: "TIME+"; }
                    Heading { horizontal-stretch: 1; text: @tr("Command"); alignment: left; }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    for process[i] in System.processes: Rectangle {
                        height: 24px;
                        border-radius: 7px;
                        background: row.has-hover ? Style.tonal : Math.mod(i, 2) == 1 ? Style.elevated.with-alpha(0.45) : transparent;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            ProcessCell { width: root.columns[0]; text: process.pid; color: Style.muted; }
                            Rectangle { width: 6px; }
                            ProcessCell { width: root.columns[1] - 6px; text: process.user; horizontal-alignment: left; }
                            ProcessCell { width: root.columns[2]; text: process.memory-text; }
                            ProcessCell {
                                width: root.columns[3];
                                text: Math.round(process.cpu * 1000) / 10;
                                color: process.cpu > 0.8 ? Style.danger : process.cpu > 0.3 ? Style.warning : Style.text;
                                font-weight: root.order == "cpu" ? 600 : 400;
                            }
                            ProcessCell {
                                width: root.columns[4];
                                text: Math.round(process.memory * 1000) / 10;
                                font-weight: root.order == "memory" ? 600 : 400;
                            }
                            ProcessCell { width: root.columns[5]; text: process.time; color: Style.muted; }
                            Rectangle { width: 12px; }
                            ProcessCell {
                                horizontal-stretch: 1;
                                text: process.command;
                                color: process.state == "R" ? Style.success : Style.text;
                                horizontal-alignment: left;
                            }
                        }
                        row := TouchArea { }
                    }
                }
            }
        }
    }
}

component NotificationsTab inherits VerticalLayout {
    spacing: Style.spacing-md;
    HorizontalLayout {
        spacing: Style.spacing-sm;
        Text { text: @tr("{} notifications", Notifications.count); color: Style.text; font-size: Style.font-title; vertical-alignment: center; horizontal-stretch: 1; }
        TextButton {
            horizontal-stretch: 0;
            icon: Notifications.do-not-disturb ? "bell-off" : "bell";
            text: Notifications.do-not-disturb ? @tr("Do not disturb is on") : @tr("Do not disturb");
            clicked => { Notifications.set-do-not-disturb(!Notifications.do-not-disturb); }
        }
        if Notifications.count > 0: TextButton { horizontal-stretch: 0; icon: "trash"; text: @tr("Clear all"); clicked => { Notifications.dismiss-all(); } }
    }
    if !Notifications.available: Text { text: @tr("Another notification daemon is running; LunaDash shows no history."); color: Style.muted; wrap: word-wrap; }
    if Notifications.available && Notifications.count == 0: VerticalLayout {
        alignment: center;
        vertical-stretch: 1;
        spacing: Style.spacing-sm;
        HorizontalLayout { alignment: center; Icon { name: "bell"; width: 44px; height: 44px; color: Style.muted; } }
        Text { text: @tr("You're all caught up"); color: Style.muted; horizontal-alignment: center; }
    }
    // Only with notifications: an empty list would take half the room from the empty state.
    if Notifications.count > 0: Flickable {
        vertical-stretch: 1;
        content-height: items.preferred-height;
        items := VerticalLayout {
            spacing: Style.spacing-sm;
            for n in Notifications.history: Card {
                height: content.preferred-height;
                content := HorizontalLayout {
                    padding: Style.spacing-md;
                    spacing: Style.spacing-md;
                    Image { source: n.icon; width: 32px; height: 32px; image-fit: contain; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: n.app-name; color: Style.accent; font-size: Style.font-small; horizontal-stretch: 1; }
                            Text { text: n.time; color: Style.muted; font-size: Style.font-small; }
                        }
                        Text { text: n.summary; color: Style.text; font-weight: 600; wrap: word-wrap; }
                        if n.body != "": Text { text: n.body; color: Style.muted; wrap: word-wrap; }
                        if n.actions.length > 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for action in n.actions: TextButton {
                                text: action.label;
                                clicked => { Notifications.invoke(n.id, action.key); }
                            }
                        }
                    }
                    IconButton { icon: "close"; size: 26px; icon-size: 13px; clicked => { Notifications.dismiss(n.id); } }
                }
            }
        }
    }
}

export component Dashboard inherits Overlay {
    name: "dashboard";
    namespace: "lunadash-dashboard";
    // Slides in from the top of the desktop.
    edge: "top";
    content-width: 1080px;
    content-height: 620px;

    // Processes are read only while the performance tab is on screen.
    property <string> process-order: "cpu";
    property <string> watched-processes: UI.overlay == "dashboard" && UI.on-active-screen && UI.dashboard-tab == 2 ? root.process-order : "";
    changed watched-processes => { System.watch-processes(self.watched-processes); }

    VerticalLayout {
        padding: Style.spacing-lg;
        spacing: Style.spacing-md;
        HorizontalLayout {
            spacing: Style.spacing-sm;
            for tab[i] in [
                { icon: "dashboard", label: @tr("Dashboard") },
                { icon: "music", label: @tr("Media") },
                { icon: "cpu", label: @tr("Performance") },
                { icon: "bell", label: @tr("Notifications") },
            ]: Tab {
                horizontal-stretch: 1;
                icon: tab.icon;
                label: tab.label;
                selected: UI.dashboard-tab == i;
                clicked => { UI.open-dashboard(i); }
            }
            IconButton { icon: "close"; size: 36px; y: (parent.height - self.height) / 2; clicked => { UI.close-all(); } }
        }
        if UI.dashboard-tab == 0: Reveal { vertical-stretch: 1; OverviewTab { } }
        // The other tabs keep the quick settings beside them.
        if UI.dashboard-tab != 0: HorizontalLayout {
            vertical-stretch: 1;
            spacing: Style.spacing-lg;
            if UI.dashboard-tab == 1: Reveal { horizontal-stretch: 3; MediaTab { } }
            if UI.dashboard-tab == 2: Reveal { horizontal-stretch: 3; PerformanceTab { order <=> root.process-order; } }
            if UI.dashboard-tab == 3: Reveal { horizontal-stretch: 3; NotificationsTab { } }
            ControlsColumn { width: 300px; }
        }
    }
}
