// SlintLu's shared icon set (see SlintLu's res/README.md) plus LunaDash's own mark, "luna".

import { Icon as LibraryIcon } from "@slintlu";

export component Icon {
    in property <string> name;
    in property <color> color: white;
    width: 20px;
    height: 20px;
    if root.name != "luna": LibraryIcon {
        width: 100%;
        height: 100%;
        name: root.name;
        color: root.color;
    }
    if root.name == "luna": Image {
        width: 100%;
        height: 100%;
        source: @image-url("../assets/luna.svg");
        colorize: root.color;
        image-fit: contain;
    }
}
