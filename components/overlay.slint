// Full-screen overlays (dashboard, launcher, settings …). With an `edge`, the content is a
// floating card that slides in from that side of the desktop; without one ("center") it is a
// card over a dimmed backdrop that rises into place, or with `drop-in` slides down from above
// the screen and back up when it closes. A click beside it closes it.

import { PanelWindow, Layer, KeyboardMode, ExclusiveMode, Compositor } from "@slintlu";
import { Style } from "../style/style.slint";
import { UI } from "../state/ui.slint";
import { Drawer } from "shape.slint";

export component Overlay inherits PanelWindow {
    // The UI.overlay value that opens it.
    in property <string> name;
    in property <length> content-width: 900px;
    in property <length> content-height: 600px;
    // "center", or the edge of the desktop the card slides in from: "top", "bottom", "left" or "right".
    in property <string> edge: "center";
    in property <bool> dim: root.edge == "center";
    // A centred card comes down from above the screen and goes back up when closed.
    in property <bool> drop-in;
    callback escape();
    // After it opened and took the keyboard: move focus to a field here.
    callback opened();
    layer: Layer.overlay;
    // While a drop-in slides away, the keyboard is already back with the windows.
    keyboard-mode: root.wanted ? KeyboardMode.exclusive : KeyboardMode.none;
    exclusive-mode: ExclusiveMode.ignore;
    // The compositor blurs the screen behind a dimmed overlay (ext-background-effect-v1).
    background-blur: root.dim && root.wanted;
    anchor-top: true;
    anchor-bottom: true;
    anchor-left: true;
    anchor-right: true;
    property <bool> wanted: UI.overlay == root.name && UI.on-active-screen;
    // A drop-in stays on screen until it has gone back up.
    shown: (root.wanted || (root.drop-in && root.drop > 0.001)) && !root.stepped-aside;
    // 0 → 1 when the overlay opens; `drop` follows it on the shared spring.
    property <float> entrance: root.wanted && !root.peeking ? 1 : 0;
    animate entrance { duration: Style.motion; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
    property <float> drop: root.wanted && !root.peeking ? 1 : 0;
    animate drop { duration: Style.motion-slow; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    default-font-family: Style.font;
    escape => { UI.close-all(); }

    // The desktop area beside the bar.
    property <length> inner-x: Style.inner-left;
    property <length> inner-y: Style.inner-top;
    property <length> inner-width: root.width - Style.inner-left - Style.inner-right;
    property <length> inner-height: root.height - Style.inner-top - Style.inner-bottom;
    property <length> body-width: min(root.content-width, root.inner-width - (root.edge == "center" ? 40px : 2 * Style.edge-gap));
    property <length> body-height: min(root.content-height, root.inner-height - (root.edge == "center" ? 40px : 2 * Style.edge-gap));
    // How far an edge card travels as it slides in.
    property <length> travel: 48px;

    Rectangle {
        background: root.dim ? Style.scrim.with-alpha(0.32 * root.entrance) : transparent;
        TouchArea { enabled: root.wanted; clicked => { UI.close-all(); } }
    }
    scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            reject
        }
        // Edge cards slide in from their side as they fade in; a centred card rises instead.
        Rectangle {
            x: root.inner-x;
            y: root.inner-y;
            width: root.inner-width;
            height: root.inner-height;
            Drawer {
                color: root.edge == "center" ? Style.glass-strong : Style.panel;
                body-width: root.body-width;
                body-height: root.body-height;
                opacity: root.drop-in ? 1 : root.entrance;
                x: root.edge == "left" ? Style.edge-gap - (1 - root.entrance) * root.travel
                    : root.edge == "right" ? parent.width - self.width - Style.edge-gap + (1 - root.entrance) * root.travel
                    : (parent.width - self.width) / 2;
                y: root.edge == "top" ? Style.edge-gap - (1 - root.entrance) * root.travel
                    : root.edge == "bottom" ? parent.height - self.height - Style.edge-gap + (1 - root.entrance) * root.travel
                    : root.drop-in ? (parent.height - self.height) / 2 - (1 - root.drop) * ((parent.height + self.height) / 2 + root.inner-y + 40px)
                    : (parent.height - self.height) / 2 + (root.edge == "center" ? (1 - root.entrance) * 24px : 0px);
                // Swallow clicks so they do not reach the backdrop.
                TouchArea { }
                @children
            }
        }
    }
    // Peeking (UI.peek-overlay): the overlay fades out, then steps aside altogether (its blur
    // with it) for a moment while staying open, so a change behind it (windows rearranging)
    // can be watched, and comes back.
    property <bool> peeking;
    property <bool> stepped-aside;
    property <int> peek-request: UI.peek-serial;
    changed peek-request => { root.peek(); }
    // Switched from the keyboard (or elsewhere) while open: step aside as well.
    property <string> window-style: Compositor.preference-string("windowStyle", "tiling", Compositor.preferences-revision);
    changed window-style => { root.peek(); }
    function peek() {
        if root.shown && !root.peeking {
            root.peeking = true;
        }
    }
    Timer {
        interval: Style.motion-fast;
        running: root.peeking && !root.stepped-aside;
        triggered => { root.stepped-aside = true; }
    }
    Timer {
        interval: 1500ms;
        running: root.stepped-aside;
        triggered => {
            root.stepped-aside = false;
            root.peeking = false;
        }
    }
    changed wanted => {
        if root.wanted {
            scope.focus();
            root.opened();
        }
    }
}
