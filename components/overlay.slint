// Full-screen overlays (dashboard, launcher, settings …). With an `edge`, the content is a
// drawer that slides out of the screen frame on that side and stays joined to it; without one
// ("center") it is a floating card over a dimmed backdrop. A click beside it closes it.

import { PanelWindow, Layer, KeyboardMode, ExclusiveMode } from "@slintlu";
import { Style } from "../style/style.slint";
import { UI } from "../state/ui.slint";
import { Drawer } from "shape.slint";

export component Overlay inherits PanelWindow {
    // The UI.overlay value that opens it.
    in property <string> name;
    in property <length> content-width: 900px;
    in property <length> content-height: 600px;
    // "center", or the frame edge the drawer grows out of: "top", "bottom", "left" or "right".
    in property <string> edge: "center";
    in property <bool> dim: root.edge == "center";
    callback escape();
    layer: Layer.overlay;
    keyboard-mode: KeyboardMode.exclusive;
    exclusive-mode: ExclusiveMode.ignore;
    // The compositor blurs the screen behind a dimmed overlay (ext-background-effect-v1).
    background-blur: root.dim;
    anchor-top: true;
    anchor-bottom: true;
    anchor-left: true;
    anchor-right: true;
    shown: UI.overlay == root.name && UI.on-active-screen;
    // 0 → 1 when the overlay opens.
    property <float> entrance: 0;
    animate entrance { duration: Style.motion; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
    default-font-family: Style.font;
    escape => { UI.close-all(); }

    // The desktop area inside the bar and the frame.
    property <length> inner-x: Style.inner-left;
    property <length> inner-y: Style.inner-top;
    property <length> inner-width: root.width - Style.inner-left - Style.frame-width;
    property <length> inner-height: root.height - Style.inner-top - Style.frame-width;
    property <bool> horizontal: root.edge == "top" || root.edge == "bottom";
    property <length> body-width: min(root.content-width, root.inner-width - (root.edge == "center" ? 40px : root.horizontal ? 2 * Style.frame-radius : 0px));
    property <length> body-height: min(root.content-height, root.inner-height - (root.edge == "center" ? 40px : root.horizontal ? 0px : 2 * Style.frame-radius));

    Rectangle {
        background: root.dim ? Style.scrim.with-alpha(0.32 * root.entrance) : transparent;
        TouchArea { clicked => { UI.close-all(); } }
    }
    scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            reject
        }
        // Edge drawers slide out from under the frame: everything outside the desktop area is
        // clipped away. A centred card rises and fades in instead.
        Rectangle {
            x: root.inner-x;
            y: root.inner-y;
            width: root.inner-width;
            height: root.inner-height;
            clip: root.edge != "center";
            Drawer {
                edge: root.edge;
                color: root.edge == "center" ? Style.glass-strong : Style.frame;
                body-width: root.body-width;
                body-height: root.body-height;
                opacity: root.edge == "center" ? root.entrance : 1;
                x: root.edge == "left" ? -(1 - root.entrance) * (self.width + 2px)
                    : root.edge == "right" ? parent.width - self.width + (1 - root.entrance) * (self.width + 2px)
                    : (parent.width - self.width) / 2;
                y: root.edge == "top" ? -(1 - root.entrance) * (self.height + 2px)
                    : root.edge == "bottom" ? parent.height - self.height + (1 - root.entrance) * (self.height + 2px)
                    : (parent.height - self.height) / 2 + (root.edge == "center" ? (1 - root.entrance) * 24px : 0px);
                // Swallow clicks so they do not reach the backdrop.
                TouchArea { }
                @children
            }
        }
    }
    changed shown => {
        root.entrance = self.shown ? 1 : 0;
        if self.shown { scope.focus(); }
    }
    init => { root.entrance = self.shown ? 1 : 0; }
}
