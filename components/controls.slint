// Small controls shared by every part of the shell.

import { Shell } from "@slintlu";
import { Style } from "../style/style.slint";
import { Icon } from "icon.slint";

// The M3 state layer over a control: its content colour at 8 % on hover, 12 % while pressed.
export component StateLayer inherits Rectangle {
    in property <bool> hovered;
    in property <bool> pressed;
    in property <color> ink: Style.text;
    background: root.ink.with-alpha(root.pressed ? 0.12 : root.hovered ? 0.08 : 0);
    animate background { duration: Style.motion-fast; }
}

// A round icon button. `active` fills it with the accent and squares it off (M3 Expressive's
// shape morph, which a press previews); `tonal` gives it a tonal container at rest.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> tonal;
    in property <color> tint: root.active ? Style.accent-ink : root.tonal ? Style.on-tonal : Style.text;
    in property <length> size: 28px;
    in property <length> icon-size: 17px;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    callback right-clicked();
    callback scrolled(delta: length);

    width: root.size;
    height: root.size;
    border-radius: root.active || touch.pressed ? root.size * 0.32 : root.size / 2;
    background: root.active ? Style.accent : root.tonal ? Style.tonal : transparent;
    animate background { duration: Style.motion-fast; }
    animate border-radius { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    StateLayer { border-radius: parent.border-radius; hovered: touch.has-hover; pressed: touch.pressed; ink: root.tint; }
    Icon {
        name: root.icon;
        color: root.tint;
        width: touch.pressed ? root.icon-size - 1px : root.icon-size;
        height: self.width;
        animate width { duration: Style.motion-fast; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.right-clicked();
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y);
            accept
        }
    }
}

// A text button: tonal by default, filled with the accent when `primary`, a red container when
// `danger`, a plain outline when `outlined`. Pressed, the pill squares off (M3 Expressive).
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> outlined;
    in property <bool> enabled: true;
    callback clicked();

    height: 40px;
    preferred-width: content.preferred-width;
    property <color> ink: !root.enabled ? Style.text.with-alpha(0.38) : root.primary ? Style.accent-ink
        : root.danger ? Style.danger : root.outlined ? Style.accent : Style.on-tonal;
    border-radius: touch.pressed ? 12px : self.height / 2;
    background: !root.enabled ? Style.text.with-alpha(0.08) : root.primary ? Style.accent
        : root.danger ? Style.danger-container : root.outlined ? transparent : Style.tonal;
    border-width: root.outlined ? 1px : 0px;
    border-color: Style.border;
    animate background { duration: Style.motion-fast; }
    animate border-radius { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    StateLayer { border-radius: parent.border-radius; hovered: touch.has-hover; pressed: touch.pressed; ink: root.ink; }
    content := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: root.icon != "" ? 16px : 24px;
        padding-right: 24px;
        if root.icon != "": Icon {
            name: root.icon;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            color: root.ink;
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: Style.font-size;
            font-weight: 600;
            letter-spacing: 0.1px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// An on / off switch (M3): the handle grows when on and carries a check, grows further while
// pressed, and a halo marks it on hover.
export component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();

    width: 52px;
    height: 32px;
    border-radius: self.height / 2;
    background: root.on ? Style.accent : Style.elevated;
    border-width: root.on ? 0 : 2px;
    border-color: Style.muted.with-alpha(0.7);
    animate background { duration: Style.motion-fast; }
    property <length> handle: touch.pressed ? 28px : root.on ? 24px : 16px;
    property <length> centre: root.on ? root.width - root.height / 2 : root.height / 2;
    animate centre { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    Rectangle {
        x: root.centre - self.width / 2;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: (root.on ? Style.accent : Style.text).with-alpha(touch.pressed ? 0.12 : touch.has-hover ? 0.08 : 0);
        animate background { duration: Style.motion-fast; }
    }
    Rectangle {
        x: root.centre - self.width / 2;
        width: root.handle;
        height: self.width;
        border-radius: self.width / 2;
        background: root.on ? Style.accent-ink : touch.has-hover ? Style.text.mix(Style.muted, 0.5) : Style.muted;
        animate width { duration: Style.motion-fast; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
        if root.on: Icon { name: "check"; width: 15px; height: 15px; color: Style.accent; }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
}

// A horizontal slider for values in 0..1 (or up to `maximum`).
export component Slider inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 1.0;
    in property <string> icon;
    callback changed(value: float);
    callback icon-clicked();

    height: 36px;
    HorizontalLayout {
        spacing: 10px;
        if root.icon != "": IconButton {
            icon: root.icon;
            size: 32px;
            y: (parent.height - self.height) / 2;
            clicked => { root.icon-clicked(); }
        }
        track := Rectangle {
            property <float> ratio: clamp(root.value / root.maximum, 0, 1);
            property <length> handle-x: 2px + (self.width - 4px - 4px) * track.ratio;
            // Active part, a gap around the handle, then the inactive part (M3 Expressive).
            Rectangle {
                x: 0;
                width: max(0px, track.handle-x - 4px);
                height: 16px;
                border-radius: 8px;
                border-top-right-radius: 2px;
                border-bottom-right-radius: 2px;
                background: Style.accent;
            }
            Rectangle {
                x: track.handle-x + 8px;
                width: max(0px, parent.width - self.x);
                height: 16px;
                border-radius: 8px;
                border-top-left-radius: 2px;
                border-bottom-left-radius: 2px;
                background: Style.elevated;
            }
            // The stop at the end of the track.
            Rectangle {
                x: parent.width - 10px;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Style.accent;
                visible: track.ratio < 0.97;
            }
            Rectangle {
                x: track.handle-x + 2px - self.width / 2;
                width: slide.pressed ? 2px : 4px;
                height: slide.has-hover || slide.pressed ? 36px : 32px;
                border-radius: 2px;
                background: Style.accent;
                animate width, height { duration: Style.motion-fast; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
            }
            slide := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && self.pressed) {
                        root.changed(clamp(self.mouse-x / self.width, 0, 1) * root.maximum);
                    }
                }
                scroll-event(event) => {
                    root.changed(clamp(root.value + (event.delta-y > 0 ? 0.05 : -0.05) * root.maximum, 0, root.maximum));
                    accept
                }
            }
        }
    }
}

// A quick-settings tile: icon, label, state line; highlighted when on.
export component QuickToggle inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> detail;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked();

    height: 58px;
    // Off tiles are rounded rectangles, on tiles become pills (M3 Expressive shape morph).
    border-radius: root.on ? self.height / 2 : Style.radius-large * 0.6;
    background: root.on ? Style.accent : Style.elevated;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: Style.motion-fast; }
    animate border-radius { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    StateLayer { border-radius: parent.border-radius; hovered: touch.has-hover; pressed: touch.pressed; ink: root.on ? Style.accent-ink : Style.text; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 10px;
        // The icon in a badge of its own.
        Rectangle {
            width: 38px;
            height: 38px;
            y: (parent.height - self.height) / 2;
            border-radius: root.on ? 19px : 12px;
            background: root.on ? Style.accent-ink.with-alpha(0.14) : Style.surface;
            animate border-radius { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
            Icon {
                name: root.icon;
                width: 19px;
                height: 19px;
                color: root.on ? Style.accent-ink : Style.text;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: Style.font-size;
                font-weight: 600;
                color: root.on ? Style.accent-ink : Style.text;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                font-size: Style.font-small;
                color: root.on ? Style.accent-ink.with-alpha(0.75) : Style.muted;
                overflow: elide;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Fades its content in when it appears: wrap the content of a tab or page (re-created when
// the selection changes) to cross-fade it.
export component Reveal inherits Rectangle {
    property <float> amount: 0;
    opacity: self.amount;
    init => { self.amount = 1; }
    animate amount { duration: Style.motion; easing: ease-out; }
    @children
}

// A rounded card on popups and the dashboard.
export component Card inherits Rectangle {
    border-radius: Style.radius-large * 0.6;
    background: Style.surface;
}

// A free-floating panel (dialogs, settings): glass, fully rounded.
export component Surface inherits Rectangle {
    border-radius: Style.radius;
    background: Style.glass-strong;
    drop-shadow-blur: 24px;
    drop-shadow-color: Style.shadow;
    drop-shadow-offset-y: 6px;
}

// A slider with a label and value that applies when released (or on scroll), so dragging does
// not send a command per pixel.
export component RangeSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> value;
    in property <string> unit;
    in property <length> track-width: 220px;
    callback committed(value: float);
    property <float> live: root.value;
    property <bool> dragging;
    property <float> shown: root.dragging ? root.live : root.value;
    property <float> ratio: clamp((root.shown - root.minimum) / max(0.0001, root.maximum - root.minimum), 0, 1);
    function snap(raw: float) -> float {
        return clamp(Math.round(raw / root.step) * root.step, root.minimum, root.maximum);
    }
    height: 32px;
    width: root.track-width + 60px;
    HorizontalLayout {
        spacing: 12px;
        track := Rectangle {
            width: root.track-width;
            property <length> handle-x: (self.width - 4px) * root.ratio;
            Rectangle {
                x: 0;
                width: max(0px, track.handle-x - 4px);
                height: 12px;
                border-radius: 6px;
                border-top-right-radius: 2px;
                border-bottom-right-radius: 2px;
                background: Style.accent;
            }
            Rectangle {
                x: track.handle-x + 8px;
                width: max(0px, parent.width - self.x);
                height: 12px;
                border-radius: 6px;
                border-top-left-radius: 2px;
                border-bottom-left-radius: 2px;
                background: Style.elevated;
            }
            Rectangle {
                x: parent.width - 8px;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Style.accent;
                visible: root.ratio < 0.97;
            }
            Rectangle {
                x: track.handle-x + 2px - self.width / 2;
                width: root.dragging ? 2px : 4px;
                height: touch.has-hover || root.dragging ? 32px : 28px;
                border-radius: 2px;
                background: Style.accent;
                animate width, height { duration: Style.motion-fast; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
            }
            // The value rides above the handle while it is dragged.
            Rectangle {
                x: track.handle-x + 2px - self.width / 2;
                y: -self.height - 6px;
                width: max(40px, bubble.preferred-width + 16px);
                height: 28px;
                border-radius: 14px;
                background: Style.text;
                opacity: root.dragging ? 1 : 0;
                animate opacity { duration: Style.motion-fast; }
                bubble := Text {
                    text: Math.round(root.shown) + root.unit;
                    color: Style.base;
                    font-size: Style.font-small;
                    font-weight: 600;
                }
            }
            touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.dragging = true;
                    }
                    if root.dragging && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                        root.live = root.snap(root.minimum + clamp(self.mouse-x / self.width, 0, 1) * (root.maximum - root.minimum));
                    }
                    if event.kind == PointerEventKind.up && root.dragging {
                        root.dragging = false;
                        root.committed(root.live);
                    }
                }
                scroll-event(event) => {
                    root.committed(root.snap(root.value + (event.delta-y > 0 ? root.step : -root.step)));
                    accept
                }
            }
        }
        Text {
            width: 48px;
            text: Math.round(root.shown) + root.unit;
            color: Style.muted;
            font-size: Style.font-small;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// A row of round colour choices; `selected` -1 for none.
export component Swatches inherits HorizontalLayout {
    in property <[color]> colors;
    in property <int> selected: -1;
    callback chosen(index: int);
    spacing: 8px;
    alignment: end;
    for c[i] in root.colors: Rectangle {
        width: 26px;
        height: 26px;
        y: (parent.height - self.height) / 2;
        border-radius: 13px;
        background: c;
        border-width: i == root.selected ? 3px : touch.has-hover ? 2px : 0;
        border-color: i == root.selected ? Style.text : Style.border;
        animate border-width { duration: Style.motion-fast; }
        if i == root.selected: Icon { name: "check"; width: 14px; height: 14px; color: #1c2028; }
        touch := TouchArea { clicked => { root.chosen(i); } }
    }
}

// A small heading inside popups and pages.
export component SectionTitle inherits Text {
    color: Style.accent;
    font-size: Style.font-small;
    font-weight: 500;
    letter-spacing: 0.4px;
}

// A row with an icon, two lines of text and optional trailing content.
export component ListRow inherits Rectangle {
    in property <string> icon;
    in property <image> image;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected;
    callback clicked();

    height: 52px;
    border-radius: root.selected ? self.height / 2 : touch.pressed ? Style.radius-small : Style.radius-medium;
    background: root.selected ? Style.tonal : transparent;
    animate background { duration: Style.motion-fast; }
    animate border-radius { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    StateLayer { border-radius: parent.border-radius; hovered: touch.has-hover; pressed: touch.pressed; ink: root.selected ? Style.on-tonal : Style.text; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        if root.icon != "": Icon {
            name: root.icon;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            color: root.selected ? Style.on-tonal : Style.text;
        }
        if root.icon == "": Image {
            source: root.image;
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; color: Style.text; font-size: Style.font-size; overflow: elide; }
            if root.subtitle != "": Text { text: root.subtitle; color: Style.muted; font-size: Style.font-small; overflow: elide; }
        }
        @children
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A single-line text field, with a hint while it is empty; `password` hides what is typed.
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> password;
    in-out property <string> text;
    callback accepted();

    height: 44px;
    border-radius: self.height / 2;
    background: Style.elevated;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Style.accent : field.has-hover ? Style.muted : Style.border;
    animate border-color { duration: Style.motion-fast; }
    field := TouchArea { mouse-cursor: MouseCursor.text; clicked => { input.focus(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; width: 18px; height: 18px; color: input.has-focus ? Style.accent : Style.muted; }
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "" && !(input.has-focus && Shell.composing): Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Style.muted.with-alpha(0.7);
                font-size: Style.font-size;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                color: Style.text;
                font-size: Style.font-size;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                accepted => { root.accepted(); }
            }
        }
    }
}

// One key of a shortcut, drawn like a keycap.
export component Keycap inherits Rectangle {
    in property <string> key;
    // Key names as LunaDash writes them, shown the way the keyboard labels them.
    pure function label(key: string) -> string {
        key == "Meta" ? "Super"
            : key == "Return" ? "Enter"
            : key == "bracketleft" ? "["
            : key == "bracketright" ? "]"
            : key == "period" ? "."
            : key == "comma" ? ","
            : key == "grave" ? "`"
            : key == "minus" ? "-"
            : key == "equal" ? "="
            : key == "Space" ? "Space"
            : key == "Escape" ? "Esc"
            : key == "Ctrl" ? "Ctrl"
            : key
    }
    width: max(26px, caption.preferred-width + 14px);
    height: 26px;
    border-radius: 6px;
    background: Style.elevated;
    border-width: 1px;
    border-color: Style.hairline;
    caption := Text {
        text: root.label(root.key);
        color: Style.text;
        font-size: Style.font-small;
        font-weight: 600;
    }
}
