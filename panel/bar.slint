// The bar, in the frame's colour: along the top edge (`Bar`, the default) or down the left
// one (`SideBar`). In reading order — the LunaDash mark (launcher), workspaces, the focused
// window, tray, clock, system status, settings and power. Its popouts slide out of it beside
// the item that opened them.

import { PanelWindow, ExclusiveMode, MediaPlayerInfo, Shell, Workspaces, Switcher, Audio, Network, Bluetooth, Battery, Notifications, Tray, Compositor, ClipboardHistory, Clock, Apps, AppInfo, Media, System } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { UI } from "../state/ui.slint";
import { Time } from "../state/time.slint";
import { Apply } from "../state/apply.slint";
import { Icon } from "../components/icon.slint";
import { IconButton } from "../components/controls.slint";

// Bar items are 30–36 px squares; in a horizontal bar they are centred vertically and the
// other way round.
component Slot inherits Rectangle {
    in property <bool> vertical;
    in property <length> size: 36px;
    width: root.vertical ? Style.bar-width : root.size;
    height: root.vertical ? root.size : Style.bar-width;
}

// The workspaces as a pill: occupied ones on a tonal track, the active one a long
// primary-coloured capsule.
component WorkspaceDot inherits Rectangle {
    in property <bool> vertical;
    in property <bool> numbers;
    in property <int> index;
    in property <bool> active;
    in property <bool> urgent;
    in property <bool> occupied;
    // The workspace's id: its windows' icons follow the marker in a top bar.
    in property <int> id;
    callback clicked();
    width: root.vertical ? 24px : max(root.active ? 44px : 24px, marks.preferred-width);
    height: root.vertical ? (root.active ? 44px : 24px) : 24px;
    border-radius: 12px;
    background: root.active ? Style.accent : root.urgent ? Style.danger
        : touch.has-hover ? Style.hover : root.occupied ? Style.elevated : transparent;
    animate width, height { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    animate background { duration: Style.motion-fast; }
    marks := HorizontalLayout {
        alignment: center;
        padding-left: root.occupied && !root.vertical ? 8px : 0px;
        padding-right: root.occupied && !root.vertical ? 5px : 0px;
        Rectangle {
            width: root.numbers ? 12px : 8px;
            if root.numbers: Text {
                text: root.index;
                color: root.active ? Style.accent-ink : root.occupied ? Style.text : Style.muted;
                font-size: Style.font-small;
                font-weight: root.active ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if !root.numbers: Rectangle {
                width: root.active ? 8px : 6px;
                height: self.width;
                border-radius: self.width / 2;
                background: root.active ? Style.accent-ink : root.occupied ? Style.text : Style.muted.with-alpha(0.6);
            }
        }
        // The icons of the windows on it (others collapse to nothing).
        if !root.vertical: HorizontalLayout {
            for w in Workspaces.windows: slot := Rectangle {
                property <bool> here: w.workspace == root.id;
                property <AppInfo> app: Apps.get(w.app-id + ".desktop");
                width: self.here ? 20px : 0px;
                visible: self.here;
                if slot.here && slot.app.icon.width > 0: Image {
                    x: 4px;
                    width: 15px;
                    height: 15px;
                    source: slot.app.icon;
                    image-fit: contain;
                }
                if slot.here && slot.app.icon.width == 0: Icon {
                    x: 4px;
                    name: "window";
                    width: 14px;
                    height: 14px;
                    color: root.active ? Style.accent-ink : Style.muted;
                }
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Workspaces-Strip inherits Rectangle {
    in property <bool> vertical;
    property <bool> numbers: Prefs.workspace-style == "numbers";
    width: root.vertical ? 32px : row.preferred-width;
    height: root.vertical ? column.preferred-height : 32px;
    border-radius: 16px;
    background: Style.surface;
    column := VerticalLayout {
        padding: 4px;
        spacing: 2px;
        if root.vertical: VerticalLayout {
            spacing: 2px;
            for ws in Workspaces.all: WorkspaceDot {
                // Only this screen's workspaces; every workspace when the compositor has one output name.
                visible: ws.output == "" || ws.output == Shell.screen.name;
                vertical: true;
                numbers: root.numbers;
                index: ws.index;
                active: ws.active;
                urgent: ws.urgent;
                occupied: ws.windows > 0;
                id: ws.id;
                clicked => { Workspaces.focus(ws.id); }
            }
        }
    }
    row := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        if !root.vertical: HorizontalLayout {
            spacing: 2px;
            for ws in Workspaces.all: WorkspaceDot {
                visible: ws.output == "" || ws.output == Shell.screen.name;
                vertical: false;
                numbers: root.numbers;
                index: ws.index;
                active: ws.active;
                urgent: ws.urgent;
                occupied: ws.windows > 0;
                id: ws.id;
                clicked => { Workspaces.focus(ws.id); }
            }
        }
    }
}

// An icon in the status pill. `anchor` is where its popout should line up.
component StatusIcon inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> highlighted;
    in property <bool> badge;
    in property <color> tint: Style.text;
    out property <length> anchor: Style.bar-top ? self.absolute-position.x + self.width / 2 : self.absolute-position.y + self.height / 2;
    callback clicked();
    callback right-clicked();
    callback scrolled(delta: length);

    width: Style.bar-top ? max(30px, row.preferred-width + 16px) : 30px;
    height: Style.bar-top ? 28px : (root.label != "" ? 44px : 30px);
    border-radius: 15px;
    background: root.highlighted ? Style.accent : touch.pressed ? Style.pressed : touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    property <color> ink: root.highlighted ? Style.accent-ink : root.tint;
    // Side bar: icon over a small label.
    if !Style.bar-top: VerticalLayout {
        alignment: center;
        spacing: 1px;
        Rectangle {
            height: 18px;
            Icon { name: root.icon; width: 18px; height: 18px; color: root.ink; }
        }
        if root.label != "": Text {
            text: root.label;
            color: root.highlighted ? Style.accent-ink : Style.muted;
            font-size: 10px;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }
    // Top bar: icon beside the label.
    row := HorizontalLayout {
        alignment: center;
        spacing: 4px;
        if Style.bar-top: Rectangle {
            width: 18px;
            Icon { name: root.icon; width: 18px; height: 18px; color: root.ink; }
        }
        if Style.bar-top && root.label != "": Text {
            text: root.label;
            max-width: 110px;
            overflow: elide;
            color: root.highlighted ? Style.accent-ink : Style.text;
            font-size: Style.font-small;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    if root.badge: Rectangle {
        x: parent.width / 2 + 4px;
        y: (parent.height - 18px) / 2 - 1px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Style.danger;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.right-clicked();
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y);
            accept
        }
    }
}

component ClipboardStatus inherits StatusIcon {
    icon: "clipboard";
    highlighted: UI.popup == "clipboard";
    clicked => { UI.toggle-popup-at("clipboard", self.anchor); }
}

component NetworkStatus inherits StatusIcon {
    icon: !Network.connected ? "wifi-off" : Network.kind == "wifi" ? "wifi" : "ethernet";
    // The network's name beside the icon in a top bar.
    label: Style.bar-top && Network.connected && Network.kind == "wifi" ? Network.name : "";
    tint: Network.online ? Style.text : Style.warning;
    highlighted: UI.popup == "network";
    clicked => { UI.toggle-popup-at("network", self.anchor); }
}

component BluetoothStatus inherits StatusIcon {
    icon: "bluetooth";
    badge: Bluetooth.connected-count > 0;
    clicked => { UI.toggle-popup-at("network", self.anchor); }
}

component AudioStatus inherits StatusIcon {
    icon: Audio.output.muted ? "volume-mute" : Audio.output.volume < 0.4 ? "volume-low" : "volume";
    label: Style.bar-top && !Audio.output.muted ? Math.round(Audio.output.volume * 100) + "%" : "";
    highlighted: UI.popup == "audio";
    clicked => { UI.toggle-popup-at("audio", self.anchor); }
    right-clicked => { Audio.toggle-muted(); }
    scrolled(delta) => {
        Audio.set-volume(clamp(Audio.output.volume + (delta > 0 ? 0.05 : -0.05), 0, 1.5));
    }
}

component BatteryStatus inherits StatusIcon {
    icon: Battery.charging ? "battery-charging" : "battery";
    label: Math.round(Battery.level * 100) + (Style.bar-top ? "%" : "");
    tint: Battery.level < 0.15 && !Battery.charging ? Style.danger : Style.text;
    clicked => { UI.open-dashboard(2); }
}

component NotificationStatus inherits StatusIcon {
    icon: Notifications.do-not-disturb ? "bell-off" : "bell";
    badge: !Style.bar-top && Notifications.count > 0;
    label: Style.bar-top && Notifications.count > 0 ? Notifications.count : "";
    highlighted: UI.overlay == "dashboard" && UI.dashboard-tab == 3;
    clicked => { UI.open-dashboard(3); }
    right-clicked => { Notifications.set-do-not-disturb(!Notifications.do-not-disturb); }
}

// The system status icons in one surface-container pill.
component StatusPill inherits Rectangle {
    in property <bool> vertical;
    out property <length> anchor: root.vertical ? self.absolute-position.y + self.height / 2 : self.absolute-position.x + self.width / 2;
    width: root.vertical ? 36px : row.preferred-width;
    height: root.vertical ? column.preferred-height : 36px;
    border-radius: 18px;
    background: Style.surface;
    column := VerticalLayout {
        padding: 3px;
        spacing: 2px;
        if root.vertical && ClipboardHistory.available: ClipboardStatus { }
        if root.vertical && Network.available: NetworkStatus { }
        if root.vertical && Bluetooth.available && Bluetooth.powered: BluetoothStatus { }
        if root.vertical && Audio.available: AudioStatus { }
        if root.vertical && Battery.available: BatteryStatus { }
        if root.vertical: NotificationStatus { }
    }
    row := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        if !root.vertical && ClipboardHistory.available: ClipboardStatus { }
        if !root.vertical && Network.available: NetworkStatus { }
        if !root.vertical && Bluetooth.available && Bluetooth.powered: BluetoothStatus { }
        if !root.vertical && Audio.available: AudioStatus { }
        if !root.vertical && Battery.available: BatteryStatus { }
        if !root.vertical: NotificationStatus { }
    }
}

// The LunaDash logo: the launcher (right-click: the dashboard). The app icon itself, on a
// soft glow that brightens on hover and turns into an accent ring while the launcher is open.
component LunaButton inherits Rectangle {
    property <bool> open: UI.overlay == "launcher";
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: transparent;
    border-width: root.open ? 2px : 0px;
    border-color: Style.accent;
    drop-shadow-blur: root.open || luna.has-hover ? 14px : 6px;
    drop-shadow-color: Style.accent.with-alpha(root.open || luna.has-hover ? 0.55 : 0.18);
    animate drop-shadow-blur, drop-shadow-color, border-width { duration: Style.motion-fast; }
    Rectangle {
        width: luna.pressed ? 26px : root.open ? 28px : 32px;
        height: self.width;
        border-radius: self.width * 0.28;
        clip: true;
        animate width { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../assets/lunadash.png");
            image-fit: cover;
        }
    }
    luna := TouchArea {
        clicked => { UI.toggle-overlay("launcher"); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                UI.toggle-overlay("dashboard");
            }
        }
    }
}

// What is playing: cover art, title and artist, and play / pause. Opens the media tab.
component MediaChip inherits Rectangle {
    property <MediaPlayerInfo> player: Media.player;
    width: row.preferred-width;
    height: 36px;
    border-radius: 18px;
    background: touch.has-hover ? Style.hover : Style.surface;
    animate background { duration: Style.motion-fast; }
    touch := TouchArea { clicked => { UI.open-dashboard(1); } }
    row := HorizontalLayout {
        padding: 4px;
        padding-right: 6px;
        spacing: 8px;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            clip: true;
            background: Style.tonal;
            if root.player.art.width > 0: Image { width: 100%; height: 100%; source: root.player.art; image-fit: cover; }
            if root.player.art.width == 0: Icon { name: "music"; width: 15px; height: 15px; color: Style.on-tonal; }
            // A ring that turns while playing would be nicer; a dot marks it for now.
        }
        VerticalLayout {
            alignment: center;
            max-width: 220px;
            Text {
                text: root.player.title != "" ? root.player.title : root.player.identity;
                color: Style.text;
                font-size: Style.font-small;
                font-weight: 500;
                overflow: elide;
            }
            if root.player.artist != "": Text {
                text: root.player.artist;
                color: Style.muted;
                font-size: 10px;
                overflow: elide;
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: root.player.playing ? "pause" : "play";
            size: 26px;
            icon-size: 14px;
            active: root.player.playing;
            clicked => { Media.play-pause(); }
        }
    }
}

// Processor and memory use as two small meters. Opens the performance tab.
component UsageChip inherits Rectangle {
    width: row.preferred-width;
    height: 36px;
    border-radius: 18px;
    background: touch.has-hover ? Style.hover : Style.surface;
    animate background { duration: Style.motion-fast; }
    touch := TouchArea { clicked => { UI.open-dashboard(2); } }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        for meter in [
            { icon: "cpu", value: System.cpu },
            { icon: "memory", value: System.memory },
        ]: HorizontalLayout {
            spacing: 6px;
            Icon {
                y: (parent.height - self.height) / 2;
                name: meter.icon;
                width: 15px;
                height: 15px;
                color: meter.value > 0.85 ? Style.danger : Style.accent;
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: Math.round(meter.value * 100) + "%";
                    color: Style.text;
                    font-size: 11px;
                    font-weight: 500;
                }
                Rectangle {
                    width: 28px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Style.elevated;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(meter.value, 0, 1);
                        border-radius: 1.5px;
                        background: meter.value > 0.85 ? Style.danger : Style.accent;
                        animate width { duration: Style.motion; }
                    }
                }
            }
        }
    }
}

// The focused window: its application's icon and title (turned to run down a side bar).
component WindowTitle inherits Rectangle {
    in property <bool> vertical;
    property <AppInfo> app: Apps.get(Workspaces.focused-window.app-id + ".desktop");
    property <bool> has-title: Prefs.window-title && Workspaces.focused-window.title != "";
    if root.has-title && root.app.icon.width > 0: Image {
        x: root.vertical ? (parent.width - self.width) / 2 : 0px;
        y: root.vertical ? 0px : (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.app.icon;
        image-fit: contain;
    }
    if root.has-title && root.app.icon.width == 0: Icon {
        x: root.vertical ? (parent.width - self.width) / 2 : 0px;
        y: root.vertical ? 0px : (parent.height - self.height) / 2;
        name: "window";
        width: 16px;
        height: 16px;
        color: Style.accent;
    }
    if root.has-title && !root.vertical: VerticalLayout {
        x: 26px;
        width: parent.width - self.x;
        alignment: center;
        Text {
            text: root.app.name != "" ? root.app.name : Workspaces.focused-window.app-id;
            color: Style.muted;
            font-size: 10px;
            overflow: elide;
        }
        Text {
            text: Workspaces.focused-window.title;
            color: Style.text;
            font-size: Style.font-size;
            font-weight: 500;
            overflow: elide;
        }
    }
    if root.has-title && root.vertical: Rectangle {
        y: 28px;
        height: parent.height - self.y;
        clip: true;
        Text {
            // Laid out horizontally, then turned to run down the bar.
            width: parent.height;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            transform-rotation: 90deg;
            text: Workspaces.focused-window.title;
            color: Style.text;
            font-size: Style.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component TrayIcon inherits Rectangle {
    in property <string> id;
    in property <image> icon;
    in property <bool> is-menu;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: touch.has-hover ? Style.hover : transparent;
    property <length> anchor: Style.bar-top ? self.absolute-position.x + self.width / 2 : self.absolute-position.y + self.height / 2;
    Image { source: root.icon; width: 18px; height: 18px; image-fit: contain; }
    touch := TouchArea {
        clicked => {
            if root.is-menu {
                UI.toggle-popup-at("tray", root.anchor);
                Tray.open-menu(root.id);
            } else {
                Tray.activate(root.id);
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                UI.toggle-popup-at("tray", root.anchor);
                Tray.open-menu(root.id);
            }
        }
        scroll-event(event) => {
            Tray.scroll(root.id, event.delta-y > 0 ? -1 : 1);
            accept
        }
    }
}

// The clock: hours over minutes in a side bar, one line (and the date) at the top.
component ClockItem inherits Rectangle {
    in property <bool> vertical;
    property <bool> open: UI.popup == "calendar";
    property <length> anchor: root.vertical ? self.absolute-position.y + self.height / 2 : self.absolute-position.x + self.width / 2;
    width: root.vertical ? 36px : line.preferred-width;
    height: root.vertical ? stack.preferred-height + 12px : 36px;
    border-radius: 18px;
    background: root.open ? Style.accent : touch.has-hover ? Style.hover : root.vertical ? transparent : Style.surface;
    animate background { duration: Style.motion-fast; }
    stack := VerticalLayout {
        alignment: center;
        if root.vertical: Text {
            text: Prefs.clock-24h ? Time.two(Clock.hour) : Time.two(Math.mod(Clock.hour + 11, 12) + 1);
            color: root.open ? Style.accent-ink : Style.accent;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        if root.vertical: Text {
            text: Time.two(Clock.minute);
            color: root.open ? Style.accent-ink : Style.text;
            font-size: 15px;
            font-weight: 500;
            horizontal-alignment: center;
        }
        if root.vertical && !Prefs.clock-24h: Text {
            text: Clock.hour < 12 ? "am" : "pm";
            color: root.open ? Style.accent-ink : Style.muted;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
    line := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        if !root.vertical: Icon {
            y: (parent.height - self.height) / 2;
            name: "calendar";
            width: 15px;
            height: 15px;
            color: root.open ? Style.accent-ink : Style.accent;
        }
        if !root.vertical: Text {
            text: Time.clock;
            color: root.open ? Style.accent-ink : Style.accent;
            font-size: Style.font-size + 1px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if !root.vertical && Prefs.clock-date: Text {
            text: Time.short-date;
            color: root.open ? Style.accent-ink : Style.text;
            font-size: Style.font-size;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { UI.toggle-popup-at("calendar", root.anchor); } }
}

component SettingsButton inherits IconButton {
    icon: "settings";
    size: 30px;
    icon-size: 17px;
    active: UI.overlay == "settings";
    clicked => { UI.toggle-overlay("settings"); }
}

component PowerButton inherits IconButton {
    icon: "power";
    size: 30px;
    icon-size: 17px;
    tint: UI.overlay == "power" ? Style.accent-ink : Style.danger;
    active: UI.overlay == "power";
    clicked => { UI.toggle-overlay("power"); }
}

component SwitcherButton inherits IconButton {
    icon: "window";
    size: 30px;
    icon-size: 16px;
    active: Switcher.active;
    clicked => { Switcher.open(false); }
    right-clicked => { Switcher.open(true); }
}

// What both bars share: the frame colour, the shell-wide startup work and the compositor's
// keyboard shortcuts. Only the bar in use (`active`) acts on them.
component BarWindow inherits PanelWindow {
    in property <bool> active;
    // Where the clipboard popout lines up when a shortcut opens it.
    in property <length> status-anchor;
    namespace: "lunadash-bar";
    exclusive-mode: ExclusiveMode.ignore;
    shown: root.active;
    default-font-family: Style.font;

    property <int> request-serial: Compositor.request-serial;
    changed request-serial => {
        if !UI.primary || !root.active {
            return;
        }
        if Compositor.request == "launcher" || Compositor.request == "orbit-launcher" {
            if Compositor.request-argument == "false" {
                UI.close-all();
            } else {
                UI.toggle-overlay("launcher");
            }
        } else if Compositor.request == "settings" {
            UI.open-settings(Compositor.request-argument == "" ? "appearance" : Compositor.request-argument);
        } else if Compositor.request == "wallpaper-picker" {
            UI.toggle-overlay("wallpapers");
        } else if Compositor.request == "control-center" {
            UI.toggle-overlay("dashboard");
        } else if Compositor.request == "clipboard" {
            UI.toggle-popup-at("clipboard", root.status-anchor);
        } else if Compositor.request == "power-menu" {
            UI.toggle-overlay("power");
        }
    }

    property <string> desktop-language: Compositor.language;
    changed desktop-language => {
        if UI.primary && root.active {
            Apply.language();
        }
    }

    ready => {
        // Shell-wide settings are applied once, from the primary screen. Both bars exist (one
        // hidden), so only the one in use does it.
        if UI.primary && root.active {
            Apply.all();
            // LunaDash has its own first-run setup; the card is for other compositors.
            if !Prefs.welcome-done && !Compositor.has-commands {
                UI.open-overlay("welcome");
            }
        }
    }

    Rectangle { background: Style.frame; }
    @children
}

// Along the top edge (the default).
export component Bar inherits BarWindow {
    active: Style.bar-top;
    anchor-top: true;
    anchor-left: true;
    anchor-right: true;
    preferred-height: Style.bar-width;
    status-anchor: status.anchor;

    HorizontalLayout {
        padding-left: Style.frame-width + 6px;
        padding-right: Style.frame-width + 6px;
        spacing: Style.spacing-sm;
        alignment: stretch;

        Slot { size: 36px; LunaButton { } }
        if Workspaces.available: Slot { size: ws.width; ws := Workspaces-Strip { vertical: false; } }
        if Switcher.available: Slot { size: 30px; SwitcherButton { } }
        WindowTitle {
            horizontal-stretch: 1;
            min-width: 0px;
            vertical: false;
        }
        if Media.available && (Media.player.title != "" || Media.player.identity != ""): Slot { size: media.width; media := MediaChip { } }
        Slot { size: usage.width; usage := UsageChip { } }
        if Tray.items.length > 0: HorizontalLayout {
            spacing: 2px;
            for item in Tray.items: Slot {
                visible: item.status != "passive";
                size: 30px;
                TrayIcon { id: item.id; icon: item.icon; is-menu: item.item-is-menu; }
            }
        }
        Slot { size: clock.width; clock := ClockItem { vertical: false; } }
        Slot { size: status.width; status := StatusPill { vertical: false; } }
        Slot { size: 30px; SettingsButton { } }
        Slot { size: 30px; PowerButton { } }
    }
}

// Down the left edge.
export component SideBar inherits BarWindow {
    namespace: "lunadash-sidebar";
    active: !Style.bar-top;
    anchor-top: true;
    anchor-bottom: true;
    anchor-left: true;
    preferred-width: Style.bar-width;
    status-anchor: status.anchor;

    VerticalLayout {
        padding-top: Style.frame-width + 6px;
        padding-bottom: Style.frame-width + 6px;
        spacing: Style.spacing-md;
        alignment: stretch;

        Slot { vertical: true; size: 36px; LunaButton { } }
        if Workspaces.available: Slot { vertical: true; size: ws.height; ws := Workspaces-Strip { vertical: true; } }
        if Switcher.available: Slot { vertical: true; size: 30px; SwitcherButton { } }
        WindowTitle {
            vertical-stretch: 1;
            min-height: 0px;
            vertical: true;
        }
        if Tray.items.length > 0: VerticalLayout {
            spacing: 2px;
            for item in Tray.items: Slot {
                visible: item.status != "passive";
                vertical: true;
                size: 30px;
                TrayIcon { id: item.id; icon: item.icon; is-menu: item.item-is-menu; }
            }
        }
        Slot { vertical: true; size: clock.height; clock := ClockItem { vertical: true; } }
        Slot { vertical: true; size: status.height; status := StatusPill { vertical: true; } }
        Slot { vertical: true; size: 30px; SettingsButton { } }
        Slot { vertical: true; size: 30px; PowerButton { } }
    }
}
