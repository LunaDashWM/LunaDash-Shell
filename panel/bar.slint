// The bar: floating islands along the top or bottom edge (`Bar`) or down a side one
// (`SideBar`). Its items, in reading order, are the user's arrangement (PanelLayout); by
// default the LunaDash mark (launcher), workspaces, taskbar, the focused window, tray, clock,
// system status, settings and power. Its popouts slide out of it beside the item that opened
// them.

import { PanelWindow, ExclusiveMode, MediaPlayerInfo, Shell, Workspaces, WindowInfo, Audio, Network, Bluetooth, Battery, Notifications, Tray, Compositor, ClipboardHistory, Clock, Apps, AppInfo, Media, System, Shared } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { PanelLayout } from "../state/panel-layout.slint";
import { UI } from "../state/ui.slint";
import { Time } from "../state/time.slint";
import { Apply } from "../state/apply.slint";
import { Widgets } from "../state/widgets.slint";
import { Icon } from "../components/icon.slint";
import { IconButton } from "../components/controls.slint";
import { Picture } from "../components/picture.slint";

// The workspaces as a pill of buttons, like waybar's: occupied ones on a tonal track, the
// active one a primary-coloured capsule. The windows themselves are in the taskbar after it.
component WorkspaceDot inherits Rectangle {
    in property <bool> vertical;
    in property <bool> numbers;
    in property <int> index;
    in property <bool> active;
    in property <bool> urgent;
    in property <bool> occupied;
    in property <int> id;
    callback clicked();
    // Dots: a bare mark per workspace (dim when empty, brighter with windows) that stretches
    // into an accent capsule for the current one. Numbers: a capsule holding the number.
    property <length> long: root.numbers ? (root.active ? 36px : 24px) : root.active ? 26px : 10px;
    property <length> short: root.numbers ? 24px : 10px;
    width: root.vertical ? 24px : max(root.long, root.numbers ? marks.preferred-width : 0px) + (root.numbers ? 0px : 8px);
    height: root.vertical ? root.long + (root.numbers ? 0px : 8px) : 24px;
    animate width, height { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    Rectangle {
        width: root.vertical ? root.short : parent.width - (root.numbers ? 0px : 8px);
        height: root.vertical ? parent.height - (root.numbers ? 0px : 8px) : root.short;
        border-radius: min(self.width, self.height) / 2;
        background: root.active ? Style.accent : root.urgent ? Style.danger
            : root.numbers ? (touch.has-hover ? Style.hover : root.occupied ? Style.elevated : transparent)
            : root.occupied ? Style.text.with-alpha(touch.has-hover ? 0.85 : 0.6) : Style.muted.with-alpha(touch.has-hover ? 0.6 : 0.3);
        animate background { duration: Style.motion-fast; }
    }
    marks := HorizontalLayout {
        alignment: center;
        padding-left: 6px;
        padding-right: 6px;
        if root.numbers: Text {
            width: 12px;
            text: root.index;
            color: root.active ? Style.accent-ink : root.occupied ? Style.text : Style.muted;
            font-size: Style.font-small;
            font-weight: root.active ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component Workspaces-Strip inherits Rectangle {
    in property <bool> vertical;
    property <bool> numbers: Prefs.workspace-style == "numbers";
    width: root.vertical ? 32px : row.preferred-width;
    height: root.vertical ? column.preferred-height : 32px;
    column := VerticalLayout {
        padding: 4px;
        spacing: 2px;
        if root.vertical: VerticalLayout {
            spacing: 2px;
            for ws in Workspaces.all: WorkspaceDot {
                // Only this screen's workspaces; every workspace when the compositor has one output name.
                visible: ws.output == "" || ws.output == Shell.screen.name;
                vertical: true;
                numbers: root.numbers;
                index: ws.index;
                active: ws.active;
                urgent: ws.urgent;
                occupied: ws.windows > 0;
                id: ws.id;
                clicked => {
                    UI.close-popup();
                    Workspaces.focus(ws.id);
                }
            }
        }
    }
    row := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        if !root.vertical: HorizontalLayout {
            spacing: 2px;
            for ws in Workspaces.all: WorkspaceDot {
                visible: ws.output == "" || ws.output == Shell.screen.name;
                vertical: false;
                numbers: root.numbers;
                index: ws.index;
                active: ws.active;
                urgent: ws.urgent;
                occupied: ws.windows > 0;
                id: ws.id;
                clicked => {
                    UI.close-popup();
                    Workspaces.focus(ws.id);
                }
            }
        }
    }
}

// Every window as an icon, like waybar's taskbar: click switches to it (and its workspace),
// a middle click closes it.
component TaskIcon inherits Rectangle {
    in property <WindowInfo> window;
    width: 28px;
    height: 24px;
    border-radius: 8px;
    background: root.window.focused ? Style.accent-soft : touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    if root.window.icon.width > 0: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.window.icon;
        image-fit: contain;
    }
    if root.window.icon.width == 0: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "window";
        width: 16px;
        height: 16px;
        color: root.window.focused ? Style.accent : Style.muted;
    }
    // The focused window is underlined.
    Rectangle {
        visible: root.window.focused;
        x: (parent.width - self.width) / 2;
        y: parent.height - 3px;
        width: 12px;
        height: 2px;
        border-radius: 1px;
        background: Style.accent;
    }
    touch := TouchArea {
        clicked => {
            UI.close-popup();
            Workspaces.focus-window(root.window.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.middle && event.kind == PointerEventKind.up {
                UI.close-popup();
                Workspaces.close-window(root.window.id);
            }
        }
    }
}

component Taskbar inherits Rectangle {
    in property <bool> vertical;
    width: root.vertical ? 32px : row.preferred-width;
    height: root.vertical ? column.preferred-height : 32px;
    column := VerticalLayout {
        padding: 4px;
        spacing: 2px;
        if root.vertical: VerticalLayout {
            spacing: 2px;
            for window in Workspaces.windows: TaskIcon { window: window; }
        }
    }
    row := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        if !root.vertical: HorizontalLayout {
            spacing: 2px;
            for window in Workspaces.windows: TaskIcon { window: window; }
        }
    }
}

// An icon in the status pill. `anchor` is where its popout should line up.
component StatusIcon inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> highlighted;
    in property <bool> badge;
    in property <color> tint: Style.text;
    out property <length> anchor: Style.bar-horizontal ? Style.bar-offset + self.absolute-position.x + self.width / 2 : Style.bar-offset + self.absolute-position.y + self.height / 2;
    callback clicked();
    callback right-clicked();
    callback scrolled(delta: length);

    width: Style.bar-horizontal ? max(30px, row.preferred-width + 16px) : 30px;
    height: Style.bar-horizontal ? 28px : (root.label != "" ? 44px : 30px);
    border-radius: 15px;
    background: root.highlighted ? Style.accent : touch.pressed ? Style.pressed : touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    property <color> ink: root.highlighted ? Style.accent-ink : root.tint;
    // Side bar: icon over a small label.
    if !Style.bar-horizontal: VerticalLayout {
        alignment: center;
        spacing: 1px;
        Rectangle {
            height: 18px;
            Icon { name: root.icon; width: 18px; height: 18px; color: root.ink; }
        }
        if root.label != "": Text {
            text: root.label;
            color: root.highlighted ? Style.accent-ink : Style.muted;
            font-size: 10px;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }
    // Top or bottom bar: icon beside the label.
    row := HorizontalLayout {
        alignment: center;
        spacing: 4px;
        if Style.bar-horizontal: Rectangle {
            width: 18px;
            Icon { name: root.icon; width: 18px; height: 18px; color: root.ink; }
        }
        if Style.bar-horizontal && root.label != "": Text {
            text: root.label;
            max-width: 110px;
            overflow: elide;
            color: root.highlighted ? Style.accent-ink : Style.text;
            font-size: Style.font-small;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    if root.badge: Rectangle {
        x: parent.width / 2 + 4px;
        y: (parent.height - 18px) / 2 - 1px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Style.danger;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.right-clicked();
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y);
            accept
        }
    }
}

component ClipboardStatus inherits StatusIcon {
    icon: "clipboard";
    highlighted: UI.popup == "clipboard";
    clicked => { UI.toggle-popup-at("clipboard", self.anchor); }
}

component NetworkStatus inherits StatusIcon {
    icon: !Network.connected ? "wifi-off" : Network.kind == "wifi" ? "wifi" : "ethernet";
    // The network's name beside the icon in a top or bottom bar.
    label: Style.bar-horizontal && Network.connected && Network.kind == "wifi" ? Network.name : "";
    tint: Network.online ? Style.text : Style.warning;
    highlighted: UI.popup == "network";
    clicked => { UI.toggle-popup-at("network", self.anchor); }
}

component BluetoothStatus inherits StatusIcon {
    icon: "bluetooth";
    badge: Bluetooth.connected-count > 0;
    clicked => { UI.toggle-popup-at("network", self.anchor); }
}

component AudioStatus inherits StatusIcon {
    icon: Audio.output.muted ? "volume-mute" : Audio.output.volume < 0.4 ? "volume-low" : "volume";
    label: Style.bar-horizontal && !Audio.output.muted ? Math.round(Audio.output.volume * 100) + "%" : "";
    highlighted: UI.popup == "audio";
    clicked => { UI.toggle-popup-at("audio", self.anchor); }
    right-clicked => { Audio.toggle-muted(); }
    scrolled(delta) => {
        Audio.set-volume(clamp(Audio.output.volume + (delta > 0 ? 0.05 : -0.05), 0, 1.5));
    }
}

component BatteryStatus inherits StatusIcon {
    icon: Battery.charging ? "battery-charging" : "battery";
    label: Math.round(Battery.level * 100) + (Style.bar-horizontal ? "%" : "");
    tint: Battery.level < 0.15 && !Battery.charging ? Style.danger : Style.text;
    clicked => { UI.open-dashboard(2); }
}

component NotificationStatus inherits StatusIcon {
    icon: Notifications.do-not-disturb ? "bell-off" : "bell";
    badge: !Style.bar-horizontal && Notifications.count > 0;
    label: Style.bar-horizontal && Notifications.count > 0 ? Notifications.count : "";
    highlighted: UI.overlay == "dashboard" && UI.dashboard-tab == 3;
    clicked => { UI.open-dashboard(3); }
    right-clicked => { Notifications.set-do-not-disturb(!Notifications.do-not-disturb); }
}

// The system status icons side by side.
component StatusPill inherits Rectangle {
    in property <bool> vertical;
    out property <length> anchor: root.vertical ? Style.bar-offset + self.absolute-position.y + self.height / 2 : Style.bar-offset + self.absolute-position.x + self.width / 2;
    width: root.vertical ? 36px : row.preferred-width;
    height: root.vertical ? column.preferred-height : 36px;
    column := VerticalLayout {
        padding: 3px;
        spacing: 2px;
        if root.vertical && ClipboardHistory.available: ClipboardStatus { }
        if root.vertical && Network.available: NetworkStatus { }
        if root.vertical && Bluetooth.available && Bluetooth.powered: BluetoothStatus { }
        if root.vertical && Audio.available: AudioStatus { }
        if root.vertical && Battery.available: BatteryStatus { }
        if root.vertical: NotificationStatus { }
    }
    row := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        if !root.vertical && ClipboardHistory.available: ClipboardStatus { }
        if !root.vertical && Network.available: NetworkStatus { }
        if !root.vertical && Bluetooth.available && Bluetooth.powered: BluetoothStatus { }
        if !root.vertical && Audio.available: AudioStatus { }
        if !root.vertical && Battery.available: BatteryStatus { }
        if !root.vertical: NotificationStatus { }
    }
}

// The LunaDash logo: the launcher (right-click: the dashboard). The mark alone — the app
// icon's tile would turn into a dark smudge at bar size — in the accent over a soft halo that
// brightens on hover; on a tonal disc, in its ink, while the launcher is open.
component LunaButton inherits Rectangle {
    property <bool> open: UI.overlay == "launcher";
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: root.open ? Style.tonal : luna.pressed ? Style.pressed : transparent;
    animate background { duration: Style.motion-fast; }
    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 17px;
        opacity: root.open ? 0 : luna.has-hover ? 1 : 0.4;
        background: @radial-gradient(circle, Style.accent.with-alpha(0.45) 0%, Style.accent.with-alpha(0.12) 45%, transparent 70%);
        animate opacity { duration: Style.motion-fast; }
    }
    Image {
        width: luna.pressed ? 20px : luna.has-hover ? 27px : 25px;
        height: self.width;
        source: @image-url("../assets/luna-mark.svg");
        image-fit: contain;
        // Tinted like the rest of the bar, so it follows the theme's colours.
        colorize: root.open ? Style.on-tonal : Style.accent;
        animate width { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
        animate colorize { duration: Style.motion-fast; }
    }
    luna := TouchArea {
        clicked => { UI.toggle-overlay("launcher"); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                UI.toggle-overlay("dashboard");
            }
        }
    }
}

// What is playing: cover art, title and artist, and play / pause. Opens the media tab.
component MediaChip inherits Rectangle {
    property <MediaPlayerInfo> player: Media.player;
    width: row.preferred-width;
    height: 36px;
    border-radius: 18px;
    background: touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    touch := TouchArea { clicked => { UI.open-dashboard(1); } }
    row := HorizontalLayout {
        padding: 4px;
        padding-right: 6px;
        spacing: 8px;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: Style.tonal;
            cover := Picture { path: root.player.art-url; radii: [14px, 14px, 14px, 14px]; }
            if !cover.loaded: Icon { name: "music"; width: 15px; height: 15px; color: Style.on-tonal; }
        }
        VerticalLayout {
            alignment: center;
            max-width: 220px;
            Text {
                text: root.player.title != "" ? root.player.title : root.player.identity;
                color: Style.text;
                font-size: Style.font-small;
                font-weight: 500;
                overflow: elide;
            }
            if root.player.artist != "": Text {
                text: root.player.artist;
                color: Style.muted;
                font-size: 10px;
                overflow: elide;
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: root.player.playing ? "pause" : "play";
            size: 26px;
            icon-size: 14px;
            active: root.player.playing;
            clicked => {
                UI.close-popup();
                Media.play-pause();
            }
        }
    }
}

// Processor and memory use as two small meters. Opens the performance tab.
// One reading as the bar shows it: a coloured disc with its icon, and the value.
component Reading inherits HorizontalLayout {
    in property <string> icon;
    in property <string> value;
    in property <color> tint;
    in property <color> ink;
    spacing: 6px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: root.tint;
        animate background { duration: Style.motion-fast; }
        Icon { name: root.icon; width: 14px; height: 14px; color: root.ink; }
    }
    Text {
        text: root.value;
        color: Style.text;
        font-size: Style.font-small;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// Processor, memory and temperature as readings in the colour chosen in Settings, together on
// the item's island or each on a pill of its own (Prefs.usage-layout). A busy one turns red.
component UsageChip inherits Rectangle {
    property <bool> apart: Prefs.usage-layout == "apart";
    property <color> tint: Style.tint(Prefs.usage-color);
    property <color> ink: Style.on-tint(Prefs.usage-color);
    property <[{icon: string, value: string, busy: bool}]> readings: [
        { icon: "cpu", value: Math.round(System.cpu * 100) + "%", busy: System.cpu > 0.85 },
        { icon: "memory", value: Math.round(System.memory * 100) + "%", busy: System.memory > 0.85 },
        { icon: "thermometer", value: System.temperature > 0 ? Math.round(System.temperature) + "°C" : "", busy: System.temperature > 85 },
    ];
    width: row.preferred-width;
    height: root.apart ? Style.island : 36px;
    border-radius: self.height / 2;
    background: !root.apart && touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    touch := TouchArea { clicked => { UI.open-dashboard(2); } }
    row := HorizontalLayout {
        padding-left: root.apart ? 0px : 8px;
        padding-right: root.apart ? 0px : 12px;
        spacing: root.apart ? PanelLayout.spacing : 12px;
        for reading in root.readings: Rectangle {
            visible: reading.value != "";
            width: self.visible ? pill.preferred-width : 0px;
            border-radius: self.height / 2;
            background: root.apart ? (touch.has-hover ? Style.panel.mix(Style.hover, 0.5) : Style.panel) : transparent;
            pill := HorizontalLayout {
                padding-left: root.apart ? 6px : 0px;
                padding-right: root.apart ? 12px : 0px;
                Reading {
                    icon: reading.icon;
                    value: reading.value;
                    tint: reading.busy ? Style.danger : root.tint;
                    ink: reading.busy ? Style.base : root.ink;
                }
            }
        }
    }
}

// The focused window: its application's icon and title (turned to run down a side bar).
component WindowTitle inherits Rectangle {
    in property <bool> vertical;
    property <AppInfo> app: Apps.get(Workspaces.focused-window.app-id + ".desktop");
    property <bool> has-title: Workspaces.focused-window.title != "";
    // Along a top or bottom bar: a pill of its own hugging the icon and the title, at most as
    // wide as the free space.
    if root.has-title && !root.vertical: Rectangle {
        width: min(parent.width, line.preferred-width);
        height: Style.island;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: Style.panel;
        line := HorizontalLayout {
            padding-left: 12px;
            padding-right: 16px;
            spacing: 8px;
            if Workspaces.focused-window.icon.width > 0: Image {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                source: Workspaces.focused-window.icon;
                image-fit: contain;
            }
            if Workspaces.focused-window.icon.width == 0: Icon {
                y: (parent.height - self.height) / 2;
                name: "window";
                width: 16px;
                height: 16px;
                color: Style.accent;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.app.name != "" ? root.app.name : Workspaces.focused-window.app-id;
                    color: Style.muted;
                    font-size: 10px;
                    overflow: elide;
                }
                Text {
                    text: Workspaces.focused-window.title;
                    color: Style.text;
                    font-size: Style.font-size;
                    font-weight: 500;
                    overflow: elide;
                }
            }
        }
    }
    // Down a side bar: the icon, and the title turned to run down the bar.
    if root.has-title && root.vertical && Workspaces.focused-window.icon.width > 0: Image {
        x: (parent.width - self.width) / 2;
        width: 18px;
        height: 18px;
        source: Workspaces.focused-window.icon;
        image-fit: contain;
    }
    if root.has-title && root.vertical && Workspaces.focused-window.icon.width == 0: Icon {
        x: (parent.width - self.width) / 2;
        name: "window";
        width: 16px;
        height: 16px;
        color: Style.accent;
    }
    if root.has-title && root.vertical: Rectangle {
        y: 28px;
        height: parent.height - self.y;
        clip: true;
        Text {
            // Laid out horizontally, then turned to run down the bar.
            width: parent.height;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            transform-rotation: 90deg;
            text: Workspaces.focused-window.title;
            color: Style.text;
            font-size: Style.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component TrayIcon inherits Rectangle {
    in property <string> id;
    in property <image> icon;
    in property <bool> is-menu;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: touch.has-hover ? Style.hover : transparent;
    property <length> anchor: Style.bar-horizontal ? Style.bar-offset + self.absolute-position.x + self.width / 2 : Style.bar-offset + self.absolute-position.y + self.height / 2;
    Image { source: root.icon; width: 18px; height: 18px; image-fit: contain; }
    touch := TouchArea {
        clicked => {
            if root.is-menu {
                UI.toggle-popup-at("tray", root.anchor);
                Tray.open-menu(root.id);
            } else {
                UI.close-popup();
                Tray.activate(root.id);
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                UI.toggle-popup-at("tray", root.anchor);
                Tray.open-menu(root.id);
            }
        }
        scroll-event(event) => {
            Tray.scroll(root.id, event.delta-y > 0 ? -1 : 1);
            accept
        }
    }
}

// The clock: hours over minutes in a side bar, one line (and the date) in a top or bottom bar.
component ClockItem inherits Rectangle {
    in property <bool> vertical;
    property <bool> open: UI.popup == "calendar";
    property <length> time-size: Style.font-size;
    property <bool> apart: Prefs.clock-layout == "apart" && !root.vertical;
    property <color> tint: Style.tint(Prefs.clock-color);
    property <color> ink: Style.on-tint(Prefs.clock-color);
    property <length> anchor: root.vertical ? Style.bar-offset + self.absolute-position.y + self.height / 2 : Style.bar-offset + self.absolute-position.x + self.width / 2;
    width: root.vertical ? 36px : line.preferred-width;
    height: root.vertical ? stack.preferred-height + 12px : root.apart ? Style.island : 36px;
    border-radius: 18px;
    background: root.vertical && root.open ? root.tint : !root.apart && !root.open && touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    stack := VerticalLayout {
        alignment: center;
        if root.vertical: Text {
            text: Prefs.clock-24h ? Time.two(Clock.hour) : Time.two(Math.mod(Clock.hour + 11, 12) + 1);
            color: root.open ? root.ink : root.tint;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        if root.vertical: Text {
            text: Time.two(Clock.minute);
            color: root.open ? root.ink : Style.text;
            font-size: 15px;
            font-weight: 500;
            horizontal-alignment: center;
        }
        if root.vertical && !Prefs.clock-24h: Text {
            text: Clock.hour < 12 ? "am" : "pm";
            color: root.open ? root.ink : Style.muted;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
    // The date, then the time on a pill in the clock's colour; on the item's island together,
    // or the date on a pill of its own (Prefs.clock-layout).
    line := HorizontalLayout {
        padding-left: root.apart ? 0px : 6px;
        padding-right: root.apart ? 0px : 5px;
        spacing: root.apart ? PanelLayout.spacing : 8px;
        if !root.vertical && Prefs.clock-date: Rectangle {
            width: date.preferred-width + (root.apart ? 28px : 8px);
            border-radius: self.height / 2;
            background: root.apart ? (touch.has-hover ? Style.panel.mix(Style.hover, 0.5) : Style.panel) : transparent;
            date := Text {
                text: Time.short-date;
                color: Style.text;
                font-size: Style.font-small;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if !root.vertical: Rectangle {
            y: (parent.height - self.height) / 2;
            width: time.preferred-width + 24px;
            height: root.apart ? parent.height : parent.height - 10px;
            border-radius: self.height / 2;
            background: root.open ? Style.text : root.tint;
            animate background { duration: Style.motion-fast; }
            time := Text {
                text: Time.clock;
                color: root.open ? Style.base : root.ink;
                font-size: root.time-size;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea { clicked => { UI.toggle-popup-at("calendar", root.anchor); } }
}

component SettingsButton inherits IconButton {
    icon: "settings";
    size: 30px;
    icon-size: 17px;
    active: UI.overlay == "settings";
    clicked => { UI.toggle-overlay("settings"); }
}

component WidgetsButton inherits IconButton {
    icon: "widgets";
    size: 30px;
    icon-size: 17px;
    clicked => { Widgets.edit(); }
}

component PowerButton inherits IconButton {
    icon: "power";
    size: 30px;
    icon-size: 17px;
    tint: UI.overlay == "power" ? Style.accent-ink : Style.danger;
    active: UI.overlay == "power";
    clicked => { UI.toggle-overlay("power"); }
}

// An application's launcher: its icon; a click starts it.
component AppButton inherits Rectangle {
    in property <string> app;
    // Mentioning Apps.all looks the application up again once the background scan has found it.
    property <AppInfo> info: Apps.all.length >= 0 ? Apps.get(root.app) : Apps.get(root.app);
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: touch.pressed ? Style.pressed : touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    if root.info.icon.width > 0: Image { width: 20px; height: 20px; source: root.info.icon; image-fit: contain; }
    if root.info.icon.width == 0: Icon { name: "apps"; width: 17px; height: 17px; color: Style.text; }
    touch := TouchArea {
        clicked => {
            UI.close-popup();
            Apps.launch(root.app);
        }
    }
}

// One of the user's commands: a terminal icon, and its name beside it in a top or bottom bar.
component CommandButton inherits Rectangle {
    in property <string> item;
    in property <bool> vertical;
    property <string> label: PanelLayout.command-label(root.item);
    property <bool> compact: root.vertical || root.label == "";
    width: root.compact ? 30px : row.preferred-width;
    height: 30px;
    border-radius: 15px;
    background: touch.pressed ? Style.pressed : touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    if root.compact: Icon { name: "terminal"; width: 17px; height: 17px; color: Style.text; }
    row := HorizontalLayout {
        padding-left: 9px;
        padding-right: 12px;
        spacing: 6px;
        if !root.compact: Icon { y: (parent.height - self.height) / 2; name: "terminal"; width: 16px; height: 16px; color: Style.text; }
        if !root.compact: Text {
            text: root.label;
            max-width: 160px;
            color: Style.text;
            font-size: Style.font-small;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        clicked => {
            UI.close-popup();
            PanelLayout.activate(root.item);
        }
    }
}

// One item of the bar (see PanelLayout), centred across it, with half the bar's spacing on
// either side. Items with nothing to show (no windows for the taskbar, no tray icons …) take no
// room; the window title and spacers take the free space.
export component BarItem inherits Rectangle {
    in property <string> id;
    // Its place in PanelLayout.entries.
    in property <int> index;
    in property <bool> vertical;
    // The status pill moved: where the clipboard popout lines up when a shortcut opens it.
    callback status-moved(anchor: length);
    // Arranging (panel/editor.slint): the editor's copy of the bar shows every item, the empty
    // ones and the spacers too, and lets them be dragged along it and taken out. `dragged` is
    // the item in hand (-1: none) and `pointer` where it is along the bar; `target` is where it
    // would land, which the editor works out from `counted`: each other item reports when the
    // pointer passes its middle.
    in property <bool> editing;
    in property <int> dragged: -1;
    in property <length> pointer;
    in property <int> target;
    callback grabbed(centre: length);
    callback dragged-by(delta: length);
    callback dropped();
    callback counted(change: int);
    property <length> centre: root.vertical ? self.y + self.height / 2 : self.x + self.width / 2;
    property <bool> passed: root.editing && root.dragged >= 0 && root.dragged != root.index && root.centre < root.pointer;
    changed passed => { root.counted(self.passed ? 1 : -1); }
    // Its place among the items other than the one in hand.
    property <int> rank: root.dragged >= 0 && root.index > root.dragged ? root.index - 1 : root.index;
    property <bool> in-hand: root.editing && root.dragged == root.index;
    property <length> placeholder: root.editing && root.extent == 0 ? 40px : 0px;
    z: root.in-hand ? 1 : 0;
    property <bool> grows: PanelLayout.stretches(root.id);
    property <length> extent: root.vertical ? box.preferred-height : box.preferred-width;
    // Its piece of an island: joined to the neighbours that share it, rounded where the island
    // starts or ends, with a little room inside those ends.
    property <bool> island: PanelLayout.has-island(root.id) && root.extent > 0;
    property <bool> joins-before: PanelLayout.joins(root.index, -1, root.vertical);
    property <bool> joins-after: PanelLayout.joins(root.index, 1, root.vertical);
    property <length> start-room: root.island && !root.joins-before ? Style.island-end : 0px;
    property <length> end-room: root.island && !root.joins-after ? Style.island-end : 0px;
    property <length> length: root.extent > 0 ? root.extent + PanelLayout.spacing + root.start-room + root.end-room
        : root.placeholder > 0 ? root.placeholder + PanelLayout.spacing : 0px;
    property <length> least: root.grows ? root.placeholder + (root.placeholder > 0 ? PanelLayout.spacing : 0px) : root.length;
    min-width: root.vertical ? Style.bar-width : root.least;
    max-width: root.vertical ? Style.bar-width : root.grows ? 100000px : root.length;
    min-height: !root.vertical ? Style.bar-width : root.least;
    max-height: !root.vertical ? Style.bar-width : root.grows ? 100000px : root.length;
    horizontal-stretch: !root.vertical && root.grows ? 1 : 0;
    vertical-stretch: root.vertical && root.grows ? 1 : 0;

    // Half the spacing on an island's open ends is the gap to the next island.
    property <length> before: root.joins-before ? 0px : PanelLayout.spacing / 2;
    property <length> after: root.joins-after ? 0px : PanelLayout.spacing / 2;
    face := Rectangle {
        x: root.in-hand && !root.vertical ? root.pointer - root.centre : 0px;
        y: root.in-hand && root.vertical ? root.pointer - root.centre : 0px;
        width: parent.width;
        height: parent.height;
        if root.island: Rectangle {
            x: root.vertical ? (parent.width - Style.island) / 2 : root.before;
            y: root.vertical ? root.before : (parent.height - Style.island) / 2;
            width: root.vertical ? Style.island : parent.width - root.before - root.after;
            height: root.vertical ? parent.height - root.before - root.after : Style.island;
            background: Style.panel;
            border-top-left-radius: root.joins-before ? 0px : Style.island / 2;
            border-top-right-radius: (root.vertical ? root.joins-before : root.joins-after) ? 0px : Style.island / 2;
            border-bottom-left-radius: (root.vertical ? root.joins-after : root.joins-before) ? 0px : Style.island / 2;
            border-bottom-right-radius: root.joins-after ? 0px : Style.island / 2;
        }
        if root.id == "title": WindowTitle {
            x: root.vertical ? 0px : PanelLayout.spacing / 2;
            y: root.vertical ? PanelLayout.spacing / 2 : 0px;
            width: parent.width - (root.vertical ? 0px : PanelLayout.spacing);
            height: parent.height - (root.vertical ? PanelLayout.spacing : 0px);
            vertical: root.vertical;
        }
        box := HorizontalLayout {
            x: (parent.width - self.width) / 2 + (root.vertical ? 0px : (root.start-room - root.end-room) / 2);
            y: (parent.height - self.height) / 2 + (root.vertical ? (root.start-room - root.end-room) / 2 : 0px);
            width: self.preferred-width;
            height: self.preferred-height;
            if root.id == "launcher": LunaButton { }
            if root.id == "workspaces" && PanelLayout.shows(root.id, root.vertical): Workspaces-Strip { vertical: root.vertical; }
            if root.id == "taskbar" && PanelLayout.shows(root.id, root.vertical): Taskbar { vertical: root.vertical; }
            if root.id == "media" && PanelLayout.shows(root.id, root.vertical): MediaChip { }
            if root.id == "usage" && PanelLayout.shows(root.id, root.vertical): UsageChip { }
            if root.id == "tray" && !root.vertical: HorizontalLayout {
                spacing: 2px;
                for item in Tray.items: TrayIcon { visible: item.status != "passive"; id: item.id; icon: item.icon; is-menu: item.item-is-menu; }
            }
            if root.id == "tray" && root.vertical: VerticalLayout {
                spacing: 2px;
                for item in Tray.items: TrayIcon { visible: item.status != "passive"; id: item.id; icon: item.icon; is-menu: item.item-is-menu; }
            }
            if root.id == "clock": ClockItem { vertical: root.vertical; }
            if root.id == "status": StatusPill {
                vertical: root.vertical;
                changed anchor => { root.status-moved(self.anchor); }
            }
            if root.id == "widgets": WidgetsButton { }
            if root.id == "settings": SettingsButton { }
            if root.id == "power": PowerButton { }
            // A gap between islands.
            if root.id == "separator": Rectangle {
                width: 4px;
                height: 4px;
            }
            if PanelLayout.is-app(root.id): AppButton { app: PanelLayout.app-id(root.id); }
            if PanelLayout.is-command(root.id): CommandButton { item: root.id; vertical: root.vertical; }
        }
        // An empty item or a spacer while arranging.
        if root.placeholder > 0 || (root.editing && root.grows && root.extent == 0): Rectangle {
            x: root.vertical ? (parent.width - self.width) / 2 : PanelLayout.spacing / 2;
            y: root.vertical ? PanelLayout.spacing / 2 : (parent.height - self.height) / 2;
            width: root.vertical ? Style.island : parent.width - PanelLayout.spacing;
            height: root.vertical ? parent.height - PanelLayout.spacing : Style.island;
            border-radius: Style.island / 2;
            border-width: 1px;
            border-color: Style.text.with-alpha(0.35);
            background: Style.panel.with-alpha(0.5);
            Icon { name: PanelLayout.icon(root.id); width: 16px; height: 16px; color: Style.muted; }
        }
    }
    // Where the item in hand would land: a bar before this one (after the last).
    property <bool> lands-before: root.dragged >= 0 && !root.in-hand && root.rank == root.target;
    property <bool> lands-after: root.dragged >= 0 && !root.in-hand && root.target == PanelLayout.entries.length - 1
        && root.rank == PanelLayout.entries.length - 2;
    if root.editing: Rectangle {
        x: face.x;
        y: face.y;
        if root.lands-before || root.lands-after: Rectangle {
            x: root.vertical ? (parent.width - self.width) / 2 : root.lands-before ? -2px : parent.width - 2px;
            y: !root.vertical ? (parent.height - self.height) / 2 : root.lands-before ? -2px : parent.height - 2px;
            width: root.vertical ? Style.island : 4px;
            height: root.vertical ? 4px : Style.island;
            border-radius: 2px;
            background: Style.accent;
        }
        if root.in-hand || hold.has-hover: Rectangle {
            x: root.vertical ? (parent.width - self.width) / 2 : PanelLayout.spacing / 2 - 2px;
            y: root.vertical ? PanelLayout.spacing / 2 - 2px : (parent.height - self.height) / 2;
            width: root.vertical ? Style.island + 4px : parent.width - PanelLayout.spacing + 4px;
            height: root.vertical ? parent.height - PanelLayout.spacing + 4px : Style.island + 4px;
            border-radius: self.height / 2;
            border-width: 2px;
            border-color: Style.accent;
        }
        hold := TouchArea {
            mouse-cursor: root.in-hand ? MouseCursor.grabbing : MouseCursor.grab;
            pointer-event(event) => {
                if event.button != PointerEventButton.left {
                    return;
                }
                if event.kind == PointerEventKind.down {
                    root.grabbed(root.centre);
                } else if event.kind == PointerEventKind.up {
                    root.dropped();
                }
            }
            moved => { root.dragged-by(root.vertical ? self.mouse-y - self.pressed-y : self.mouse-x - self.pressed-x); }
        }
        Rectangle {
            visible: !root.in-hand && (hold.has-hover || remove.has-hover);
            x: parent.width - self.width - PanelLayout.spacing / 2;
            y: root.vertical ? PanelLayout.spacing / 2 : (parent.height - Style.island) / 2 - 6px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Style.danger;
            Icon { name: "close"; width: 12px; height: 12px; color: Style.base; }
            remove := TouchArea { clicked => { PanelLayout.remove(root.index); } }
        }
    }
}
// What both bars share: a transparent strip along the edge carrying the islands, the shell-wide
// startup work and the compositor's keyboard shortcuts. Only the bar in use (`active`) acts on
// them.
component BarWindow inherits PanelWindow {
    in property <bool> active;
    // Where the clipboard popout lines up when a shortcut opens it.
    in-out property <length> status-anchor;
    // The islands keep the same distance from the screen's ends as from its edge, less the
    // half spacing the end items bring.
    out property <length> end-padding: max(0px, (Style.bar-width - Style.island) / 2 - PanelLayout.spacing / 2);
    namespace: "lunadash-bar";
    exclusive-mode: ExclusiveMode.ignore;
    // The bar editor shows a copy of it to arrange.
    shown: root.active && UI.overlay != "bar-editor";
    default-font-family: Style.font;

    property <int> request-serial: Compositor.request-serial;
    changed request-serial => {
        if !UI.primary || !root.active {
            return;
        }
        if Compositor.request == "launcher" || Compositor.request == "orbit-launcher" {
            if Compositor.request-argument == "false" {
                UI.close-all();
            } else {
                UI.toggle-overlay("launcher");
            }
        } else if Compositor.request == "settings" {
            UI.open-settings(Compositor.request-argument == "" ? "appearance" : Compositor.request-argument);
        } else if Compositor.request == "wallpaper-picker" {
            UI.toggle-overlay("wallpapers");
        } else if Compositor.request == "control-center" {
            UI.toggle-overlay("dashboard");
        } else if Compositor.request == "clipboard" {
            UI.toggle-popup-at("clipboard", root.status-anchor);
        } else if Compositor.request == "power-menu" {
            UI.toggle-overlay("power");
        } else if Compositor.request == "screencast" {
            // The argument is where lunadash-screencast-chooser waits for the answer.
            Shared.set-string("screencast-reply", Compositor.request-argument);
            UI.open-overlay("screencast");
        } else if Compositor.request == "welcome" {
            // `lunadashctl setup` (setup again) and the demo session.
            UI.open-overlay("welcome");
        }
    }

    ready => {
        // Shell-wide settings are applied once, from the primary screen. Both bars exist (one
        // hidden), so only the one in use does it.
        if UI.primary && root.active {
            Apply.all();
            // The first run, on every compositor: on LunaDash closing it also finishes
            // the desktop's setup (Welcome).
            if !Prefs.welcome-done {
                UI.open-overlay("welcome");
            }
        }
    }

    // Clicking the bar between its islands closes a popout; right-clicking arranges the bar.
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                UI.close-popup();
            } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                PanelLayout.arrange();
            }
        }
    }
    @children
}

// Along the top edge (the default) or the bottom one.
export component Bar inherits BarWindow {
    active: Style.bar-horizontal;
    anchor-top: Style.bar-edge == "top";
    anchor-bottom: Style.bar-edge == "bottom";
    anchor-left: true;
    anchor-right: true;
    margin-left: Style.bar-offset;
    margin-right: Style.bar-offset;
    preferred-height: Style.bar-width;

    HorizontalLayout {
        padding-left: root.end-padding;
        padding-right: root.end-padding;
        alignment: stretch;
        for id[i] in PanelLayout.entries: BarItem {
            id: id;
            index: i;
            vertical: false;
            status-moved(anchor) => { root.status-anchor = anchor; }
        }
    }
}

// Down the left edge or the right one.
export component SideBar inherits BarWindow {
    namespace: "lunadash-sidebar";
    active: !Style.bar-horizontal;
    anchor-top: true;
    anchor-bottom: true;
    anchor-left: Style.bar-edge == "left";
    anchor-right: Style.bar-edge == "right";
    margin-top: Style.bar-offset;
    margin-bottom: Style.bar-offset;
    preferred-width: Style.bar-width;

    VerticalLayout {
        padding-top: root.end-padding;
        padding-bottom: root.end-padding;
        alignment: stretch;
        for id[i] in PanelLayout.entries: BarItem {
            id: id;
            index: i;
            vertical: true;
            status-moved(anchor) => { root.status-anchor = anchor; }
        }
    }
}
