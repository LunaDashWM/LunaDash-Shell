// What the screen edges hold besides the bar: the space kept clear of windows, and the top
// edge that opens the dashboard.
//
// The bar and the other panels ignore exclusive zones and are placed from the screen edges:
// compositors arrange surfaces that reserve space one after another, each inside what the
// earlier ones left, so reserving panels would shift each other around. The space is reserved
// instead by invisible one-pixel surfaces on the background layer, one per edge.

import { PanelWindow, Layer, ExclusiveMode } from "@slintlu";
import { Style } from "../style/style.slint";
import { UI } from "../state/ui.slint";

// Keeps windows clear of one edge by `zone`.
component Reserve inherits PanelWindow {
    in property <length> zone;
    namespace: "lunadash-reserve";
    layer: Layer.background;
    exclusive-mode: ExclusiveMode.fixed;
    exclusive-zone: root.zone;
    shown: root.zone > 0;
    preferred-width: 1px;
    preferred-height: 1px;
}

export component ReserveTop inherits Reserve {
    anchor-top: true;
    anchor-left: true;
    anchor-right: true;
    zone: Style.inner-top;
}

export component ReserveLeft inherits Reserve {
    anchor-left: true;
    anchor-top: true;
    anchor-bottom: true;
    zone: Style.inner-left;
}

export component ReserveRight inherits Reserve {
    anchor-right: true;
    anchor-top: true;
    anchor-bottom: true;
    zone: Style.inner-right;
}

export component ReserveBottom inherits Reserve {
    anchor-bottom: true;
    anchor-left: true;
    anchor-right: true;
    // Windows keep clear of the dock too.
    zone: Style.inner-bottom + Style.dock-reserve;
}

// Resting the pointer on the middle of the top edge opens the dashboard, which slides in from
// there (when the bar is elsewhere).
export component TopEdge inherits PanelWindow {
    namespace: "lunadash-edge";
    layer: Layer.top;
    exclusive-mode: ExclusiveMode.ignore;
    anchor-top: true;
    preferred-width: 520px;
    preferred-height: 2px;
    shown: Style.bar-edge != "top";
    hot := TouchArea { }
    Timer {
        interval: 250ms;
        running: hot.has-hover && UI.overlay == "";
        triggered => {
            self.running = false;
            UI.open-overlay("dashboard");
        }
    }
}
