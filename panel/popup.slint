// Base for the bar's popouts, and the transparent layer that closes them on outside clicks.

import { PanelWindow, Layer, KeyboardMode, ExclusiveMode } from "@slintlu";
import { Style } from "../style/style.slint";
import { UI } from "../state/ui.slint";
import { Drawer } from "../components/shape.slint";

// A popout: a floating card that slides out from the bar beside the item that opened it (see
// UI.toggle-popup-at). Set `name` to the UI.popup value that opens it and `preferred-width` to
// its width.
export component PanelPopup inherits PanelWindow {
    in property <string> name;
    layer: Layer.overlay;
    keyboard-mode: KeyboardMode.on-demand;
    exclusive-mode: ExclusiveMode.ignore;
    // A band along the bar (the screen beside a top or bottom bar, a column beside a side
    // bar); only the drawer in it is painted.
    anchor-top: true;
    anchor-bottom: true;
    anchor-left: Style.bar-edge != "right";
    anchor-right: Style.bar-horizontal || Style.bar-edge == "right";
    margin-top: Style.bar-edge == "top" ? Style.bar-width : 0px;
    margin-bottom: Style.bar-edge == "bottom" ? Style.bar-width : 0px;
    margin-left: Style.bar-edge == "left" ? Style.bar-width : 0px;
    margin-right: Style.bar-edge == "right" ? Style.bar-width : 0px;
    shown: UI.popup == root.name && UI.on-active-screen;
    default-font-family: Style.font;

    // Set by each popout; the band is as wide as the screen beside a top or bottom bar.
    property <length> body-width: root.preferred-width;
    property <float> entrance: 0;
    animate entrance { duration: Style.motion; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
    changed shown => { root.entrance = self.shown ? 1 : 0; }
    init => { root.entrance = self.shown ? 1 : 0; }

    property <length> body-height: min(content.preferred-height, root.height - 2 * Style.edge-gap);
    // Centred on the item, kept on the screen.
    property <length> body-x: clamp(UI.popup-pos * 1px - root.body-width / 2, Style.edge-gap,
        root.width - Style.edge-gap - root.body-width);
    property <length> body-y: clamp(UI.popup-pos * 1px - root.body-height / 2, Style.edge-gap,
        root.height - Style.edge-gap - root.body-height);
    // How far it travels from the bar as it comes in.
    property <length> travel: 24px;

    // The empty rest of the band closes the popout like the dismisser beside it.
    TouchArea { clicked => { UI.close-all(); } }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                UI.close-all();
                return accept;
            }
            reject
        }
        Drawer {
            x: Style.bar-horizontal ? root.body-x
                : Style.bar-edge == "left" ? Style.edge-gap - (1 - root.entrance) * root.travel
                : root.width - self.width - Style.edge-gap + (1 - root.entrance) * root.travel;
            y: !Style.bar-horizontal ? root.body-y
                : Style.bar-edge == "top" ? Style.edge-gap - (1 - root.entrance) * root.travel
                : root.height - self.height - Style.edge-gap + (1 - root.entrance) * root.travel;
            opacity: root.entrance;
            body-width: root.body-width;
            body-height: root.body-height;
            TouchArea { }
            content := VerticalLayout {
                padding: Style.spacing-xl;
                spacing: Style.spacing-md;
                @children
            }
        }
    }
}

// Covers the screen beside the bar while a popout is open, on every screen (the popout's own
// band covers its screen); a click closes the popout.
export component PopupDismisser inherits PanelWindow {
    namespace: "lunadash-dismiss";
    layer: Layer.top;
    exclusive-mode: ExclusiveMode.ignore;
    anchor-top: true;
    anchor-bottom: true;
    anchor-left: true;
    anchor-right: true;
    margin-top: Style.bar-edge == "top" ? Style.bar-width : 0px;
    margin-bottom: Style.bar-edge == "bottom" ? Style.bar-width : 0px;
    margin-left: Style.bar-edge == "left" ? Style.bar-width : 0px;
    margin-right: Style.bar-edge == "right" ? Style.bar-width : 0px;
    shown: UI.popup != "";
    TouchArea { clicked => { UI.close-all(); } }
}
