// Network connection and Bluetooth devices.

import { Network, Bluetooth, WifiNetwork } from "@slintlu";
import { UI } from "../state/ui.slint";
import { Icon } from "../components/icon.slint";
import { Style } from "../style/style.slint";
import { PanelPopup } from "popup.slint";
import { QuickToggle, SectionTitle, ListRow, TextButton, TextField, IconButton } from "../components/controls.slint";

export component NetworkPopup inherits PanelPopup {
    name: "network";
    namespace: "lunadash-network";
    preferred-width: 360px;

    // The network whose password is asked for, or "".
    property <string> asking;
    // Clicking a network: the connected one disconnects, a secured new one asks for its
    // password, the rest connect.
    function choose(network: WifiNetwork) {
        if network.active {
            Network.disconnect-wifi();
        } else if network.secure && !network.known {
            root.asking = root.asking == network.ssid ? "" : network.ssid;
        } else {
            root.join(network.ssid, "");
        }
    }
    function join(ssid: string, password: string) {
        root.asking = "";
        Network.connect-wifi(ssid, password);
    }
    // The list is fresh while the popup shows: scanned on opening, then every 15 s.
    property <bool> showing: UI.popup == root.name && UI.on-active-screen && Network.wifi-enabled;
    changed showing => {
        if self.showing {
            Network.scan();
        } else {
            root.asking = "";
        }
    }
    Timer { interval: 15s; running: root.showing; triggered => { Network.scan(); } }

    SectionTitle { text: @tr("NETWORK"); }
    if !Network.available: Text { text: @tr("NetworkManager is not running."); color: Style.muted; wrap: word-wrap; }
    if Network.available: VerticalLayout {
        spacing: 8px;
        ListRow {
            icon: !Network.connected ? "wifi-off" : Network.kind == "wifi" ? "wifi" : "ethernet";
            title: Network.connected ? Network.name : @tr("Not connected");
            subtitle: !Network.connected ? "" : Network.online ? (Network.kind == "wifi" ? @tr("Connected · signal {}%", Math.round(Network.strength * 100)) : @tr("Connected"))
                : @tr("Connected without internet access");
        }
        QuickToggle {
            icon: Network.wifi-enabled ? "wifi" : "wifi-off";
            label: @tr("Wi-Fi");
            detail: Network.wifi-enabled ? @tr("On") : @tr("Off");
            on: Network.wifi-enabled;
            clicked => { Network.set-wifi-enabled(!Network.wifi-enabled); }
        }
        if Network.wifi-enabled: VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Network.scanning ? @tr("Looking for networks…") : @tr("Wi-Fi networks");
                    color: Style.muted;
                    font-size: Style.font-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton { icon: "reboot"; size: 26px; clicked => { Network.scan(); } }
            }
            for network in Network.networks: VerticalLayout {
                ListRow {
                    icon: "wifi";
                    title: network.ssid;
                    subtitle: (Network.connecting == network.ssid ? @tr("Connecting…")
                        : network.active ? @tr("Connected") : network.known ? @tr("Saved")
                        : network.secure ? @tr("Secured") : @tr("Open"))
                        + " · " + Math.round(network.strength * 100) + "%";
                    selected: network.active;
                    clicked => { root.choose(network); }
                    if network.secure: Icon {
                        name: "lock";
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        color: Style.muted;
                    }
                }
                // A secured network without a saved connection asks for its password here.
                if root.asking == network.ssid: HorizontalLayout {
                    padding-left: 10px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    password := TextField {
                        horizontal-stretch: 1;
                        password: true;
                        placeholder: @tr("Password");
                        icon: "lock";
                        accepted => { root.join(network.ssid, self.text); }
                    }
                    TextButton {
                        text: @tr("Connect");
                        primary: true;
                        enabled: password.text != "";
                        clicked => { root.join(network.ssid, password.text); }
                    }
                }
            }
            if !Network.scanning && Network.networks.length == 0: Text {
                text: @tr("No Wi-Fi networks found.");
                color: Style.muted;
                font-size: Style.font-small;
            }
            if Network.error != "": Text {
                text: Network.error;
                color: Style.danger;
                font-size: Style.font-small;
                wrap: word-wrap;
            }
        }
    }
    SectionTitle { text: @tr("BLUETOOTH"); }
    if !Bluetooth.available: Text { text: @tr("Bluetooth is off or not available."); color: Style.muted; wrap: word-wrap; }
    if Bluetooth.available: VerticalLayout {
        spacing: 6px;
        QuickToggle {
            icon: "bluetooth";
            label: @tr("Bluetooth");
            detail: !Bluetooth.powered ? @tr("Off") : Bluetooth.connected-count > 0 ? @tr("{} connected", Bluetooth.connected-count) : @tr("On");
            on: Bluetooth.powered;
            clicked => { Bluetooth.set-powered(!Bluetooth.powered); }
        }
        if Bluetooth.powered: VerticalLayout {
            for device in Bluetooth.devices: ListRow {
                icon: "bluetooth";
                title: device.name;
                subtitle: (device.connected ? @tr("Connected") : @tr("Paired")) + (device.battery >= 0 ? " · " + Math.round(device.battery * 100) + "%" : "");
                selected: device.connected;
                clicked => {
                    if device.connected { Bluetooth.disconnect(device.path); } else { Bluetooth.connect(device.path); }
                }
            }
        }
    }
}
