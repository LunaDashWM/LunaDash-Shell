// The top panel: workspaces and power on the left, LunaDash in the middle, clock and system
// status on the right — capsules floating over the wallpaper.

import { PanelWindow, Shell, Workspaces, Switcher, Audio, Network, Bluetooth, Battery, Notifications, Tray, Compositor, ClipboardHistory } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { UI } from "../state/ui.slint";
import { Time } from "../state/time.slint";
import { Apply } from "../state/apply.slint";
import { Icon } from "../components/icon.slint";
import { Pill, IconButton } from "../components/controls.slint";

component WorkspaceDots inherits HorizontalLayout {
    property <bool> numbers: Prefs.workspace-style == "numbers";
    spacing: root.numbers ? 4px : 6px;
    alignment: center;
    for ws in Workspaces.all: Rectangle {
        // Only this screen's workspaces; every workspace when the compositor has one output name.
        visible: ws.output == "" || ws.output == Shell.screen.name;
        y: (parent.height - self.height) / 2;
        width: root.numbers ? (ws.active ? 30px : 22px) : ws.active ? 34px : ws.windows > 0 ? 18px : 14px;
        height: root.numbers ? 22px : 10px;
        border-radius: self.height / 2;
        background: ws.active ? Style.accent : ws.urgent ? Style.danger : touch.has-hover ? Style.hover
            : root.numbers && ws.windows == 0 ? transparent : Style.elevated;
        opacity: ws.active || ws.windows > 0 ? 1 : 0.7;
        animate width, background { duration: Style.motion; easing: ease-out; }
        if root.numbers: Text {
            text: ws.index;
            color: ws.active ? Style.accent-ink : Style.text;
            font-size: Style.font-small;
            font-weight: ws.active ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea { clicked => { Workspaces.focus(ws.id); } }
    }
}

component StatusIcon inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> highlighted;
    in property <color> tint: Style.text;
    callback clicked();
    callback right-clicked();
    callback scrolled(delta: length);

    height: 26px;
    width: max(26px, row.preferred-width + (root.label != "" ? 16px : 10px));
    border-radius: 13px;
    background: root.highlighted ? Style.accent-soft : touch.has-hover ? Style.hover.with-alpha(0.7) : transparent;
    animate background { duration: Style.motion-fast; }
    row := HorizontalLayout {
        alignment: center;
        spacing: 5px;
        Icon {
            name: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            color: root.tint;
        }
        if root.label != "": Text {
            text: root.label;
            color: Style.text;
            font-size: Style.font-small;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.right-clicked();
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y);
            accept
        }
    }
}

export component TopPanel inherits PanelWindow {
    namespace: "lunadash-panel";
    anchor-top: !Prefs.panel-bottom;
    anchor-bottom: Prefs.panel-bottom;
    anchor-left: true;
    anchor-right: true;
    preferred-height: Style.panel-height + 8px;
    default-font-family: Style.font;

    // Keyboard shortcuts of the LunaDash compositor arrive as requests.
    property <int> request-serial: Compositor.request-serial;
    changed request-serial => {
        if !UI.primary {
            return;
        }
        if Compositor.request == "launcher" || Compositor.request == "orbit-launcher" {
            if Compositor.request-argument == "false" {
                UI.close-all();
            } else {
                UI.toggle-overlay("launcher");
            }
        } else if Compositor.request == "settings" {
            UI.open-settings(Compositor.request-argument == "" ? "appearance" : Compositor.request-argument);
        } else if Compositor.request == "wallpaper-picker" {
            UI.toggle-overlay("wallpapers");
        } else if Compositor.request == "control-center" {
            UI.toggle-overlay("dashboard");
        } else if Compositor.request == "clipboard" {
            UI.toggle-popup("clipboard");
        } else if Compositor.request == "power-menu" {
            UI.toggle-overlay("power");
        }
    }

    property <string> desktop-language: Compositor.language;
    changed desktop-language => {
        if UI.primary {
            Apply.language();
        }
    }

    ready => {
        // Shell-wide settings are applied once, from the primary screen.
        if UI.primary {
            Apply.all();
            // LunaDash has its own first-run setup; the card is for other compositors.
            if !Prefs.welcome-done && !Compositor.has-commands {
                UI.open-overlay("welcome");
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: Prefs.panel-bottom ? 2px : 6px;
        padding-bottom: Prefs.panel-bottom ? 6px : 2px;
        spacing: 8px;

        // Left: workspaces and the session menu.
        Pill {
            width: left.preferred-width;
            left := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                if Workspaces.available: WorkspaceDots { }
                // Every open window, across workspaces (the same box as Alt+Tab).
                if Switcher.available: IconButton {
                    icon: "window";
                    size: 24px;
                    icon-size: 15px;
                    y: (parent.height - self.height) / 2;
                    active: Switcher.active;
                    clicked => { Switcher.open(false); }
                    right-clicked => { Switcher.open(true); }
                }
                if Workspaces.available: Rectangle { width: 1px; height: 16px; y: (parent.height - self.height) / 2; background: Style.border; }
                IconButton {
                    icon: "power";
                    size: 24px;
                    icon-size: 15px;
                    y: (parent.height - self.height) / 2;
                    active: UI.overlay == "power";
                    clicked => { UI.toggle-overlay("power"); }
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Prefs.window-title ? Workspaces.focused-window.title : "";
            color: Style.muted;
            font-size: Style.font-small;
            vertical-alignment: center;
            overflow: elide;
        }

        // Centre: launcher, dashboard, settings.
        Pill {
            width: 112px;
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                IconButton {
                    icon: "diamond";
                    size: 26px;
                    icon-size: 14px;
                    y: (parent.height - self.height) / 2;
                    active: UI.overlay == "launcher";
                    clicked => { UI.toggle-overlay("launcher"); }
                }
                Rectangle {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 15px;
                    background: transparent;
                    border-width: UI.overlay == "dashboard" ? 2px : luna.has-hover ? 1px : 0px;
                    border-color: Style.accent;
                    drop-shadow-blur: UI.overlay == "dashboard" || luna.has-hover ? 10px : 0px;
                    drop-shadow-color: Style.accent.with-alpha(0.5);
                    animate border-width, drop-shadow-blur { duration: Style.motion-fast; }
                    Image {
                        source: @image-url("../assets/lunadash.png");
                        width: luna.pressed ? 24px : 28px;
                        height: self.width;
                        image-fit: contain;
                        animate width { duration: Style.motion-fast; }
                    }
                    luna := TouchArea { clicked => { UI.toggle-overlay("dashboard"); } }
                }
                IconButton {
                    icon: "settings";
                    size: 26px;
                    icon-size: 15px;
                    y: (parent.height - self.height) / 2;
                    active: UI.overlay == "settings";
                    clicked => { UI.toggle-overlay("settings"); }
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Right: clock.
        Pill {
            // Padding, not an x offset: an offset layout keeps the pill's width and overflows it.
            width: clock.preferred-width;
            background: UI.popup == "calendar" ? Style.accent-soft : Style.glass;
            animate background { duration: Style.motion-fast; }
            clock := HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                Text { text: Time.clock; color: Style.text; font-size: Style.font-size; font-weight: 700; vertical-alignment: center; }
                if Prefs.clock-date: Rectangle { width: 1px; height: 14px; y: (parent.height - self.height) / 2; background: Style.border; }
                if Prefs.clock-date: Text { text: Time.short-date; color: Style.muted; font-size: Style.font-small; vertical-alignment: center; }
            }
            TouchArea { clicked => { UI.toggle-popup("calendar"); } }
        }

        // Right: tray and system status.
        Pill {
            width: status.preferred-width;
            status := HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 2px;
                alignment: center;
                for item in Tray.items: Rectangle {
                    visible: item.status != "passive";
                    width: 26px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 13px;
                    background: tray-touch.has-hover ? Style.hover.with-alpha(0.7) : transparent;
                    Image { source: item.icon; width: 16px; height: 16px; image-fit: contain; }
                    tray-touch := TouchArea {
                        clicked => {
                            if item.item-is-menu {
                                UI.toggle-popup("tray");
                                Tray.open-menu(item.id);
                            } else {
                                Tray.activate(item.id);
                            }
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                UI.toggle-popup("tray");
                                Tray.open-menu(item.id);
                            }
                        }
                        scroll-event(event) => {
                            Tray.scroll(item.id, event.delta-y > 0 ? -1 : 1);
                            accept
                        }
                    }
                }
                if Tray.items.length > 0: Rectangle { width: 1px; height: 14px; y: (parent.height - self.height) / 2; background: Style.border; }
                if ClipboardHistory.available: StatusIcon {
                    y: (parent.height - self.height) / 2;
                    icon: "clipboard";
                    highlighted: UI.popup == "clipboard";
                    clicked => { UI.toggle-popup("clipboard"); }
                }
                if Network.available: StatusIcon {
                    y: (parent.height - self.height) / 2;
                    icon: !Network.connected ? "wifi-off" : Network.kind == "wifi" ? "wifi" : "ethernet";
                    tint: Network.online ? Style.text : Style.warning;
                    highlighted: UI.popup == "network";
                    clicked => { UI.toggle-popup("network"); }
                }
                if Bluetooth.available && Bluetooth.powered: StatusIcon {
                    y: (parent.height - self.height) / 2;
                    icon: "bluetooth";
                    label: Bluetooth.connected-count > 0 ? Bluetooth.connected-count : "";
                    highlighted: UI.popup == "network";
                    clicked => { UI.toggle-popup("network"); }
                }
                if Audio.available: StatusIcon {
                    y: (parent.height - self.height) / 2;
                    icon: Audio.output.muted ? "volume-mute" : Audio.output.volume < 0.4 ? "volume-low" : "volume";
                    highlighted: UI.popup == "audio";
                    clicked => { UI.toggle-popup("audio"); }
                    right-clicked => { Audio.toggle-muted(); }
                    scrolled(delta) => {
                        Audio.set-volume(clamp(Audio.output.volume + (delta > 0 ? 0.05 : -0.05), 0, 1.5));
                    }
                }
                if Battery.available: StatusIcon {
                    y: (parent.height - self.height) / 2;
                    icon: Battery.charging ? "battery-charging" : "battery";
                    label: Math.round(Battery.level * 100) + "%";
                    tint: Battery.level < 0.15 && !Battery.charging ? Style.danger : Style.text;
                    clicked => { UI.open-dashboard(2); }
                }
                StatusIcon {
                    y: (parent.height - self.height) / 2;
                    icon: Notifications.do-not-disturb ? "bell-off" : "bell";
                    label: Notifications.count > 0 ? Notifications.count : "";
                    highlighted: UI.overlay == "dashboard" && UI.dashboard-tab == 3;
                    clicked => { UI.open-dashboard(3); }
                    right-clicked => { Notifications.set-do-not-disturb(!Notifications.do-not-disturb); }
                }
            }
        }
    }
}
