// The application launcher: search at the top, categories on the left, the applications
// (icon, name and what each is) on the right. Type to search, Up / Down to move, Tab to change
// category, Enter to start.

import { Apps, AppInfo, Store, Compositor, Shell } from "@slintlu";
import { Style } from "../style/style.slint";
import { UI } from "../state/ui.slint";
import { Prefs } from "../state/prefs.slint";
import { Overlay } from "../components/overlay.slint";
import { Icon } from "../components/icon.slint";

// A group of freedesktop categories ("" in `filter` is every application).
struct Category {
    label: string,
    icon: string,
    filter: string,
}

// One application: its icon, its name and what it is (generic name, else comment).
component AppRow inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 36px;
    in property <string> name;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> pinned;
    callback clicked();
    callback pin();
    border-radius: Style.radius-small;
    background: root.selected ? Style.accent : touch.pressed ? Style.pressed : touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.icon-size + 12px;
                height: root.icon-size + 12px;
                border-radius: Style.radius-small;
                background: root.selected ? Style.accent-ink.with-alpha(0.12) : Style.elevated;
                Image {
                    source: root.icon;
                    width: root.icon-size;
                    height: root.icon-size;
                    image-fit: contain;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.name;
                color: root.selected ? Style.accent-ink : Style.text;
                font-size: Style.font-size;
                font-weight: 600;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: root.selected ? Style.accent-ink.with-alpha(0.78) : Style.muted;
                font-size: Style.font-small;
                overflow: elide;
            }
        }
        // Pinned to the dock.
        if root.pinned: VerticalLayout {
            alignment: center;
            Icon { name: "dock"; width: 16px; height: 16px; color: root.selected ? Style.accent-ink : Style.muted; }
        }
        if root.selected: VerticalLayout {
            alignment: center;
            Icon { name: "enter"; width: 16px; height: 16px; color: Style.accent-ink; }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.pin();
            }
        }
    }
}

// One category in the rail.
component CategoryItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: 20px;
    background: root.selected ? Style.tonal : area.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon { name: root.icon; width: 18px; height: 18px; color: root.selected ? Style.on-tonal : Style.muted; }
        }
        Text {
            text: root.label;
            color: root.selected ? Style.on-tonal : Style.text;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

export component Launcher inherits Overlay {
    name: "launcher";
    namespace: "lunadash-launcher";
    // Rises from the bottom of the desktop.
    edge: "bottom";
    content-width: 900px;
    content-height: 620px;

    property <[Category]> categories: [
        { label: @tr("All"), icon: "apps", filter: "" },
        { label: @tr("Internet"), icon: "globe", filter: "Network" },
        { label: @tr("Office"), icon: "document", filter: "Office" },
        { label: @tr("Graphics"), icon: "image", filter: "Graphics" },
        { label: @tr("Multimedia"), icon: "video", filter: "AudioVideo;Audio;Video" },
        { label: @tr("Development"), icon: "terminal", filter: "Development" },
        { label: @tr("Games"), icon: "diamond", filter: "Game" },
        { label: @tr("Education"), icon: "info", filter: "Education;Science" },
        { label: @tr("System"), icon: "settings", filter: "System;Settings" },
        { label: @tr("Utilities"), icon: "grid", filter: "Utility;Accessories" },
    ];
    property <int> category: 0;
    property <string> query;
    property <int> selected: 0;
    // Compact fits more, smaller rows.
    property <bool> compact: Prefs.launcher-density == "compact";
    property <length> row-height: root.compact ? 44px : 56px;
    property <length> row-gap: 2px;
    // Typing searches every application; without a query a category is browsed.
    // Mentioning Apps.all refreshes the results when the background scan finishes.
    property <[AppInfo]> results: Apps.all.length >= 0
        ? Apps.search-in(root.query, root.query == "" ? root.categories[root.category].filter : "",
            root.query == "" ? 400 : 64)
        : [];

    // Scrolls the list so the selected row is visible.
    function reveal() {
        let top = root.selected * (root.row-height + root.row-gap);
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + root.row-height > -list.content-y + list.height {
            list.content-y = -(top + root.row-height - list.height);
        }
    }
    changed selected => { root.reveal(); }
    function choose-category(index: int) {
        root.category = index;
        root.selected = 0;
        list.content-y = 0;
        search.focus();
    }
    function launch(id: string) {
        Apps.launch(id);
        UI.close-all();
    }
    changed shown => {
        if Compositor.has-commands && UI.primary {
            Compositor.command("launcher-visible", self.shown ? "true" : "false");
        }
        if self.shown {
            search.text = "";
            root.query = "";
            root.selected = 0;
            root.category = 0;
            list.content-y = 0;
        }
    }
    // Typing goes to the search field as soon as the launcher opens.
    opened => { search.focus(); }

    VerticalLayout {
        padding: Style.spacing-xl;
        spacing: Style.spacing-lg;

        // Search: the first thing, and where the keyboard is.
        Rectangle {
            height: 56px;
            border-radius: 28px;
            background: Style.surface;
            border-width: search.has-focus ? 2px : 1px;
            border-color: search.has-focus ? Style.accent : Style.hairline;
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 10px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    Icon { name: "search"; width: 22px; height: 22px; color: search.has-focus ? Style.accent : Style.muted; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    search := TextInput {
                        width: 100%;
                        height: 100%;
                        vertical-alignment: center;
                        color: Style.text;
                        font-size: 18px;
                        single-line: true;
                        edited => {
                            root.query = self.text;
                            root.selected = 0;
                            list.content-y = 0;
                        }
                        accepted => {
                            if root.results.length > 0 {
                                root.launch(root.results[root.selected].id);
                            }
                        }
                        key-pressed(event) => {
                            if event.text == Key.DownArrow {
                                root.selected = min(root.results.length - 1, root.selected + 1);
                                return accept;
                            }
                            if event.text == Key.UpArrow {
                                root.selected = max(0, root.selected - 1);
                                return accept;
                            }
                            if event.text == Key.PageDown {
                                root.selected = min(root.results.length - 1, root.selected + 8);
                                return accept;
                            }
                            if event.text == Key.PageUp {
                                root.selected = max(0, root.selected - 8);
                                return accept;
                            }
                            if event.text == Key.Tab && root.query == "" {
                                root.choose-category(Math.mod(root.category + 1, root.categories.length));
                                return accept;
                            }
                            if event.text == Key.Backtab && root.query == "" {
                                root.choose-category(Math.mod(root.category - 1 + root.categories.length, root.categories.length));
                                return accept;
                            }
                            if event.text == Key.Escape {
                                UI.close-all();
                                return accept;
                            }
                            reject
                        }
                    }
                    if search.text == "" && !(search.has-focus && Shell.composing): Text {
                        width: 100%;
                        height: 100%;
                        vertical-alignment: center;
                        text: @tr("Search applications");
                        color: Style.muted;
                        font-size: 18px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: count.preferred-width + 22px;
                        height: 32px;
                        border-radius: 16px;
                        background: Style.tonal;
                        count := Text {
                            text: root.results.length;
                            color: Style.on-tonal;
                            font-size: Style.font-small;
                            font-weight: 600;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Style.spacing-lg;

            // Categories, on the same opaque surface as the list.
            Rectangle {
                width: 204px;
                border-radius: Style.radius-large * 0.6;
                background: Style.surface;
                VerticalLayout {
                padding: Style.spacing-sm;
                spacing: 2px;
                alignment: start;
                for entry[i] in root.categories: CategoryItem {
                    label: entry.label;
                    icon: entry.icon;
                    selected: root.query == "" && i == root.category;
                    clicked => {
                        search.text = "";
                        root.query = "";
                        root.choose-category(i);
                    }
                }
                }
            }

            // The applications. The drawer shares the bar's translucent colour and edge
            // drawers are not blurred, so the list sits on an opaque surface.
            sheet := Rectangle {
                horizontal-stretch: 1;
                border-radius: Style.radius-large * 0.6;
                background: Style.surface;
                clip: true;
                property <bool> scrolls: rows.preferred-height > list.height;
                list := Flickable {
                    x: Style.spacing-sm;
                    y: Style.spacing-sm;
                    width: parent.width - 2 * Style.spacing-sm - (sheet.scrolls ? 14px : 0px);
                    height: parent.height - 2 * Style.spacing-sm;
                    content-height: rows.preferred-height;
                    rows := VerticalLayout {
                        spacing: root.row-gap;
                        alignment: start;
                        for app[i] in root.results: AppRow {
                            height: root.row-height;
                            icon: app.icon;
                            icon-size: root.compact ? 24px : 32px;
                            name: app.name;
                            detail: app.generic-name != "" ? app.generic-name : app.comment;
                            selected: i == root.selected;
                            pinned: root.is-pinned(app.id);
                            clicked => { root.launch(app.id); }
                            pin => {
                                if root.is-pinned(app.id) {
                                    Store.list-remove("dock-pinned", app.id);
                                } else {
                                    Store.list-add("dock-pinned", app.id);
                                }
                            }
                        }
                    }
                }
                if root.results.length == 0: Text {
                    text: root.query != "" ? @tr("No applications match “{}”", root.query) : @tr("No applications in this category");
                    color: Style.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                // A scrollbar: the thumb shows where the list is; drag or click the track.
                if sheet.scrolls: track := Rectangle {
                    property <length> range: rows.preferred-height - list.height;
                    property <length> thumb-height: max(32px, self.height * list.height / rows.preferred-height);
                    x: sheet.width - self.width - 4px;
                    y: Style.spacing-sm;
                    width: 8px;
                    height: sheet.height - 2 * Style.spacing-sm;
                    Rectangle {
                        y: (track.height - track.thumb-height) * clamp(-list.content-y / track.range, 0, 1);
                        height: track.thumb-height;
                        border-radius: self.width / 2;
                        background: drag.pressed ? Style.text.with-alpha(0.55) : Style.muted.with-alpha(drag.has-hover ? 0.55 : 0.4);
                    }
                    drag := TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && self.pressed) {
                                list.content-y = -track.range * clamp((self.mouse-y - track.thumb-height / 2) / (track.height - track.thumb-height), 0, 1);
                            }
                        }
                    }
                }
            }
        }

        Text {
            text: @tr("Enter to open · Tab for the next category · right-click to pin to the dock · Esc to close");
            color: Style.muted;
            font-size: Style.font-small;
            horizontal-alignment: center;
        }
    }

    pure function is-pinned(id: string) -> bool {
        Store.list-contains("dock-pinned", id, Store.revision)
    }
}
