// The application launcher: type to search, arrows to move, Enter to start.

import { Apps, AppInfo, Store, Compositor } from "@slintlu";
import { Style } from "../style/style.slint";
import { UI } from "../state/ui.slint";
import { Prefs } from "../state/prefs.slint";
import { Overlay } from "../components/overlay.slint";
import { Icon } from "../components/icon.slint";

component AppTile inherits Rectangle {
    in property <length> icon-size: 56px;
    in property <image> icon;
    in property <string> name;
    in property <bool> selected;
    in property <bool> pinned;
    callback clicked();
    callback pin();
    border-radius: root.selected ? Style.radius-large : Style.radius-medium;
    background: root.selected ? Style.tonal : touch.has-hover ? Style.hover.with-alpha(0.6) : transparent;
    animate background { duration: Style.motion-fast; }
    animate border-radius { duration: Style.motion; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: center;
        Image {
            source: root.icon;
            width: root.icon-size;
            height: root.icon-size;
            x: (parent.width - self.width) / 2;
            image-fit: contain;
        }
        // Up to two lines, so longer names ("KDE Partition Manager") stay readable.
        Text {
            text: root.name;
            color: Style.text;
            font-size: Style.font-size;
            height: 2 * Style.font-size * 1.35;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
            overflow: elide;
        }
    }
    if root.pinned: Rectangle {
        x: parent.width - 16px;
        y: 8px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Style.accent;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.pin();
            }
        }
    }
}

export component Launcher inherits Overlay {
    name: "launcher";
    namespace: "lunadash-launcher";
    // Rises out of the bottom of the screen frame, its search field along that edge.
    edge: "bottom";
    content-width: 820px;
    content-height: 560px;

    property <string> query;
    property <int> selected: 0;
    // Compact fits more, smaller tiles.
    property <bool> compact: Prefs.launcher-density == "compact";
    property <int> columns: root.compact ? 8 : 6;
    // Mentioning Apps.all refreshes the results when the background scan finishes.
    property <[AppInfo]> results: Apps.all.length >= 0 ? Apps.search(root.query, root.compact ? 64 : 48) : [];

    function launch(id: string) {
        Apps.launch(id);
        UI.close-all();
    }
    changed shown => {
        if Compositor.has-commands && UI.primary {
            Compositor.command("launcher-visible", self.shown ? "true" : "false");
        }
        if self.shown {
            search.text = "";
            root.query = "";
            root.selected = 0;
            search.focus();
        }
    }

    VerticalLayout {
        padding: Style.spacing-xl;
        spacing: Style.spacing-lg;
        HorizontalLayout {
            spacing: 8px;
            Icon {
                y: (parent.height - self.height) / 2;
                name: root.query == "" ? "grid" : "search";
                width: 20px;
                height: 20px;
                color: Style.accent;
            }
            Text {
                text: root.query == "" ? @tr("Frequently used") : @tr("{} results", root.results.length);
                color: Style.text;
                font-size: Style.font-title;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: count.preferred-width + 20px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: 13px;
                background: Style.tonal;
                count := Text {
                    text: Apps.all.length;
                    color: Style.on-tonal;
                    font-size: Style.font-small;
                    font-weight: 600;
                }
            }
        }
        // The drawer shares the bar's translucent colour, and edge drawers are not blurred, so
        // the grid sits on an opaque surface: windows behind must not show through the names.
        Rectangle {
            vertical-stretch: 1;
            border-radius: Style.radius-large;
            background: Style.surface;
            clip: true;
            Flickable {
                x: Style.spacing-sm;
                y: Style.spacing-sm;
                width: parent.width - 2 * Style.spacing-sm;
                height: parent.height - 2 * Style.spacing-sm;
                property <length> tile: self.width / root.columns;
                // Tiles are a little taller than wide: room for a two-line name.
                property <length> tile-height: self.tile * 1.1;
                content-height: Math.ceil(root.results.length / root.columns) * self.tile-height * 1.0;
                for app[i] in root.results: AppTile {
                    x: Math.mod(i, root.columns) * parent.tile;
                    y: Math.floor(i / root.columns) * parent.tile-height;
                    width: parent.tile - 6px;
                    height: parent.tile-height - 6px;
                    icon: app.icon;
                    icon-size: root.compact ? 44px : 56px;
                    name: app.name;
                    selected: i == root.selected;
                    pinned: root.is-pinned(app.id);
                    clicked => { root.launch(app.id); }
                    pin => {
                        if root.is-pinned(app.id) {
                            Store.list-remove("dock-pinned", app.id);
                        } else {
                            Store.list-add("dock-pinned", app.id);
                        }
                    }
                }
            }
        }
        if root.results.length == 0 && root.query != "": Text {
            text: @tr("No applications match “{}”", root.query);
            color: Style.muted;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 52px;
            border-radius: 26px;
            background: Style.surface;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                Icon { name: "search"; width: 20px; height: 20px; y: (parent.height - self.height) / 2; color: Style.muted; }
                Rectangle {
                    search := TextInput {
                        width: 100%;
                        height: 100%;
                        vertical-alignment: center;
                        color: Style.text;
                        font-size: 17px;
                        single-line: true;
                        edited => {
                            root.query = self.text;
                            root.selected = 0;
                        }
                        accepted => {
                            if root.results.length > 0 {
                                root.launch(root.results[root.selected].id);
                            }
                        }
                        key-pressed(event) => {
                            if event.text == Key.DownArrow {
                                root.selected = min(root.results.length - 1, root.selected + root.columns);
                                return accept;
                            }
                            if event.text == Key.UpArrow {
                                root.selected = max(0, root.selected - root.columns);
                                return accept;
                            }
                            if event.text == Key.RightArrow && self.cursor-position-byte-offset >= self.text.character-count {
                                root.selected = min(root.results.length - 1, root.selected + 1);
                                return accept;
                            }
                            if event.text == Key.LeftArrow && root.selected > 0 && self.text == "" {
                                root.selected -= 1;
                                return accept;
                            }
                            if event.text == Key.Escape {
                                UI.close-all();
                                return accept;
                            }
                            reject
                        }
                    }
                    if search.text == "": Text {
                        width: 100%;
                        height: 100%;
                        vertical-alignment: center;
                        text: @tr("Search applications");
                        color: Style.muted;
                        font-size: 17px;
                    }
                }
            }
        }
        Text {
            text: @tr("Enter to open · right-click to pin to the dock · Esc to close");
            color: Style.muted;
            font-size: Style.font-small;
            horizontal-alignment: center;
        }
    }

    pure function is-pinned(id: string) -> bool {
        Store.list-contains("dock-pinned", id, Store.revision)
    }
}
