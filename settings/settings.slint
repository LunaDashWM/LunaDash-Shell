// Settings: appearance, wallpaper, panel, dock, desktop menu, windows, display, notifications,
// power, language and about. Pages group their settings in cards.

import { Theme, Store, Idle, Session, Notifications, I18n, Shell, System, Compositor, Brightness, Files } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { UI } from "../state/ui.slint";
import { Overlay } from "../components/overlay.slint";
import { Icon } from "../components/icon.slint";
import { Switch, SectionTitle, IconButton, TextButton, TextField, ListRow, Card, Reveal, RangeSlider, Swatches, Keycap } from "../components/controls.slint";
import { Wallpapers } from "../wallpaper/wallpaper.slint";
import { Apply } from "../state/apply.slint";
import { DesktopMenu } from "../state/desktop-menu.slint";

component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <int> selected;
    callback chosen(index: int);
    height: 36px;
    // An M3 connected button group: outer ends round, inner joins nearly square, the
    // selected button fully round.
    HorizontalLayout {
        spacing: 2px;
        for label[i] in root.labels: Rectangle {
            border-radius: i == root.selected ? self.height / 2 : 6px;
            border-top-left-radius: i == 0 || i == root.selected ? self.height / 2 : 6px;
            border-bottom-left-radius: i == 0 || i == root.selected ? self.height / 2 : 6px;
            border-top-right-radius: i == root.labels.length - 1 || i == root.selected ? self.height / 2 : 6px;
            border-bottom-right-radius: i == root.labels.length - 1 || i == root.selected ? self.height / 2 : 6px;
            background: i == root.selected ? Style.accent : touch.has-hover ? Style.hover : Style.elevated;
            animate background { duration: Style.motion-fast; }
            Text {
                text: label;
                color: i == root.selected ? Style.accent-ink : Style.text;
                font-size: Style.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            min-width: self.preferred-width + 24px;
            touch := TouchArea { clicked => { root.chosen(i); } }
        }
    }
}

component Setting inherits Rectangle {
    in property <string> title;
    in property <string> description;
    min-height: 58px;
    HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: Style.spacing-md;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.title; color: Style.text; font-size: Style.font-size; }
            if root.description != "": Text { text: root.description; color: Style.muted; font-size: Style.font-small; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Style.hairline;
}

// A titled card of settings.
component Group inherits VerticalLayout {
    in property <string> title;
    spacing: Style.spacing-sm;
    padding-bottom: Style.spacing-lg;
    if root.title != "": SectionTitle { text: root.title; }
    Card {
        VerticalLayout {
            padding-left: Style.spacing-lg;
            padding-right: Style.spacing-lg;
            padding-top: 2px;
            padding-bottom: 2px;
            @children
        }
    }
}

component Page inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    alignment: start;
    Text { text: root.title; color: Style.text; font-size: Style.font-display; font-weight: 600; }
    if root.subtitle != "": Text { text: root.subtitle; color: Style.muted; font-size: Style.font-small; wrap: word-wrap; }
    Rectangle { height: Style.spacing-lg; }
    @children
}

// The account picture as a circle, or a person without one.
component Avatar inherits Rectangle {
    in property <length> size: 88px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Style.primary-container;
    clip: true;
    if Session.avatar.width > 0: Image {
        width: 100%;
        height: 100%;
        source: Session.avatar;
        image-fit: cover;
    }
    if Session.avatar.width == 0: Icon {
        name: "user";
        width: root.size * 0.5;
        height: root.size * 0.5;
        color: Style.on-primary-container;
    }
}

component AccountPage inherits Page {
    title: @tr("Account");
    subtitle: @tr("Your name and picture, shown on the lock screen and the login screen.");
    // The file chooser answers asynchronously.
    property <bool> picking;
    property <int> chosen-serial: Files.chosen-serial;
    changed chosen-serial => {
        if root.picking && Files.chosen != "" {
            Session.set-avatar(Files.chosen);
        }
        root.picking = false;
    }
    Group {
        title: @tr("PROFILE");
        HorizontalLayout {
            padding: Style.spacing-md;
            spacing: Style.spacing-lg;
            Avatar { size: 88px; }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: Session.real-name != "" ? Session.real-name : Session.user;
                    color: Style.text;
                    font-size: Style.font-title;
                    font-weight: 600;
                    overflow: elide;
                }
                Text { text: Session.user + "@" + System.hostname; color: Style.muted; overflow: elide; }
                HorizontalLayout {
                    alignment: start;
                    padding-top: 8px;
                    TextButton {
                        text: @tr("Change picture");
                        icon: "image";
                        clicked => {
                            root.picking = true;
                            Files.choose(@tr("Choose a picture"), "png,jpg,jpeg,webp,bmp", false, Files.user-dir("pictures"));
                        }
                    }
                }
                if Session.avatar-error != "": Text {
                    text: Session.avatar-error;
                    color: Style.danger;
                    font-size: Style.font-small;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component AppearancePage inherits Page {
    title: @tr("Appearance");
    subtitle: @tr("Colours, glass and the feel of the whole desktop.");
    property <string> font-query;
    Group {
        title: @tr("THEME");
        Setting {
            title: @tr("Mode");
            description: @tr("Follow the desktop, or always use the dark or light palette.");
            Segmented {
                labels: [@tr("Auto"), @tr("Dark"), @tr("Light")];
                selected: Prefs.theme-mode == "dark" ? 1 : Prefs.theme-mode == "light" ? 2 : 0;
                chosen(i) => { Apply.set-theme-mode(i == 1 ? "dark" : i == 2 ? "light" : "auto"); }
            }
        }
        Divider { }
        Setting {
            title: @tr("Accent colour");
            description: Prefs.accent < 0 ? @tr("The palette's own accent.") : @tr("Used by the shell and, on LunaDash, the whole desktop.");
            HorizontalLayout {
                spacing: Style.spacing-sm;
                Swatches { colors: Style.accents; selected: Prefs.accent; chosen(i) => { Apply.set-accent(i); } }
                IconButton { icon: "reboot"; size: 28px; y: (parent.height - self.height) / 2; clicked => { Apply.set-accent(-1); } }
            }
        }
        if Compositor.has-commands: Divider { }
        if Compositor.has-commands: Setting {
            title: @tr("Colours from the wallpaper");
            description: @tr("LunaDash derives its palette from the current wallpaper.");
            Switch {
                on: Compositor.preference-bool("wallpaperColors", true, Compositor.preferences-revision);
                toggled => { Compositor.set-preference-bool("wallpaperColors", !self.on); }
            }
        }
    }
    Group {
        title: @tr("GLASS AND SHAPE");
        Setting {
            title: @tr("Transparency");
            description: @tr("Translucent panels and popups.");
            Switch { on: Prefs.transparency; toggled => { Store.set-bool("transparency", !Prefs.transparency); } }
        }
        if Prefs.transparency: Divider { }
        if Prefs.transparency: Setting {
            title: @tr("Glass opacity");
            RangeSlider { minimum: 50; maximum: 100; step: 2; unit: "%"; value: Prefs.glass-opacity; committed(v) => { Store.set-number("glass-opacity", v); } }
        }
        Divider { }
        Setting {
            title: @tr("Corners");
            Segmented {
                labels: [@tr("Compact"), @tr("Default"), @tr("Round")];
                selected: Prefs.corners == "compact" ? 0 : Prefs.corners == "round" ? 2 : 1;
                chosen(i) => { Store.set-string("corners", i == 0 ? "compact" : i == 2 ? "round" : "default"); }
            }
        }
        Divider { }
        Setting {
            title: @tr("Text size");
            Segmented {
                labels: ["90%", "100%", "110%", "125%"];
                selected: Prefs.text-scale == 90 ? 0 : Prefs.text-scale == 110 ? 2 : Prefs.text-scale == 125 ? 3 : 1;
                chosen(i) => { Store.set-number("text-scale", i == 0 ? 90 : i == 2 ? 110 : i == 3 ? 125 : 100); }
            }
        }
    }
    Group {
        title: @tr("MOTION");
        Setting {
            title: @tr("Animations");
            description: @tr("Shell transitions and, on LunaDash, window animations.");
            Switch { on: Prefs.animations; toggled => { Apply.set-animations(!Prefs.animations); } }
        }
        if Prefs.animations: Divider { }
        if Prefs.animations: Setting {
            title: @tr("Animation speed");
            Segmented {
                labels: [@tr("Fast"), @tr("Normal"), @tr("Relaxed")];
                selected: Prefs.animation-speed == "fast" ? 0 : Prefs.animation-speed == "relaxed" ? 2 : 1;
                chosen(i) => {
                    Store.set-string("animation-speed", i == 0 ? "fast" : i == 2 ? "relaxed" : "normal");
                    if Compositor.has-commands {
                        Compositor.set-preference-number("animationDuration", i == 0 ? 140 : i == 2 ? 340 : 220);
                    }
                }
            }
        }
    }
    Group {
        title: @tr("FONT · {}", Theme.font-family == "" ? @tr("Default") : Theme.font-family);
        HorizontalLayout {
            padding: 6px;
            TextField { icon: "search"; placeholder: @tr("Search installed fonts"); text <=> root.font-query; }
        }
        ListRow {
            icon: "edit";
            title: @tr("Default");
            subtitle: @tr("theme.json's font, else the desktop's");
            selected: Prefs.font-family == "";
            clicked => { Apply.set-font(""); }
        }
        // Theme.fonts fills in shortly after start: depending on it lists them once known.
        for family in Theme.fonts.length > 0 ? Theme.search-fonts(root.font-query, 8) : []: ListRow {
            icon: "edit";
            title: family;
            selected: Prefs.font-family == family;
            clicked => { Apply.set-font(family); }
        }
    }
    Group {
        title: @tr("PALETTE · {}", Theme.name);
        ListRow {
            icon: "palette";
            title: @tr("LunaDash");
            subtitle: @tr("The default dark and light palettes");
            selected: Prefs.palette == "";
            clicked => {
                Store.remove("palette");
                Theme.set-palette(Theme.dark ? "lunadash-dark" : "lunadash-light");
            }
        }
        for name in Theme.palettes: ListRow {
            icon: "palette";
            title: name;
            selected: Prefs.palette == name;
            clicked => {
                Store.set-string("palette", name);
                Theme.set-palette(name);
            }
        }
    }
}

component WallpaperPage inherits Page {
    title: @tr("Wallpaper");
    subtitle: @tr("Images and videos behind everything, and the clock on top of them.");
    Rectangle {
        height: 220px;
        border-radius: Style.radius-medium;
        clip: true;
        background: Style.elevated;
        Image { width: parent.width; height: parent.height; source: Wallpapers.current(); image-fit: cover; }
        Rectangle { background: #000000.with-alpha(Prefs.wallpaper-dim / 100); }
        if Wallpapers.video: Rectangle {
            x: parent.width - self.width - 12px;
            y: 12px;
            width: badge.preferred-width + 20px;
            height: 28px;
            border-radius: 14px;
            background: #000000a0;
            badge := HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Icon { name: "video"; width: 14px; height: 14px; y: (parent.height - self.height) / 2; color: #ffffff; }
                Text { text: Wallpapers.live ? @tr("Video · playing") : @tr("Video"); color: #ffffff; font-size: Style.font-small; vertical-alignment: center; }
            }
        }
    }
    if Wallpapers.video && !Wallpapers.live: Text {
        text: @tr("Video wallpapers play with mpvpaper. Install it to see this one move.");
        color: Style.muted;
        font-size: Style.font-small;
        wrap: word-wrap;
    }
    Rectangle { height: Style.spacing-lg; }
    Group {
        title: @tr("CHOOSE");
        Setting {
            title: @tr("Wallpaper library");
            description: Wallpapers.managed ? @tr("Your library and LunaDash's own wallpapers (Super+W).") : @tr("Browse your folders, or pick an image or video file.");
            HorizontalLayout {
                spacing: Style.spacing-sm;
                TextButton { icon: "file"; text: @tr("Choose file…"); clicked => { Wallpapers.pick-file(); } }
                TextButton { icon: "image"; text: @tr("Open library"); primary: true; clicked => { UI.open-overlay(Wallpapers.managed ? "wallpapers" : "gallery"); } }
            }
        }
        Divider { }
        Setting {
            title: @tr("Browse folders");
            description: Prefs.wallpaper-dir;
            HorizontalLayout {
                spacing: Style.spacing-sm;
                TextButton { icon: "folder"; text: @tr("Change folder…"); clicked => { Wallpapers.pick-folder(); } }
                TextButton { icon: "grid"; text: @tr("Browse"); clicked => { UI.open-overlay("gallery"); } }
            }
        }
        if Wallpapers.managed: Divider { }
        if Wallpapers.managed: Setting {
            title: @tr("Random wallpaper");
            description: @tr("Picks another image from the LunaDash wallpaper library.");
            TextButton { icon: "reboot"; text: @tr("Shuffle"); clicked => { Compositor.command("wallpaper-random", ""); } }
        }
    }
    Group {
        title: @tr("DISPLAY");
        Setting {
            title: @tr("Fit");
            Segmented {
                labels: [@tr("Fill screen"), @tr("Whole image"), @tr("Stretch")];
                selected: Prefs.wallpaper-fit == "contain" ? 1 : Prefs.wallpaper-fit == "fill" ? 2 : 0;
                chosen(i) => { Store.set-string("wallpaper-fit", i == 1 ? "contain" : i == 2 ? "fill" : "cover"); }
            }
        }
        Divider { }
        Setting {
            title: @tr("Transition");
            description: @tr("How a new wallpaper replaces the old one.");
            Segmented {
                property <[string]> values: ["random", "fade", "wipe", "disc", "zoom", "none"];
                labels: [@tr("Random"), @tr("Fade"), @tr("Wipe"), @tr("Disc"), @tr("Zoom"), @tr("Off")];
                selected: Prefs.wallpaper-transition == "fade" ? 1 : Prefs.wallpaper-transition == "wipe" ? 2
                    : Prefs.wallpaper-transition == "disc" ? 3 : Prefs.wallpaper-transition == "zoom" ? 4
                    : Prefs.wallpaper-transition == "none" ? 5 : 0;
                chosen(i) => { Store.set-string("wallpaper-transition", self.values[i]); }
            }
        }
        Divider { }
        Setting {
            title: @tr("Dim");
            description: @tr("Darkens the wallpaper so text and windows stand out.");
            RangeSlider { minimum: 0; maximum: 60; step: 5; unit: "%"; value: Prefs.wallpaper-dim; committed(v) => { Store.set-number("wallpaper-dim", v); } }
        }
    }
    Group {
        title: @tr("DESKTOP CLOCK");
        Setting { title: @tr("Desktop clock"); description: @tr("A large clock on the wallpaper."); Switch { on: Prefs.desktop-clock; toggled => { Store.set-bool("desktop-clock", !Prefs.desktop-clock); } } }
        if Prefs.desktop-clock: Divider { }
        if Prefs.desktop-clock: Setting {
            title: @tr("Position");
            Segmented {
                labels: [@tr("Bottom left"), @tr("Bottom right"), @tr("Top left"), @tr("Centre")];
                selected: Prefs.desktop-clock-position == "bottom-right" ? 1 : Prefs.desktop-clock-position == "top-left" ? 2 : Prefs.desktop-clock-position == "center" ? 3 : 0;
                chosen(i) => { Store.set-string("desktop-clock-position", i == 1 ? "bottom-right" : i == 2 ? "top-left" : i == 3 ? "center" : "bottom-left"); }
            }
        }
        if Prefs.desktop-clock: Divider { }
        if Prefs.desktop-clock: Setting {
            title: @tr("Size");
            Segmented {
                labels: [@tr("Small"), @tr("Medium"), @tr("Large")];
                selected: Prefs.desktop-clock-size == "small" ? 0 : Prefs.desktop-clock-size == "medium" ? 1 : 2;
                chosen(i) => { Store.set-string("desktop-clock-size", i == 0 ? "small" : i == 1 ? "medium" : "large"); }
            }
        }
        if Prefs.desktop-clock: Divider { }
        if Prefs.desktop-clock: Setting { title: @tr("Show the date"); Switch { on: Prefs.desktop-clock-date; toggled => { Store.set-bool("desktop-clock-date", !Prefs.desktop-clock-date); } } }
    }
}

component PanelPage inherits Page {
    title: @tr("Panel");
    subtitle: @tr("The bar with your workspaces, clock and status.");
    Group {
        title: @tr("LAYOUT");
        Setting {
            title: @tr("Position");
            Segmented {
                labels: [@tr("Top"), @tr("Left")];
                selected: Style.bar-top ? 0 : 1;
                chosen(i) => { Store.set-string("bar-position", i == 1 ? "left" : "top"); }
            }
        }
        Divider { }
        Setting {
            title: @tr("Bar opacity");
            description: @tr("Also the screen frame and the panels that open out of it.");
            RangeSlider { minimum: 30; maximum: 100; step: 5; unit: "%"; value: Prefs.bar-opacity; committed(v) => { Store.set-number("bar-opacity", v); } }
        }
        Divider { }
        Setting {
            title: @tr("Screen frame");
            description: @tr("A border around the screen that the bar and the panels open out of.");
            Switch { on: Prefs.screen-frame; toggled => { Store.set-bool("screen-frame", !Prefs.screen-frame); } }
        }
        Divider { }
        Setting {
            title: @tr("Workspace indicator");
            Segmented {
                labels: [@tr("Dots"), @tr("Numbers")];
                selected: Prefs.workspace-style == "numbers" ? 1 : 0;
                chosen(i) => { Store.set-string("workspace-style", i == 1 ? "numbers" : "dots"); }
            }
        }
        Divider { }
        Setting { title: @tr("Taskbar"); description: @tr("Show every window's icon after the workspaces."); Switch { on: Prefs.taskbar; toggled => { Store.set-bool("taskbar", !Prefs.taskbar); } } }
        Divider { }
        Setting { title: @tr("Window title"); description: @tr("Show the focused window's title."); Switch { on: Prefs.window-title; toggled => { Store.set-bool("window-title", !Prefs.window-title); } } }
    }
    Group {
        title: @tr("CLOCK");
        Setting { title: @tr("24-hour clock"); Switch { on: Prefs.clock-24h; toggled => { Store.set-bool("clock-24h", !Prefs.clock-24h); } } }
        Divider { }
        Setting { title: @tr("Show seconds"); Switch { on: Prefs.clock-seconds; toggled => { Store.set-bool("clock-seconds", !Prefs.clock-seconds); } } }
        Divider { }
        Setting { title: @tr("Show the date"); Switch { on: Prefs.clock-date; toggled => { Store.set-bool("clock-date", !Prefs.clock-date); } } }
        Divider { }
        Setting { title: @tr("Weeks start on Monday"); Switch { on: Prefs.week-starts-monday; toggled => { Store.set-bool("week-starts-monday", !Prefs.week-starts-monday); } } }
    }
}

component DockPage inherits Page {
    title: @tr("Dock");
    subtitle: @tr("Pinned applications and running windows.");
    Group {
        Setting { title: @tr("Show the dock"); Switch { on: Prefs.dock; toggled => { Store.set-bool("dock", !Prefs.dock); } } }
        if Prefs.dock: Divider { }
        if Prefs.dock: Setting { title: @tr("Hide automatically"); description: @tr("Slides away until the pointer reaches the bottom edge."); Switch { on: Prefs.dock-autohide; toggled => { Store.set-bool("dock-autohide", !Prefs.dock-autohide); } } }
        if Prefs.dock: Divider { }
        if Prefs.dock: Setting {
            title: @tr("Icon size");
            Segmented {
                labels: [@tr("Small"), @tr("Medium"), @tr("Large")];
                selected: Prefs.dock-size == "small" ? 0 : Prefs.dock-size == "large" ? 2 : 1;
                chosen(i) => { Store.set-string("dock-size", i == 0 ? "small" : i == 2 ? "large" : "medium"); }
            }
        }
        if Prefs.dock: Divider { }
        if Prefs.dock: Setting { title: @tr("Launcher button"); Switch { on: Prefs.dock-launcher; toggled => { Store.set-bool("dock-launcher", !Prefs.dock-launcher); } } }
    }
    Group {
        title: @tr("PINNED");
        Setting {
            title: @tr("Pinned applications");
            description: @tr("{} pinned. Right-click an application in the launcher or dock to pin or unpin it.", Prefs.pinned.length);
            TextButton { text: @tr("Unpin all"); enabled: Prefs.pinned.length > 0; clicked => { Store.remove("dock-pinned"); } }
        }
    }
}

// One entry of the desktop menu, with buttons to move it, edit it (commands of the user's) or
// take it out.
component MenuEntryRow inherits Rectangle {
    in property <string> id;
    in property <int> index;
    in property <int> count;
    callback edit();
    callback removed();
    property <bool> command: DesktopMenu.is-command(root.id);
    property <bool> elsewhere: DesktopMenu.needs-lunadash(root.id) && !Compositor.has-commands;
    min-height: 52px;
    HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: Style.spacing-md;
        VerticalLayout {
            alignment: center;
            Icon {
                name: DesktopMenu.icon(root.id);
                width: 20px;
                height: 20px;
                color: root.id == "separator" ? Style.muted : Style.text;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: DesktopMenu.label(root.id);
                color: root.id == "separator" || root.elsewhere ? Style.muted : Style.text;
                font-size: Style.font-size;
                overflow: elide;
            }
            if root.command: Text { text: DesktopMenu.command(root.id); color: Style.muted; font-size: Style.font-small; overflow: elide; }
            if root.elsewhere: Text { text: @tr("Only on LunaDash"); color: Style.muted; font-size: Style.font-small; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                IconButton {
                    icon: "arrow-up";
                    opacity: root.index > 0 ? 1 : 0.35;
                    clicked => {
                        if root.index > 0 { DesktopMenu.move(root.index, -1); }
                    }
                }
                IconButton {
                    icon: "arrow-down";
                    opacity: root.index < root.count - 1 ? 1 : 0.35;
                    clicked => {
                        if root.index < root.count - 1 { DesktopMenu.move(root.index, 1); }
                    }
                }
                if root.command: IconButton { icon: "edit"; clicked => { root.edit(); } }
                IconButton {
                    icon: root.command ? "trash" : "close";
                    clicked => {
                        root.removed();
                        DesktopMenu.remove(root.index);
                    }
                }
            }
        }
    }
}

component DesktopMenuPage inherits Page {
    title: @tr("Desktop menu");
    subtitle: @tr("What right-clicking the desktop offers, in this order.");
    // The command being edited ("" while adding one) and the form's fields.
    property <string> editing;
    property <string> label-text;
    property <string> command-text;
    function clear-form() {
        root.editing = "";
        root.label-text = "";
        root.command-text = "";
    }
    function submit() {
        if root.command-text == "" {
            return;
        }
        if root.editing != "" {
            DesktopMenu.update-command(root.editing, root.label-text, root.command-text);
        } else {
            DesktopMenu.add-command(root.label-text, root.command-text);
        }
        root.clear-form();
    }

    Group {
        title: @tr("ENTRIES");
        if DesktopMenu.entries.length == 0: Text {
            height: 52px;
            text: @tr("The menu is empty. Add entries below.");
            color: Style.muted;
            vertical-alignment: center;
            overflow: elide;
        }
        for id[i] in DesktopMenu.entries: VerticalLayout {
            if i > 0: Divider { }
            MenuEntryRow {
                id: id;
                index: i;
                count: DesktopMenu.entries.length;
                edit => {
                    root.editing = id;
                    root.label-text = DesktopMenu.command-label(id);
                    root.command-text = DesktopMenu.command(id);
                }
                removed => {
                    if id == root.editing { root.clear-form(); }
                }
            }
        }
    }
    Group {
        title: @tr("ADD");
        Setting {
            title: @tr("Separator");
            description: @tr("A line between groups of entries.");
            TextButton { icon: "plus"; text: @tr("Add"); clicked => { DesktopMenu.add("separator"); } }
        }
        for id in DesktopMenu.builtins: VerticalLayout {
            if DesktopMenu.hidden(id): Divider { }
            if DesktopMenu.hidden(id): Setting {
                title: DesktopMenu.label(id);
                description: DesktopMenu.needs-lunadash(id) && !Compositor.has-commands ? @tr("Only on LunaDash") : "";
                TextButton { icon: "plus"; text: @tr("Add"); clicked => { DesktopMenu.add(id); } }
            }
        }
    }
    Group {
        title: root.editing != "" ? @tr("EDIT COMMAND") : @tr("YOUR OWN COMMAND");
        Setting {
            title: @tr("Name");
            description: @tr("Shown in the menu. Empty: the command itself.");
            TextField { width: 300px; placeholder: @tr("System monitor"); text <=> root.label-text; }
        }
        Divider { }
        Setting {
            title: @tr("Command");
            description: @tr("A program and its arguments. It starts without a shell: quotes group words, but pipes, variables and ; reach the program as text.");
            TextField { width: 300px; placeholder: "kitty -e htop"; text <=> root.command-text; accepted => { root.submit(); } }
        }
        Divider { }
        HorizontalLayout {
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: Style.spacing-sm;
            alignment: end;
            if root.editing != "": TextButton { text: @tr("Cancel"); clicked => { root.clear-form(); } }
            TextButton {
                icon: root.editing != "" ? "check" : "plus";
                text: root.editing != "" ? @tr("Save") : @tr("Add command");
                primary: true;
                enabled: root.command-text != "";
                clicked => { root.submit(); }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        TextButton {
            icon: "reboot";
            text: @tr("Restore defaults");
            enabled: DesktopMenu.edited;
            clicked => {
                root.clear-form();
                DesktopMenu.reset();
            }
        }
    }
}

component WindowsPage inherits Page {
    title: @tr("Windows");
    subtitle: @tr("How LunaDash arranges and draws application windows.");
    property <int> revision: Compositor.preferences-revision;
    Group {
        title: @tr("LAYOUT");
        Setting {
            title: @tr("Gaps");
            RangeSlider { minimum: 4; maximum: 32; step: 2; unit: "px"; value: Compositor.preference-number("gap", 12, root.revision); committed(v) => { Compositor.set-preference-number("gap", v); } }
        }
    }
    Group {
        title: @tr("LOOK");
        Setting {
            title: @tr("Window opacity");
            description: @tr("Unfocused content shows the blurred wallpaper through it.");
            RangeSlider { minimum: 60; maximum: 100; step: 5; unit: "%"; value: Compositor.preference-number("windowOpacity", 90, root.revision); committed(v) => { Compositor.set-preference-number("windowOpacity", v); } }
        }
        Divider { }
        Setting {
            title: @tr("Blur");
            Switch { on: Compositor.preference-bool("blur", true, root.revision); toggled => { Compositor.set-preference-bool("blur", !self.on); } }
        }
        if Compositor.preference-bool("blur", true, root.revision): Divider { }
        if Compositor.preference-bool("blur", true, root.revision): Setting {
            title: @tr("Blur strength");
            RangeSlider { minimum: 0; maximum: 32; step: 2; unit: "px"; value: Compositor.preference-number("blurRadius", 18, root.revision); committed(v) => { Compositor.set-preference-number("blurRadius", v); } }
        }
    }
}

// One compositor action and the keys bound to it, with a button to record new ones.
component ShortcutRow inherits Rectangle {
    in property <string> action;
    in property <string> label;
    in property <bool> recording;
    callback change();
    min-height: 50px;
    HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: Style.spacing-md;
        Text {
            text: root.label;
            color: Style.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.recording: Text {
            text: @tr("Press the new shortcut…");
            color: Style.accent;
            font-weight: 600;
            vertical-alignment: center;
        }
        // Slint cannot filter a model: every shortcut gets an empty slot except the match.
        if !root.recording: HorizontalLayout {
            alignment: end;
            for shortcut in Compositor.shortcuts: HorizontalLayout {
                spacing: Style.spacing-xs;
                if shortcut.action == root.action: HorizontalLayout {
                    spacing: Style.spacing-xs;
                    for key in shortcut.keys: Keycap { key: key; y: (parent.height - self.height) / 2; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            TextButton { text: root.recording ? @tr("Cancel") : @tr("Change"); clicked => { root.change(); } }
        }
    }
}

component ShortcutsPage inherits Page {
    title: @tr("Keyboard shortcuts");
    subtitle: @tr("Choose Change, then press the keys. Global shortcuts use Super or Alt; Esc cancels.");
    // The action being recorded, or "".
    property <string> recording;
    property <string> message;

    // The key's name as LunaDash writes it (an xkb keysym name), or "" when unsupported.
    pure function key-name(text: string) -> string {
        text == Key.Return ? "Return" : text == Key.Tab ? "Tab" : text == Key.Space ? "Space"
            : text == Key.Backspace ? "BackSpace" : text == Key.Delete ? "Delete" : text == Key.Insert ? "Insert"
            : text == Key.Home ? "Home" : text == Key.End ? "End" : text == Key.PageUp ? "Prior" : text == Key.PageDown ? "Next"
            : text == Key.LeftArrow ? "Left" : text == Key.RightArrow ? "Right" : text == Key.UpArrow ? "Up" : text == Key.DownArrow ? "Down"
            : text == Key.F1 ? "F1" : text == Key.F2 ? "F2" : text == Key.F3 ? "F3" : text == Key.F4 ? "F4"
            : text == Key.F5 ? "F5" : text == Key.F6 ? "F6" : text == Key.F7 ? "F7" : text == Key.F8 ? "F8"
            : text == Key.F9 ? "F9" : text == Key.F10 ? "F10" : text == Key.F11 ? "F11" : text == Key.F12 ? "F12"
            : text == "[" ? "bracketleft" : text == "]" ? "bracketright" : text == "." ? "period" : text == "," ? "comma"
            : text == "`" ? "grave" : text == "/" ? "slash" : text == ";" ? "semicolon" : text == "'" ? "apostrophe"
            : text == "\\" ? "backslash" : text == "=" ? "=" : text == "-" ? "-"
            : text == "!" ? "exclam" : text == "@" ? "at" : text == "#" ? "numbersign" : text == "$" ? "dollar"
            : text == "%" ? "percent" : text == "^" ? "asciicircum" : text == "&" ? "ampersand" : text == "*" ? "asterisk"
            : text == "(" ? "parenleft" : text == ")" ? "parenright" : text == "_" ? "underscore" : text == "+" ? "plus"
            : text == "{" ? "braceleft" : text == "}" ? "braceright" : text == "|" ? "bar" : text == ":" ? "colon"
            : text == "\"" ? "quotedbl" : text == "<" ? "less" : text == ">" ? "greater" : text == "?" ? "question"
            : text == "~" ? "asciitilde"
            : text.character-count == 1 && text.to-uppercase() != text.to-lowercase() ? text.to-uppercase()
            : text.character-count == 1 && text >= "0" && text <= "9" ? text
            : ""
    }
    function start(action: string) {
        if root.recording == action {
            root.stop();
            return;
        }
        root.recording = action;
        root.message = "";
        Compositor.command("shortcut-capture", "true");
        capture.focus();
    }
    function stop() {
        root.recording = "";
        Compositor.command("shortcut-capture", "false");
    }

    capture := FocusScope {
        height: 0px;
        key-pressed(event) => {
            if root.recording == "" {
                return reject;
            }
            if event.text == Key.Escape && !event.modifiers.meta && !event.modifiers.alt {
                root.stop();
                return accept;
            }
            // A modifier alone is the start of a combination.
            if event.text == Key.Shift || event.text == Key.ShiftR || event.text == Key.Control
                || event.text == Key.ControlR || event.text == Key.Alt || event.text == Key.AltGr
                || event.text == Key.Meta || event.text == Key.MetaR {
                return accept;
            }
            let key = root.key-name(event.text);
            if key == "" {
                root.message = @tr("That key cannot be used in a shortcut.");
                return accept;
            }
            if !event.modifiers.meta && !event.modifiers.alt {
                root.message = @tr("Global shortcuts need Super or Alt.");
                return accept;
            }
            let combination = (event.modifiers.meta ? "Meta+" : "") + (event.modifiers.control ? "Ctrl+" : "")
                + (event.modifiers.alt ? "Alt+" : "") + (event.modifiers.shift ? "Shift+" : "") + key;
            let owner = Compositor.shortcut-owner(combination);
            if owner != "" && owner != root.recording {
                root.message = @tr("{} is already used by another action.", combination);
                return accept;
            }
            Compositor.command("shortcuts", "{\"" + root.recording + "\":\"" + combination + "\"}");
            root.message = "";
            root.stop();
            accept
        }
    }
    changed visible => {
        if !self.visible && root.recording != "" { root.stop(); }
    }

    if root.message != "": Rectangle {
        height: note.preferred-height + 20px;
        border-radius: Style.radius-small;
        background: Style.accent-soft;
        note := Text {
            x: 14px;
            width: parent.width - 28px;
            text: root.message;
            color: Style.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
    Group {
        title: @tr("KEYBOARD");
        Setting {
            title: @tr("NumLock on at startup");
            description: @tr("Turns NumLock on when you log in or plug in a keyboard. Also numLock in desktop-preferences.json.");
            Switch {
                on: Compositor.preference-bool("numLock", false, Compositor.preferences-revision);
                toggled => { Compositor.set-preference-bool("numLock", !self.on); }
            }
        }
    }
    Group {
        title: @tr("WINDOWS");
        ShortcutRow { action: "closeWindow"; label: @tr("Close window"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "maximizeWindow"; label: @tr("Maximize window"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "toggleFullscreen"; label: @tr("Fullscreen"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "minimizeWindow"; label: @tr("Minimize window"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "focusLeft"; label: @tr("Focus left"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "focusRight"; label: @tr("Focus right"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "focusUp"; label: @tr("Focus up"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "focusDown"; label: @tr("Focus down"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "reorderLeft"; label: @tr("Move window left"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "reorderRight"; label: @tr("Move window right"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "centerColumn"; label: @tr("Center column"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "widenColumn"; label: @tr("Widen column"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "narrowColumn"; label: @tr("Narrow column"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        Divider { }
        ShortcutRow { action: "toggleScratchpad"; label: @tr("Scratchpad"); recording: root.recording == self.action; change => { root.start(self.action); } }
    }
    Group {
        title: @tr("OPEN");
        ShortcutRow { action: "launchLauncher"; label: @tr("Launcher"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "toggleOverview"; label: @tr("Overview"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "launchTerminal"; label: @tr("Terminal"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "launchFiles"; label: @tr("Files"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "openControlCenter"; label: @tr("Control center"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "openClipboard"; label: @tr("Clipboard"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "openPowerMenu"; label: @tr("Power menu"); recording: root.recording == self.action; change => { root.start(self.action); } }
    }
    Group {
        title: @tr("DESKTOP");
        ShortcutRow { action: "screenshot"; label: @tr("Screenshot"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "chooseWallpaper"; label: @tr("Wallpapers"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "randomWallpaper"; label: @tr("Random wallpaper"); recording: root.recording == self.action; change => { root.start(self.action); } }
        Divider { }
        ShortcutRow { action: "toggleEyeCare"; label: @tr("Eye care"); recording: root.recording == self.action; change => { root.start(self.action); } }
    }
    HorizontalLayout {
        alignment: end;
        padding-bottom: Style.spacing-lg;
        TextButton {
            text: @tr("Restore defaults");
            clicked => {
                root.stop();
                root.message = "";
                Compositor.command("reset-shortcuts", "");
            }
        }
    }
}

component DisplayPage inherits Page {
    title: @tr("Display");
    subtitle: @tr("Brightness, night light and the pointer.");
    property <int> revision: Compositor.preferences-revision;
    if Brightness.available: Group {
        title: @tr("BRIGHTNESS");
        Setting {
            title: @tr("Screen brightness");
            RangeSlider {
                minimum: 2; maximum: 100; step: 1; unit: "%"; track-width: 200px;
                value: Math.round(Brightness.level * 100);
                committed(v) => { Brightness.set(v / 100); }
            }
        }
    }
    Group {
        title: @tr("NIGHT LIGHT");
        Setting {
            title: @tr("Night light");
            description: @tr("Warmer colours that are easier on the eyes in the evening (Super+N).");
            Switch { on: Compositor.preference-bool("eyeCare", false, root.revision); toggled => { Compositor.set-preference-bool("eyeCare", !self.on); } }
        }
        Divider { }
        Setting {
            title: @tr("Colour temperature");
            RangeSlider { minimum: 2500; maximum: 6500; step: 100; unit: "K"; track-width: 200px; value: Compositor.preference-number("eyeCareTemperature", 4500, root.revision); committed(v) => { Compositor.set-preference-number("eyeCareTemperature", v); } }
        }
    }
    Group {
        title: @tr("POINTER");
        Setting {
            title: @tr("Cursor size");
            description: @tr("Takes effect after signing in again.");
            Segmented {
                property <int> size: Compositor.preference-number("cursorSize", 24, root.revision);
                labels: ["24", "32", "48"];
                selected: self.size >= 48 ? 2 : self.size >= 32 ? 1 : 0;
                chosen(i) => { Compositor.set-preference-number("cursorSize", i == 2 ? 48 : i == 1 ? 32 : 24); }
            }
        }
    }
}

component NotificationsPage inherits Page {
    title: @tr("Notifications");
    if !Notifications.available: Text {
        text: @tr("Another notification daemon is running. Stop it to use LunaDash notifications.");
        color: Style.warning;
        wrap: word-wrap;
    }
    Group {
        Setting { title: @tr("Pop-ups"); description: @tr("Show new notifications in the corner."); Switch { on: Prefs.toasts; toggled => { Store.set-bool("toasts", !Prefs.toasts); } } }
        Divider { }
        Setting { title: @tr("Do not disturb"); description: @tr("Only critical notifications pop up."); Switch { on: Notifications.do-not-disturb; toggled => { Notifications.set-do-not-disturb(!Notifications.do-not-disturb); } } }
        Divider { }
        Setting {
            title: @tr("Position");
            Segmented {
                labels: [@tr("Top right"), @tr("Top centre"), @tr("Bottom right")];
                selected: Prefs.toast-position == "top-center" ? 1 : Prefs.toast-position == "bottom-right" ? 2 : 0;
                chosen(i) => { Store.set-string("toast-position", i == 1 ? "top-center" : i == 2 ? "bottom-right" : "top-right"); }
            }
        }
        Divider { }
        Setting {
            title: @tr("Pop-up duration");
            Segmented {
                labels: ["3 s", "5 s", "10 s"];
                selected: Prefs.toast-seconds == 3 ? 0 : Prefs.toast-seconds == 10 ? 2 : 1;
                chosen(i) => {
                    Store.set-number("toast-seconds", i == 0 ? 3 : i == 2 ? 10 : 5);
                    Notifications.set-default-timeout(Prefs.toast-seconds * 1s);
                }
            }
        }
    }
    Group {
        title: @tr("LAUNCHER");
        Setting {
            title: @tr("Launcher layout");
            Segmented {
                labels: [@tr("Comfortable"), @tr("Compact")];
                selected: Prefs.launcher-density == "compact" ? 1 : 0;
                chosen(i) => { Store.set-string("launcher-density", i == 1 ? "compact" : "comfortable"); }
            }
        }
    }
}

component PowerPage inherits Page {
    title: @tr("Power & lock");
    Group {
        Setting {
            title: @tr("Lock after inactivity");
            Segmented {
                labels: [@tr("Never"), "5 min", "10 min", "30 min"];
                selected: Prefs.lock-after-minutes == 0 ? 0 : Prefs.lock-after-minutes == 5 ? 1 : Prefs.lock-after-minutes == 30 ? 3 : 2;
                chosen(i) => {
                    Store.set-number("lock-after-minutes", i == 0 ? 0 : i == 1 ? 5 : i == 3 ? 30 : 10);
                    Idle.set-lock-after(Prefs.lock-after-minutes * 60s);
                }
            }
        }
        Divider { }
        Setting {
            title: @tr("Lock before sleep");
            Switch {
                on: Prefs.lock-before-sleep;
                toggled => {
                    Store.set-bool("lock-before-sleep", !Prefs.lock-before-sleep);
                    Session.set-lock-before-sleep(Prefs.lock-before-sleep);
                }
            }
        }
        Divider { }
        Setting { title: @tr("Keep the screen awake"); description: @tr("Until LunaDash restarts."); Switch { on: Idle.inhibited; toggled => { Idle.set-inhibited(!Idle.inhibited); } } }
        Divider { }
        Setting { title: @tr("Lock now"); TextButton { icon: "lock"; text: @tr("Lock"); clicked => { UI.close-all(); Session.lock(); } } }
    }
}

component LanguagePage inherits Page {
    title: @tr("Language");
    Group {
        ListRow {
            icon: "language";
            title: I18n.language-name("");
            selected: I18n.language == "";
            clicked => { Apply.choose-language(""); }
        }
        for language in I18n.languages: ListRow {
            icon: "language";
            title: I18n.language-name(language);
            subtitle: language;
            selected: I18n.language == language;
            clicked => { Apply.choose-language(language); }
        }
    }
}

component AboutPage inherits Page {
    title: @tr("About");
    Card {
        height: 132px;
        clip: true;
        Rectangle {
            background: @linear-gradient(120deg, Style.accent.with-alpha(0.22) 0%, transparent 70%);
        }
        HorizontalLayout {
            padding: Style.spacing-xl;
            spacing: Style.spacing-lg;
            Image {
                source: @image-url("../assets/lunadash.png");
                width: 84px;
                height: 84px;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: "LunaDash"; color: Style.text; font-size: 28px; font-weight: 700; }
                Text { text: @tr("Desktop shell written in Slint, running on SlintLu {}", Shell.version); color: Style.muted; wrap: word-wrap; }
            }
        }
    }
    Rectangle { height: Style.spacing-lg; }
    Group {
        title: @tr("SYSTEM");
        for row in [
            { label: @tr("System"), value: System.os },
            { label: @tr("Kernel"), value: System.kernel },
            { label: @tr("Host"), value: System.hostname },
            { label: @tr("Compositor"), value: Compositor.name },
            { label: @tr("Renderer"), value: Shell.renderer },
            { label: @tr("Memory"), value: System.memory-text },
            { label: @tr("Uptime"), value: System.uptime },
        ]: HorizontalLayout {
            height: 36px;
            Text { text: row.label; color: Style.muted; width: 160px; vertical-alignment: center; }
            Text { text: row.value; color: Style.text; vertical-alignment: center; overflow: elide; }
        }
    }
    HorizontalLayout {
        spacing: Style.spacing-sm;
        alignment: start;
        TextButton { text: @tr("Show welcome"); clicked => { UI.open-overlay("welcome"); } }
        TextButton { text: @tr("Reload shell"); clicked => { Shell.reload(); } }
    }
}

export component Settings inherits Overlay {
    name: "settings";
    namespace: "lunadash-settings";
    content-width: 1000px;
    content-height: 700px;

    property <[{id: string, icon: string, label: string, lunadash: bool}]> pages: [
        { id: "account", icon: "user", label: @tr("Account"), lunadash: false },
        { id: "appearance", icon: "palette", label: @tr("Appearance"), lunadash: false },
        { id: "wallpaper", icon: "image", label: @tr("Wallpaper"), lunadash: false },
        { id: "panel", icon: "panel", label: @tr("Panel"), lunadash: false },
        { id: "dock", icon: "dock", label: @tr("Dock"), lunadash: false },
        { id: "menu", icon: "list", label: @tr("Desktop menu"), lunadash: false },
        { id: "windows", icon: "window", label: @tr("Windows"), lunadash: true },
        { id: "shortcuts", icon: "keyboard", label: @tr("Keyboard shortcuts"), lunadash: true },
        { id: "display", icon: "monitor", label: @tr("Display"), lunadash: true },
        { id: "notifications", icon: "bell", label: @tr("Notifications"), lunadash: false },
        { id: "power", icon: "power", label: @tr("Power & lock"), lunadash: false },
        { id: "language", icon: "language", label: @tr("Language"), lunadash: false },
        { id: "about", icon: "info", label: @tr("About"), lunadash: false },
    ];

    HorizontalLayout {
        Rectangle {
            width: 240px;
            background: transparent;
            VerticalLayout {
                padding: Style.spacing-lg;
                spacing: 2px;
                alignment: start;
                HorizontalLayout {
                    padding-bottom: Style.spacing-lg;
                    spacing: 10px;
                    Image { source: @image-url("../assets/lunadash-mark.svg"); width: 30px; height: 30px; image-fit: contain; }
                    Text { text: @tr("Settings"); color: Style.text; font-size: Style.font-title; font-weight: 600; vertical-alignment: center; }
                }
                for page in root.pages: ListRow {
                    visible: !page.lunadash || Compositor.has-commands;
                    height: self.visible ? 44px : 0px;
                    icon: page.icon;
                    title: page.label;
                    selected: UI.settings-page == page.id;
                    clicked => { UI.open-settings(page.id); }
                }
            }
        }
        Flickable {
            horizontal-stretch: 1;
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding: Style.spacing-xl;
                if UI.settings-page == "account": Reveal { AccountPage { } }
                if UI.settings-page == "appearance": Reveal { AppearancePage { } }
                if UI.settings-page == "wallpaper": Reveal { WallpaperPage { } }
                if UI.settings-page == "panel": Reveal { PanelPage { } }
                if UI.settings-page == "dock": Reveal { DockPage { } }
                if UI.settings-page == "menu": Reveal { DesktopMenuPage { } }
                if UI.settings-page == "windows": Reveal { WindowsPage { } }
                if UI.settings-page == "shortcuts": Reveal { ShortcutsPage { } }
                if UI.settings-page == "display": Reveal { DisplayPage { } }
                if UI.settings-page == "notifications": Reveal { NotificationsPage { } }
                if UI.settings-page == "power": Reveal { PowerPage { } }
                if UI.settings-page == "language": Reveal { LanguagePage { } }
                if UI.settings-page == "about": Reveal { AboutPage { } }
            }
        }
        IconButton { icon: "close"; size: 34px; y: 14px; clicked => { UI.close-all(); } }
        Rectangle { width: 10px; }
    }
}
