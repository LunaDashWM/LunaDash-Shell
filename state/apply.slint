// Applies the stored preferences to SlintLu's shell-wide services.

import { Theme, Idle, Session, Notifications, I18n, Compositor, Store } from "@slintlu";
import { Prefs } from "prefs.slint";
import { Style } from "../style/style.slint";

// Applies the stored preferences to the shell-wide services (once, from the primary screen).
export global Apply {
    public function theme() {
        Theme.set-mode(Prefs.theme-mode);
        if Prefs.palette != "" {
            Theme.set-palette(Prefs.palette);
        }
    }
    public function all() {
        root.theme();
        Idle.set-lock-after(Prefs.lock-after-minutes * 60s);
        Session.set-lock-before-sleep(Prefs.lock-before-sleep);
        Notifications.set-default-timeout(Prefs.toast-seconds * 1s);
        root.language();
    }
    // "auto", "dark" or "light", for the shell and, on LunaDash, the whole desktop (portal
    // colour scheme, application themes).
    public function set-theme-mode(mode: string) {
        Store.set-string("theme-mode", mode);
        Theme.set-mode(mode);
        if Compositor.has-commands {
            Compositor.set-preference-string("themeMode", mode);
        }
    }
    // An accent from Style.accents (-1: the palette's own); LunaDash uses it too.
    public function set-accent(index: int) {
        Store.set-number("accent", index);
        if Compositor.has-commands && index >= 0 && index < Style.accent-hex.length {
            Compositor.set-preference-string("accent", Style.accent-hex[index]);
        }
    }
    public function set-animations(on: bool) {
        Store.set-bool("animations", on);
        if Compositor.has-commands {
            Compositor.set-preference-bool("animations", on);
        }
    }

    // LunaDash's desktop language when the compositor has one ("en_US" means the untranslated
    // English texts), else the shell's own choice.
    public function language() {
        if Compositor.language != "" {
            I18n.set-language(Compositor.language == "en_US" ? "" : Compositor.language);
        } else if Prefs.language != "" {
            I18n.set-language(Prefs.language);
        }
    }
    // Chooses a language ("" for English): on LunaDash for the whole desktop.
    public function choose-language(language: string) {
        if Compositor.has-commands {
            Compositor.command("language", language == "" ? "en_US" : language);
        } else {
            if language == "" {
                Store.remove("language");
            } else {
                Store.set-string("language", language);
            }
            I18n.set-language(language);
        }
    }
}
