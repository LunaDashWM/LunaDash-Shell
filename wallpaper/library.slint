// The wallpaper library (Super+W): LunaDash's wallpaper folder and bundled wallpapers. A quiet
// header to switch between the library, the bundled wallpapers and favourites, chips for the
// categories, a grid of rounded previews and a search field floating at the bottom.

import { Compositor, WallpaperInfo, Shell } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { UI } from "../state/ui.slint";
import { Apply } from "../state/apply.slint";
import { Overlay } from "../components/overlay.slint";
import { Icon } from "../components/icon.slint";
import { TextButton, IconButton } from "../components/controls.slint";
import { Picture } from "../components/picture.slint";
import { Wallpapers } from "wallpaper.slint";

// A pill with an icon and a label; the selected one is filled.
component Choice inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: root.selected ? Style.accent : touch.has-hover ? Style.hover : transparent;
    animate background { duration: Style.motion-fast; }
    row := HorizontalLayout {
        padding-left: root.label == "" ? 10px : root.icon != "" ? 12px : 14px;
        padding-right: root.label == "" ? 10px : 14px;
        spacing: 6px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            name: root.icon;
            width: 16px;
            height: 16px;
            color: root.selected ? Style.accent-ink : Style.text;
        }
        if root.label != "": Text {
            text: root.label;
            color: root.selected ? Style.accent-ink : Style.text;
            font-size: Style.font-small;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Choices side by side on one tonal track.
component ChoiceGroup inherits Rectangle {
    height: 42px;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: Style.surface;
    row := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        @children
    }
}

// A category filter: text only, filled tonally when chosen.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 30px;
    width: text.preferred-width + 26px;
    border-radius: 15px;
    background: root.selected ? Style.tonal : touch.has-hover ? Style.hover : transparent;
    border-width: root.selected ? 0px : 1px;
    border-color: Style.hairline;
    animate background { duration: Style.motion-fast; }
    text := Text {
        text: root.label;
        color: root.selected ? Style.on-tonal : Style.muted;
        font-size: Style.font-small;
        font-weight: root.selected ? 600 : 400;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A wallpaper: its picture with rounded corners; the
// name and the favourite star appear on hover, the current one wears a ring and a check.
component Tile inherits Rectangle {
    in property <WallpaperInfo> entry;
    in property <bool> selected;
    callback clicked();
    callback favorite();
    property <length> round: Style.radius-medium + 4px;
    property <bool> hovered: touch.has-hover || star.has-hover;
    border-radius: root.round;
    background: Style.surface;
    preview := Picture { path: root.entry.preview; radii: [root.round, root.round, root.round, root.round]; }
    if !preview.loaded: Icon { name: root.entry.video ? "video" : "image"; width: 26px; height: 26px; color: Style.muted; }
    // The name on a shade along the bottom.
    Rectangle {
        y: parent.height - self.height;
        height: 44px;
        border-bottom-left-radius: root.round;
        border-bottom-right-radius: root.round;
        background: @linear-gradient(180deg, #00000000 0%, #000000b0 100%);
        opacity: root.hovered ? 1 : 0;
        animate opacity { duration: Style.motion-fast; }
        Text {
            x: 12px;
            y: parent.height - self.height - 8px;
            width: parent.width - 52px;
            text: root.entry.name;
            color: #ffffff;
            font-size: Style.font-small;
            font-weight: 500;
            overflow: elide;
        }
    }
    if root.entry.video: Rectangle {
        x: 8px;
        y: 8px;
        width: live.preferred-width + 14px;
        height: 22px;
        border-radius: 11px;
        background: #000000a0;
        live := HorizontalLayout {
            alignment: center;
            spacing: 4px;
            Icon { name: "play"; width: 10px; height: 10px; y: (parent.height - self.height) / 2; color: #ffffff; }
            Text { text: @tr("Live"); color: #ffffff; font-size: 10px; vertical-alignment: center; }
        }
    }
    // The current wallpaper.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.round + 3px;
        border-width: root.selected ? 3px : touch.has-hover ? 1px : 0px;
        border-color: root.selected ? Style.accent : Style.border;
    }
    if root.selected: Rectangle {
        x: parent.width - self.width - 8px;
        y: 8px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Style.accent;
        Icon { name: "check"; width: 15px; height: 15px; color: Style.accent-ink; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    // Favourite, above the tile's own click area.
    Rectangle {
        x: parent.width - self.width - 6px;
        y: parent.height - self.height - 6px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: star.has-hover ? #00000099 : transparent;
        visible: root.hovered || root.entry.favorite;
        Icon { name: "star"; width: 16px; height: 16px; color: root.entry.favorite ? #ffd36b : #ffffff; }
        star := TouchArea { clicked => { root.favorite(); } }
    }
}

export component WallpaperLibrary inherits Overlay {
    name: "wallpapers";
    namespace: "lunadash-wallpaper-library";
    content-width: 1040px;
    content-height: 700px;

    property <string> collection: "library";
    property <int> category-index: 0;
    property <string> kind: "all";
    property <bool> edit-directory;
    property <[string]> categories: Compositor.wallpaper-categories;
    property <string> category: root.category-index > 0 && root.category-index <= root.categories.length ? root.categories[root.category-index - 1] : "";
    property <[WallpaperInfo]> entries: Compositor.filter-wallpapers(search.text, root.collection, root.category, root.kind, Compositor.wallpapers.length);
    property <int> columns: 4;

    changed shown => {
        if self.shown {
            search.text = "";
            search.focus();
        }
    }

    VerticalLayout {
        padding: Style.spacing-xl;
        padding-bottom: Style.spacing-lg;
        spacing: Style.spacing-md;
        // Title, collections and actions
        HorizontalLayout {
            spacing: Style.spacing-md;
            Rectangle {
                width: 40px;
                height: 40px;
                y: (parent.height - self.height) / 2;
                border-radius: 14px * Style.corner-scale;
                background: Style.tonal;
                Icon { name: "image"; width: 20px; height: 20px; color: Style.on-tonal; }
            }
            VerticalLayout {
                alignment: center;
                Text { text: @tr("Wallpapers"); color: Style.text; font-size: Style.font-title; font-weight: 600; }
                Text {
                    text: root.entries.length == 1 ? @tr("1 wallpaper") : @tr("{} wallpapers", root.entries.length);
                    color: Style.muted;
                    font-size: Style.font-small;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            ChoiceGroup {
                y: (parent.height - self.height) / 2;
                Choice {
                    icon: "folder";
                    label: @tr("Library");
                    selected: root.collection == "library";
                    clicked => {
                        root.collection = "library";
                        root.category-index = 0;
                    }
                }
                Choice {
                    icon: "diamond";
                    label: @tr("Bundled");
                    selected: root.collection == "bundled";
                    clicked => {
                        root.collection = "bundled";
                        root.category-index = 0;
                    }
                }
                Choice {
                    icon: "star";
                    label: @tr("Favorites");
                    selected: root.collection == "favorites";
                    clicked => {
                        root.collection = "favorites";
                        root.category-index = 0;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: Style.spacing-xs;
                IconButton { icon: "shuffle"; size: 38px; y: (parent.height - self.height) / 2; clicked => { Compositor.command("wallpaper-random", ""); } }
                IconButton { icon: "folder"; size: 38px; active: root.edit-directory; y: (parent.height - self.height) / 2; clicked => { root.edit-directory = !root.edit-directory; } }
                IconButton { icon: "close"; size: 38px; y: (parent.height - self.height) / 2; clicked => { UI.close-all(); } }
            }
        }
        // The library's folder, rescanning it, and browsing other folders.
        if root.edit-directory: Rectangle {
            height: 48px;
            border-radius: 24px;
            background: Style.surface;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 6px;
                spacing: 8px;
                Icon { name: "folder"; width: 16px; height: 16px; y: (parent.height - self.height) / 2; color: Style.muted; }
                directory := TextInput {
                    // Re-created whenever the row opens, starting from the current folder.
                    text: Compositor.wallpaper-directory;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    color: Style.text;
                    single-line: true;
                    accepted => { Wallpapers.set-library(self.text); }
                }
                TextButton { horizontal-stretch: 0; y: (parent.height - self.height) / 2; text: @tr("Save folder"); clicked => { Wallpapers.set-library(directory.text); } }
                TextButton { horizontal-stretch: 0; y: (parent.height - self.height) / 2; icon: "folder"; text: @tr("Choose…"); clicked => { Wallpapers.pick-library(); } }
                IconButton { y: (parent.height - self.height) / 2; icon: "reboot"; size: 36px; clicked => { Compositor.command("wallpaper-refresh", ""); } }
                IconButton { y: (parent.height - self.height) / 2; icon: "grid"; size: 36px; clicked => { UI.open-overlay("gallery"); } }
            }
        }
        // Categories, and what kind of wallpaper and theme
        HorizontalLayout {
            spacing: Style.spacing-md;
            Flickable {
                horizontal-stretch: 1;
                height: 36px;
                content-width: chips.preferred-width;
                chips := HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Chip { label: @tr("All categories"); selected: root.category-index == 0; clicked => { root.category-index = 0; } }
                    for name[i] in root.categories: Chip {
                        label: name == "Bundled" ? @tr("Bundled") : name;
                        selected: root.category-index == i + 1;
                        clicked => { root.category-index = i + 1; }
                    }
                }
            }
            ChoiceGroup {
                height: 36px;
                Choice { height: 28px; label: @tr("All"); selected: root.kind == "all"; clicked => { root.kind = "all"; } }
                Choice { height: 28px; icon: "image"; label: @tr("Static"); selected: root.kind == "image"; clicked => { root.kind = "image"; } }
                Choice { height: 28px; icon: "video"; label: @tr("Live"); selected: root.kind == "video"; clicked => { root.kind = "video"; } }
            }
            ChoiceGroup {
                height: 36px;
                for mode in [{ id: "dark", icon: "moon" }, { id: "light", icon: "sun" }, { id: "auto", icon: "monitor" }]: Choice {
                    height: 28px;
                    icon: mode.icon;
                    selected: Prefs.theme-mode == mode.id;
                    clicked => { Apply.set-theme-mode(mode.id); }
                }
            }
        }
        // The grid, with the search field floating over its bottom edge.
        Rectangle {
            vertical-stretch: 1;
            Flickable {
                property <length> gap: 14px;
                property <length> cell-width: (self.width - (root.columns - 1) * self.gap) / root.columns;
                property <length> cell-height: self.cell-width * 0.625;
                // Room below the last row for the search field.
                content-height: Math.ceil(root.entries.length / root.columns) * (self.cell-height + self.gap) + 84px;
                for entry[i] in root.entries: Tile {
                    x: Math.mod(i, root.columns) * (parent.cell-width + parent.gap);
                    y: Math.floor(i / root.columns) * (parent.cell-height + parent.gap) + 4px;
                    width: parent.cell-width;
                    height: parent.cell-height;
                    entry: entry;
                    selected: entry.path == Wallpapers.path;
                    clicked => { Wallpapers.choose(entry.path); }
                    favorite => { Wallpapers.set-favorite(entry.path, !entry.favorite); }
                }
                if root.entries.length == 0: VerticalLayout {
                    width: parent.width;
                    height: 260px;
                    alignment: center;
                    spacing: Style.spacing-sm;
                    Icon { x: (parent.width - self.width) / 2; name: "image"; width: 36px; height: 36px; color: Style.muted; }
                    Text { text: @tr("No matching wallpapers"); color: Style.text; font-size: 18px; horizontal-alignment: center; }
                    Text {
                        text: @tr("Drop images or videos into your library folder, then press Super+W.");
                        color: Style.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - Style.spacing-lg;
                width: min(460px, parent.width - 40px);
                height: 48px;
                border-radius: 24px;
                background: Style.glass-strong;
                border-width: 1px;
                border-color: search.has-focus ? Style.accent.with-alpha(0.6) : Style.hairline;
                drop-shadow-blur: 18px;
                drop-shadow-color: Style.shadow;
                drop-shadow-offset-y: 4px;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 10px;
                    Icon { name: "search"; width: 17px; height: 17px; y: (parent.height - self.height) / 2; color: Style.muted; }
                    Rectangle {
                        horizontal-stretch: 1;
                        search := TextInput {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            color: Style.text;
                            single-line: true;
                            accepted => {
                                if root.entries.length > 0 {
                                    Wallpapers.choose(root.entries[0].path);
                                }
                            }
                            key-pressed(event) => {
                                if event.text == Key.Escape {
                                    if self.text != "" {
                                        self.text = "";
                                    } else {
                                        UI.close-all();
                                    }
                                    return accept;
                                }
                                reject
                            }
                        }
                        if search.text == "" && !(search.has-focus && Shell.composing): Text {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            text: @tr("Search wallpapers…");
                            color: Style.muted;
                        }
                    }
                }
            }
        }
    }
}
