// The wallpaper, with an optional large clock in the corner.

import { PanelWindow, Layer, ExclusiveMode, Files, Compositor, Store } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { Time } from "../state/time.slint";

export global Wallpapers {
    // The bundled default wallpaper.
    out property <image> default: @image-url("../assets/wallpapers/florist.png");
    // On LunaDash the compositor owns the wallpaper (its settings, shortcuts and random
    // wallpaper all change it); elsewhere the shell keeps its own choice.
    out property <bool> managed: Compositor.has-commands;
    out property <string> path: root.managed ? Compositor.wallpaper : Prefs.wallpaper;
    public pure function current() -> image {
        root.path != "" && Files.exists(root.path) ? Files.image(root.path) : root.default
    }
    public function choose(path: string) {
        if root.managed {
            Compositor.command("wallpaper-image", path);
        } else {
            Store.set-string("wallpaper", path);
        }
    }
    public function choose-default() {
        if root.managed {
            Compositor.command("wallpaper-default", "");
        } else {
            Store.remove("wallpaper");
        }
    }
}

export component Wallpaper inherits PanelWindow {
    namespace: "lunadash-wallpaper";
    layer: Layer.background;
    exclusive-mode: ExclusiveMode.ignore;
    anchor-top: true;
    anchor-bottom: true;
    anchor-left: true;
    anchor-right: true;
    default-font-family: Style.font;

    Rectangle { background: Style.base; }
    Image {
        width: parent.width;
        height: parent.height;
        source: Wallpapers.current();
        image-fit: cover;
    }
    if Prefs.desktop-clock: VerticalLayout {
        x: 56px;
        y: parent.height - self.preferred-height - 96px;
        spacing: 0px;
        Text {
            text: Time.clock;
            color: #ffffff;
            font-size: 96px;
            font-weight: 200;
            stroke: #00000030;
            stroke-width: 1px;
        }
        Text {
            text: Time.long-date;
            color: #ffffffd8;
            font-size: 22px;
            font-weight: 500;
        }
    }
}
