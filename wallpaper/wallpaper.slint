// The wallpaper, with an optional large clock in the corner.

import { PanelWindow, Layer, ExclusiveMode, Files, Compositor, Store, Shared } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { Time } from "../state/time.slint";
import { UI } from "../state/ui.slint";

export global Wallpapers {
    // The bundled default wallpaper.
    out property <image> default: @image-url("../assets/wallpapers/florist.png");
    // On LunaDash the compositor owns the wallpaper (its settings, shortcuts and random
    // wallpaper all change it); elsewhere the shell keeps its own choice.
    out property <bool> managed: Compositor.has-commands;
    out property <string> path: root.managed ? Compositor.wallpaper : Prefs.wallpaper;
    // Video wallpapers need the compositor: LunaDash plays them below the shell.
    out property <bool> video: root.managed && Files.kind(root.path) == "video";
    // The compositor is playing the video: the wallpaper window stays transparent.
    out property <bool> live: root.video && Compositor.wallpaper-live;
    // Files the gallery offers: videos only where they can play.
    out property <string> extensions: root.managed ? "png,jpg,jpeg,webp,bmp,gif,mp4,webm,mkv,mov,m4v" : "png,jpg,jpeg,webp,bmp,gif";

    public pure function current() -> image {
        if root.video {
            return Compositor.wallpaper-poster != "" ? Files.image(Compositor.wallpaper-poster) : root.default;
        }
        root.path != "" && Files.exists(root.path) ? Files.image(root.path) : root.default
    }
    public function choose(path: string) {
        if root.managed {
            Compositor.command("wallpaper-image", path);
        } else {
            Store.set-string("wallpaper", path);
        }
    }
    public function choose-default() {
        if root.managed {
            Compositor.command("wallpaper-default", "");
        } else {
            Store.remove("wallpaper");
        }
    }
    // Opens the desktop's file chooser; `Wallpaper` applies what the user picks.
    public function pick-file() {
        Shared.set-string("wallpaper-pick", "file");
        Files.choose(@tr("Choose a wallpaper"), root.extensions, false, Prefs.wallpaper-dir);
    }
    public function pick-folder() {
        Shared.set-string("wallpaper-pick", "folder");
        Files.choose(@tr("Choose a wallpaper folder"), "", true, Prefs.wallpaper-dir);
    }
    // LunaDash's wallpaper library folder (Super+W), rescanned right away.
    public function set-library(path: string) {
        if root.managed && path != "" {
            Compositor.set-preference-string("wallpaperDirectory", path);
            Compositor.command("wallpaper-refresh", "");
        }
    }
    public function pick-library() {
        Shared.set-string("wallpaper-pick", "library");
        Files.choose(@tr("Choose the wallpaper library folder"), "", true, Compositor.wallpaper-directory);
    }
    public function set-favorite(path: string, favorite: bool) {
        Compositor.command("wallpaper-favorite", (favorite ? "add:" : "remove:") + path);
    }
    // A picked or typed path: folders are browsed, images and videos become the wallpaper.
    public function open(path: string) {
        if Files.kind(path) == "directory" {
            Store.set-string("wallpaper-dir", path);
        } else if Files.kind(path) == "image" || (Files.kind(path) == "video" && root.managed) {
            root.choose(path);
            Store.set-string("wallpaper-dir", Files.parent(path));
        }
    }
}

export component Wallpaper inherits PanelWindow {
    namespace: "lunadash-wallpaper";
    layer: Layer.background;
    exclusive-mode: ExclusiveMode.ignore;
    anchor-top: true;
    anchor-bottom: true;
    anchor-left: true;
    anchor-right: true;
    default-font-family: Style.font;

    // The file chooser answers asynchronously; one window applies the choice.
    property <int> chosen-serial: Files.chosen-serial;
    changed chosen-serial => {
        if UI.primary && Shared.get-string("wallpaper-pick", "", Shared.revision) != "" {
            if Shared.get-string("wallpaper-pick", "", Shared.revision) == "library" {
                Wallpapers.set-library(Files.chosen);
            } else {
                Wallpapers.open(Files.chosen);
            }
            Shared.set-string("wallpaper-pick", "");
        }
    }

    // A playing video wallpaper shows through.
    Rectangle { background: Wallpapers.live ? transparent : Style.base; }
    if !Wallpapers.live: Image {
        width: parent.width;
        height: parent.height;
        source: Wallpapers.current();
        image-fit: Prefs.wallpaper-fit == "contain" ? ImageFit.contain : Prefs.wallpaper-fit == "fill" ? ImageFit.fill : ImageFit.cover;
    }
    if Prefs.wallpaper-dim > 0: Rectangle { background: #000000.with-alpha(Prefs.wallpaper-dim / 100); }
    if Prefs.desktop-clock: clock := VerticalLayout {
        property <float> size: Prefs.desktop-clock-size == "small" ? 0.5 : Prefs.desktop-clock-size == "medium" ? 0.75 : 1.0;
        property <bool> at-right: Prefs.desktop-clock-position == "bottom-right";
        property <bool> at-center: Prefs.desktop-clock-position == "center";
        property <bool> at-top: Prefs.desktop-clock-position == "top-left";
        // Centred and right-aligned clocks span the width and align their text.
        x: self.at-center || self.at-right ? 0px : 56px;
        width: self.at-center ? parent.width : self.at-right ? parent.width - 56px : self.preferred-width;
        height: self.preferred-height;
        y: self.at-center ? (parent.height - self.preferred-height) / 2
            : self.at-top ? Style.panel-height + 56px : parent.height - self.preferred-height - 96px;
        spacing: 0px;
        Text {
            text: Time.clock;
            color: #ffffff;
            font-size: 96px * clock.size;
            font-weight: 200;
            stroke: #00000030;
            stroke-width: 1px;
            horizontal-alignment: clock.at-right ? TextHorizontalAlignment.right : clock.at-center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
        }
        if Prefs.desktop-clock-date: Text {
            text: Time.long-date;
            color: #ffffffd8;
            font-size: 22px * max(0.7, clock.size);
            font-weight: 500;
            horizontal-alignment: clock.at-right ? TextHorizontalAlignment.right : clock.at-center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
        }
    }
}
