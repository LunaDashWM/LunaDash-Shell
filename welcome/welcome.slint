// A short introduction, shown once on the first start: the project and its author at the
// top, the keyboard shortcuts to get around below.

import { Store, Compositor, Shell } from "@slintlu";
import { Style } from "../style/style.slint";
import { UI } from "../state/ui.slint";
import { Overlay } from "../components/overlay.slint";
import { Icon } from "../components/icon.slint";
import { TextButton, Card, SectionTitle, Keycap } from "../components/controls.slint";

// The project's author, shown in the header with a link to their GitHub profile.
global Author {
    out property <string> name: "LuYishan";
    out property <string> github: "github.com/LuYishan-4";
}

// Used where the compositor does not report its shortcuts (anything but LunaDash).
component Tip inherits Card {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    HorizontalLayout {
        padding: Style.spacing-md;
        spacing: Style.spacing-md;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Style.accent-soft;
            Icon { name: root.icon; width: 20px; height: 20px; color: Style.accent; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; color: Style.text; font-weight: 600; }
            Text { text: root.text; color: Style.muted; font-size: Style.font-small; wrap: word-wrap; }
        }
    }
}

// A labelled shortcut with the keys LunaDash currently binds to `action`.
component ShortcutPreview inherits Card {
    in property <string> action;
    in property <string> label;
    in property <string> icon;
    height: 46px;
    HorizontalLayout {
        padding-left: Style.spacing-md;
        padding-right: Style.spacing-sm;
        spacing: Style.spacing-sm;
        Icon { name: root.icon; width: 16px; height: 16px; y: (parent.height - self.height) / 2; color: Style.accent; }
        Text {
            text: root.label;
            color: Style.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // The first keys bound to the action; reading the bindings follows their changes.
        HorizontalLayout {
            alignment: end;
            spacing: Style.spacing-xs;
            for key in Compositor.bindings.length >= 0 ? Compositor.keys-for("normal", root.action) : []:
                Keycap { key: key; y: (parent.height - self.height) / 2; }
        }
    }
}

export component Welcome inherits Overlay {
    name: "welcome";
    namespace: "lunadash-welcome";
    content-width: 680px;
    content-height: 500px;

    // Seen: not shown again, and LunaDash's first-run setup is complete, so later
    // sessions start the user's startup applications.
    function finish() {
        Store.set-bool("welcome-done", true);
        if Compositor.has-commands {
            Compositor.command("finish-setup", "");
        }
    }
    function done() {
        root.finish();
        UI.close-all();
    }
    escape => { root.done(); }

    VerticalLayout {
        padding: Style.spacing-xl;
        spacing: Style.spacing-md;

        // The project on the left, its author on the right.
        HorizontalLayout {
            spacing: Style.spacing-lg;
            // 128 px, scaled with a good filter: drawing the 512 px logo at 64 px aliased it.
            Image {
                source: @image-url("../assets/lunadash-128.png");
                width: 64px;
                height: 64px;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: @tr("Welcome to LunaDash"); color: Style.text; font-size: 26px; font-weight: 700; overflow: elide; }
                Text { text: @tr("Here is how to get around."); color: Style.muted; overflow: elide; }
            }
            HorizontalLayout {
                spacing: Style.spacing-md;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: @tr("Author"); color: Style.muted; font-size: Style.font-small; horizontal-alignment: right; }
                    Text { text: Author.name; color: Style.text; font-weight: 600; horizontal-alignment: right; }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        link-touch := TouchArea {
                            width: 20px;
                            height: 20px;
                            mouse-cursor: pointer;
                            Icon {
                                name: "globe";
                                width: 16px;
                                height: 16px;
                                color: link-touch.has-hover ? Style.text : Style.accent;
                            }
                            clicked => { Shell.exec("xdg-open https://" + Author.github); }
                        }
                    }
                }
                Rectangle {
                    width: 56px;
                    height: 56px;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: Style.accent-soft;
                    clip: true;
                    Image {
                        source: @image-url("../assets/author-avatar.png");
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                }
            }
        }

        if Compositor.bindings.length > 0: VerticalLayout {
            spacing: Style.spacing-sm;
            SectionTitle { text: @tr("KEYBOARD SHORTCUTS"); }
            HorizontalLayout {
                spacing: Style.spacing-sm;
                VerticalLayout {
                    spacing: Style.spacing-sm;
                    horizontal-stretch: 1;
                    ShortcutPreview { action: "toggle-launcher"; label: @tr("Launcher"); icon: "apps"; }
                    ShortcutPreview { action: "toggle-overview"; label: @tr("Overview"); icon: "grid"; }
                    ShortcutPreview { action: "spawn-default terminal"; label: @tr("Terminal"); icon: "terminal"; }
                    ShortcutPreview { action: "spawn-default files"; label: @tr("Files"); icon: "folder"; }
                    ShortcutPreview { action: "close-window"; label: @tr("Close window"); icon: "close"; }
                }
                VerticalLayout {
                    spacing: Style.spacing-sm;
                    horizontal-stretch: 1;
                    ShortcutPreview { action: "fullscreen-window"; label: @tr("Fullscreen"); icon: "maximize"; }
                    ShortcutPreview { action: "screenshot"; label: @tr("Screenshot"); icon: "screenshot"; }
                    ShortcutPreview { action: "choose-wallpaper"; label: @tr("Wallpapers"); icon: "image"; }
                    ShortcutPreview { action: "open-control-center"; label: @tr("Control center"); icon: "dashboard"; }
                    ShortcutPreview { action: "open-clipboard"; label: @tr("Clipboard"); icon: "clipboard"; }
                }
            }
        }
        if Compositor.bindings.length == 0: VerticalLayout {
            spacing: Style.spacing-md;
            Tip { icon: "apps"; title: @tr("Launcher"); text: @tr("Click the diamond in the panel or the apps button in the dock."); }
            Tip { icon: "dashboard"; title: @tr("Dashboard"); text: @tr("Click the moon in the panel for quick settings, media, performance and notifications."); }
            Tip { icon: "dock"; title: @tr("Dock"); text: @tr("Right-click applications in the launcher or dock to pin them."); }
            Tip { icon: "settings"; title: @tr("Settings"); text: @tr("Change the theme, wallpaper, language and lock behaviour."); }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: Style.spacing-sm;
            TextButton { text: @tr("Open settings"); clicked => { root.finish(); UI.open-settings("appearance"); } }
            TextButton { text: @tr("Get started"); primary: true; clicked => { root.done(); } }
        }
    }
}
