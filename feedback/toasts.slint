// Notification pop-ups in a drawer tucked into a corner of the screen frame (or dropping out
// of its top edge).

import { PanelWindow, Layer, ExclusiveMode, Notifications } from "@slintlu";
import { Style } from "../style/style.slint";
import { Prefs } from "../state/prefs.slint";
import { UI } from "../state/ui.slint";
import { Icon } from "../components/icon.slint";
import { IconButton, TextButton } from "../components/controls.slint";
import { Drawer, CornerDrawer } from "../components/shape.slint";

export component Toasts inherits PanelWindow {
    namespace: "lunadash-notifications";
    layer: Layer.overlay;
    exclusive-mode: ExclusiveMode.ignore;
    property <bool> centered: Prefs.toast-position == "top-center";
    property <bool> at-bottom: Prefs.toast-position == "bottom-right";
    anchor-top: !root.at-bottom;
    anchor-bottom: root.at-bottom;
    anchor-right: !root.centered;
    margin-top: Style.inner-top;
    margin-bottom: Style.inner-bottom + Style.dock-reserve;
    margin-right: Style.inner-right;
    shown: Prefs.toasts && Notifications.popups.length > 0 && UI.on-active-screen && UI.overlay == "";
    property <length> body-width: 400px;
    property <length> body-height: column.preferred-height;
    preferred-width: root.body-width + (root.centered ? 2 : 1) * Style.frame-radius;
    preferred-height: root.body-height + (root.centered ? 0 : 1) * Style.frame-radius;
    default-font-family: Style.font;

    if root.centered: Drawer {
        edge: "top";
        body-width: root.body-width;
        body-height: root.body-height;
    }
    if !root.centered: CornerDrawer {
        corner: root.at-bottom ? "br" : "tr";
        body-width: root.body-width;
        body-height: root.body-height;
    }

    column := VerticalLayout {
        x: Style.frame-radius;
        y: root.at-bottom ? Style.frame-radius : 0px;
        width: root.body-width;
        height: root.body-height;
        padding: Style.spacing-md;
        spacing: Style.spacing-sm;
        for n in Notifications.popups: Rectangle {
            // A toast joining a visible stack fades in (the first one arrives with the surface).
            property <float> appear: 0;
            opacity: self.appear;
            init => { self.appear = 1; }
            animate appear { duration: Style.motion; easing: ease-out; }
            height: row.preferred-height;
            border-radius: Style.radius-large * 0.6;
            background: n.urgency == "critical" ? Style.danger-container : Style.surface;
            touch := TouchArea {
                clicked => {
                    Notifications.invoke(n.id, "default");
                    Notifications.dismiss(n.id);
                }
            }
            row := HorizontalLayout {
                padding: Style.spacing-md;
                spacing: Style.spacing-md;
                Rectangle {
                    width: 42px;
                    height: 42px;
                    border-radius: 21px;
                    clip: true;
                    background: Style.tonal;
                    Image {
                        width: n.image.width > 0 ? parent.width : 26px;
                        height: n.image.width > 0 ? parent.height : 26px;
                        source: n.image.width > 0 ? n.image : n.icon;
                        image-fit: n.image.width > 0 ? cover : contain;
                    }
                    if n.image.width == 0 && n.icon.width == 0: Icon { name: "bell"; width: 20px; height: 20px; color: Style.accent; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    HorizontalLayout {
                        Text { text: n.app-name; color: Style.accent; font-size: Style.font-small; horizontal-stretch: 1; overflow: elide; }
                        Text { text: n.time; color: Style.muted; font-size: Style.font-small; }
                    }
                    Text { text: n.summary; color: Style.text; font-weight: 600; wrap: word-wrap; }
                    if n.body != "": Text { text: n.body; color: Style.muted; wrap: word-wrap; max-height: 80px; overflow: elide; }
                    if n.actions.length > 0: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        padding-top: 4px;
                        for action in n.actions: TextButton {
                            text: action.label;
                            clicked => {
                                Notifications.invoke(n.id, action.key);
                                Notifications.dismiss(n.id);
                            }
                        }
                    }
                }
                IconButton { icon: "close"; size: 24px; icon-size: 12px; clicked => { Notifications.dismiss(n.id); } }
            }
        }
    }
}
