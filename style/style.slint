// LunaDash design tokens on top of SlintLu's Theme (which follows theme.json and the desktop's
// light / dark preference) and the appearance preferences.
//
// The look follows Material 3 Expressive the way end4's shell does: the bar is a row of floating
// islands, drawers and popouts are floating cards in the same panel colour, flat tonal
// containers sit on them, and shapes are generously rounded. Theme's slots map onto the M3
// roles: background → surface, surface → surface-container, surface-alt →
// surface-container-high, border → outline-variant, accent → primary.

import { Theme, Compositor, Files, Shell } from "@slintlu";
import { Prefs } from "../state/prefs.slint";
import { PanelLayout } from "../state/panel-layout.slint";

export global Style {
    // Accent choices offered in Settings; `accent-hex` is what LunaDash's compositor stores.
    out property <[color]> accents: [#9ccbfb, #c4b5fd, #f5a9c8, #7dcccf, #a6e3a1, #efcd8c, #f4a77c, #e2e5ed];
    out property <[string]> accent-hex: ["#9ccbfb", "#c4b5fd", "#f5a9c8", "#7dcccf", "#a6e3a1", "#efcd8c", "#f4a77c", "#e2e5ed"];

    // Primary and its tonal companions: the accent picked in Settings, else on LunaDash one
    // taken from the wallpaper (Colours from the wallpaper), else the palette's own. SlintLu
    // takes the wallpaper's accent the way Material You does, as soon as the wallpaper
    // changes; until it is known, LunaDash's own stands in.
    property <bool> wallpaper-colours: Compositor.has-commands
        && Compositor.preference-bool("wallpaperColors", true, Compositor.preferences-revision);
    property <color> from-wallpaper: Files.accent(Compositor.wallpaper-poster != "" ? Compositor.wallpaper-poster : Compositor.wallpaper, Files.revision);
    property <color> picked: Prefs.accent >= 0 && Prefs.accent < root.accents.length ? root.accents[Prefs.accent]
        : !root.wallpaper-colours ? Theme.accent
        : root.from-wallpaper != transparent ? root.from-wallpaper
        : Compositor.preference-color("accent", Theme.accent, Compositor.preferences-revision);
    out property <color> accent: Prefs.accent < 0 && !root.wallpaper-colours ? Theme.accent
        : Theme.dark ? root.picked : root.picked.darker(0.45);
    // On top of the primary colour.
    out property <color> accent-ink: Theme.dark ? root.accent.mix(#000000, 0.28) : #ffffff;
    // M3 primary / secondary containers: the accent steeped into the surface.
    out property <color> primary-container: Theme.dark ? root.accent.mix(Theme.background, 0.3) : root.accent.mix(#ffffff, 0.22);
    out property <color> on-primary-container: Theme.dark ? root.accent.mix(#ffffff, 0.35) : root.accent.mix(#000000, 0.45);
    out property <color> tonal: Theme.dark ? root.accent.mix(Theme.surface-alt, 0.16) : root.accent.mix(Theme.surface, 0.14);
    out property <color> on-tonal: Theme.dark ? root.accent.mix(Theme.text, 0.25) : root.accent.mix(#000000, 0.55);
    out property <color> accent-soft: root.accent.with-alpha(0.16);

    // Surfaces
    out property <float> glass-alpha: Prefs.transparency ? clamp(Prefs.glass-opacity, 50, 100) / 100 : 1.0;
    // The colour of the bar's islands, at the bar's opacity (Settings → Panel).
    out property <float> panel-alpha: clamp(Prefs.bar-opacity, 30, 100) / 100;
    out property <color> panel: Theme.background.with-alpha(root.panel-alpha);
    // Drawers and popouts hold more to read: nearly opaque whatever the bar's opacity.
    out property <color> sheet: Theme.background.with-alpha(max(root.panel-alpha, 0.94));
    out property <color> base: Theme.background;
    // Free-floating surfaces (dialogs, notifications) follow the transparency preference.
    out property <color> glass: Theme.background.with-alpha(root.glass-alpha);
    out property <color> glass-strong: Theme.background.with-alpha(min(1.0, root.glass-alpha + 0.08));
    // surface-container and surface-container-high.
    out property <color> surface: Theme.surface;
    out property <color> elevated: Theme.surface-alt;
    // M3 state layers: the content colour at 8 % (hover) and 12 % (pressed).
    out property <color> hover: Theme.surface-alt.mix(Theme.text, 0.9);
    out property <color> pressed: Theme.surface-alt.mix(Theme.text, 0.84);
    out property <color> border: Theme.border;
    out property <color> hairline: Theme.border.with-alpha(0.5);
    out property <color> sheen: transparent;
    out property <color> scrim: #000000.with-alpha(0.32);
    out property <color> shadow: Theme.dark ? #00000066 : #00000026;
    // Content
    out property <color> text: Theme.text;
    out property <color> muted: Theme.text-muted;
    out property <color> danger: Theme.red;
    out property <color> danger-container: Theme.dark ? Theme.red.mix(Theme.background, 0.28) : Theme.red.mix(#ffffff, 0.2);
    out property <color> success: Theme.green;
    out property <color> warning: Theme.yellow;

    // Typography: theme.json's font, else the desktop's interface font (SlintLu reads it from
    // the desktop portal), else the system default. Glyphs the family lacks (Chinese in a
    // Latin interface font) come from the system's fallback fonts.
    out property <float> text-scale: clamp(Prefs.text-scale, 80, 140) / 100;
    out property <string> font: Theme.font-family;
    // Numbers in columns (the task manager): the desktop's monospace family.
    out property <string> font-mono: Theme.monospace-font;
    out property <length> font-size: Theme.font-size * root.text-scale;
    out property <length> font-small: (Theme.font-size - 1.5px) * root.text-scale;
    out property <length> font-title: (Theme.font-size + 5px) * root.text-scale;
    out property <length> font-display: 28px * root.text-scale;

    // Geometry (M3 shape and spacing scales)
    out property <float> corner-scale: Prefs.corners == "compact" ? 0.5 : Prefs.corners == "round" ? 1.3 : 1.0;
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 12px;
    out property <length> spacing-lg: 16px;
    out property <length> spacing-xl: 20px;
    out property <length> spacing-xxl: 28px;
    out property <length> radius-small: 8px * root.corner-scale;
    out property <length> radius-medium: 12px * root.corner-scale;
    out property <length> radius: 25px * root.corner-scale;
    out property <length> radius-large: 28px * root.corner-scale;
    // The rounding of the bar's islands, drawers and popouts, and how far these floating
    // shapes keep from the screen's edges and from each other.
    out property <length> panel-radius: 25px * root.corner-scale;
    out property <length> edge-gap: 8px;
    // The screen edge the bar runs along: "top", "bottom", "left" or "right".
    out property <string> bar-edge: Prefs.bar-position == "bottom" || Prefs.bar-position == "left" || Prefs.bar-position == "right" ? Prefs.bar-position : "top";
    out property <bool> bar-horizontal: root.bar-edge == "top" || root.bar-edge == "bottom";
    out property <length> bar-width: PanelLayout.thickness;
    // Where a bar shorter than its edge starts, from either end of the edge.
    out property <length> bar-offset: (root.bar-horizontal ? Shell.screen.width : Shell.screen.height) * 1px * (1 - PanelLayout.length) / 2;
    // The bar's islands: as thick as the bar less a margin on either side, and the room their
    // rounded ends leave around the first and last item.
    out property <length> island: max(28px, root.bar-width - 12px);
    out property <length> island-end: 6px;
    // How far the desktop area beside the bar lies from each screen edge.
    out property <length> inner-left: root.bar-edge == "left" ? root.bar-width : 0px;
    out property <length> inner-top: root.bar-edge == "top" ? root.bar-width : 0px;
    out property <length> inner-right: root.bar-edge == "right" ? root.bar-width : 0px;
    out property <length> inner-bottom: root.bar-edge == "bottom" ? root.bar-width : 0px;
    // The dock's icons and its full height.
    out property <length> dock-item: Prefs.dock-size == "small" ? 40px : Prefs.dock-size == "large" ? 60px : 50px;
    out property <length> dock-height: root.dock-item + 16px;
    // What the dock keeps clear at the bottom of the desktop.
    out property <length> dock-reserve: Prefs.dock && !Prefs.dock-autohide ? root.dock-height + root.edge-gap : 0px;

    // Motion: M3 durations; the spatial curve overshoots a little, like caelestia's.
    out property <float> motion-scale: Prefs.animation-speed == "fast" ? 0.6 : Prefs.animation-speed == "relaxed" ? 1.6 : 1.0;
    out property <duration> motion: Prefs.animations ? 400ms * root.motion-scale : 0ms;
    out property <duration> motion-fast: Prefs.animations ? 200ms * root.motion-scale : 0ms;
    out property <duration> motion-slow: Prefs.animations ? 500ms * root.motion-scale : 0ms;
    // A wallpaper change, like noctalia's wallpaper transitions.
    out property <duration> wallpaper-transition: Prefs.animations && Prefs.wallpaper-transition != "none" ? 1200ms * root.motion-scale : 0ms;
}
